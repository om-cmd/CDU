@{
    ViewData["Title"] = "Crime Data";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.bootstrap5.min.css" />
    <style>
        .page-header:after, .page-header:before {
            position: relative !important;
        }

        .page-header {
            min-height: 0 !important;
            max-height: none !important;
            display: flex !important;
            height: 100%;
            padding: 0;
            color: unset !important;
            position: relative;
        }

        :root {
            --ink: #1e293b;
            --accent: #c0392b;
            --border: #e2e8f0;
            --row-hover: #f8fafc;
            --muted: #64748b;
        }

        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            padding: 1.5rem 2rem 0.5rem 2rem;
            border-bottom: 1px solid var(--border);
        }

            .page-header h1 {
                font-size: 1.5rem;
                font-weight: 600;
                display: flex;
                align-items: center;
                gap: 0.5rem;
                margin: 0;
            }

            .page-header p {
                margin: 0.25rem 0 0 0;
                font-size: 0.8rem;
                color: var(--muted);
            }

        .page-header-actions {
            display: flex;
            gap: 0.75rem;
        }

        .btn-new-report, .btn-bulk-import {
            border: none;
            padding: 0.45rem 1.1rem;
            font-size: 0.82rem;
            border-radius: 4px;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            transition: background 0.15s;
        }

        .btn-new-report {
            background: #2563eb;
            color: #fff;
        }

            .btn-new-report:hover {
                background: #1d4ed8;
                color: #fff;
            }

        .btn-bulk-import {
            background: #059669;
            color: #fff;
        }

            .btn-bulk-import:hover {
                background: #047857;
            }

        .btn-export {
            background: var(--accent);
            color: black;
            border: none;
            padding: 0.45rem 1.1rem;
            font-size: 0.82rem;
            border-radius: 4px;
            font-weight: 600;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
        }

            .btn-export:hover {
                background: #a93226;
                color: #fff;
            }

        .toolbar {
            background: #fff;
            border-bottom: 1px solid var(--border);
            padding: 0.85rem 2rem;
            display: flex;
            align-items: center;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .stats-bar {
            display: flex;
            gap: 2rem;
            align-items: center;
            margin-left: auto;
            font-size: 0.8rem;
            color: var(--muted);
            font-family: 'Courier New', monospace;
        }

            .stats-bar strong {
                color: var(--ink);
                font-size: 1rem;
            }

        .source-audit {
            background: #fff7ed;
            border: 1px solid #fed7aa;
            border-left: 4px solid #f97316;
            margin: 0 2rem 1rem;
            padding: .75rem 1rem;
            color: #7c2d12;
            font-size: .82rem;
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: .65rem;
        }

            .source-audit strong {
                display: block;
                color: #111827;
                font-size: .9rem;
                word-break: break-word;
            }

        .table-wrap {
            padding: 1.5rem 2rem 3rem;
        }

        table.dataTable thead th {
            background: var(--ink);
            color: #fff;
            font-family: 'Courier New', monospace;
            font-size: 0.75rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            border-bottom: none !important;
            padding: 0.7rem 1rem;
            white-space: nowrap;
        }

        table.dataTable tbody td {
            font-size: 0.82rem;
            padding: 0.6rem 1rem;
            vertical-align: middle;
            color: var(--ink);
        }

        .badge-crime {
            display: inline-block;
            padding: 0.18em 0.6em;
            border-radius: 2px;
            font-size: 0.72rem;
            font-weight: 700;
            text-transform: uppercase;
            background: #e8edf7;
            color: #1a2a4a;
        }

        .tbl-act-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 28px;
            height: 28px;
            border-radius: 4px;
            border: 1px solid #dde3ec;
            background: #fff;
            cursor: pointer;
            color: #5a6a7e;
            text-decoration: none;
            margin: 0 1px;
            transition: all 0.15s;
        }

            .tbl-act-btn:hover.edit-btn {
                background: #eff6ff;
                border-color: #2563eb;
                color: #2563eb;
            }

            .tbl-act-btn:hover.del-btn {
                background: #fff0f0;
                border-color: #dc2626;
                color: #dc2626;
            }

        /* Loading overlay */
        .loading-overlay {
            position: fixed;
            inset: 0;
            background: rgba(255,255,255,0.92);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 9999;
            gap: 1rem;
        }

            .loading-overlay .ld-spinner {
                width: 36px;
                height: 36px;
                border: 3px solid #dde;
                border-top-color: var(--accent);
                border-radius: 50%;
                animation: spin 0.7s linear infinite;
            }

        @@keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        /* ── IMPORT MODAL ── */
        .imp-modal-overlay, .del-modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(11,22,36,0.6);
            z-index: 1050;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.2s, visibility 0.2s;
        }

            .imp-modal-overlay.open, .del-modal-overlay.open {
                opacity: 1;
                visibility: visible;
            }

        .imp-modal, .del-modal {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 24px 64px rgba(0,0,0,0.25);
            width: min(520px, 96%);
            overflow: hidden;
            transform: scale(0.95) translateY(8px);
            transition: transform 0.2s;
        }

        .imp-modal-overlay.open .imp-modal,
        .del-modal-overlay.open .del-modal {
            transform: scale(1) translateY(0);
        }

        .imp-modal-head {
            background: #0f172a;
            border-bottom: 3px solid #059669;
            padding: 1rem 1.3rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .imp-modal-head h3 {
                color: #fff;
                margin: 0;
                font-size: 1rem;
                font-weight: 600;
            }

            .imp-modal-head p {
                color: #94a3b8;
                margin: 3px 0 0;
                font-size: 0.75rem;
            }

        .imp-modal-close {
            background: rgba(255,255,255,0.1);
            border: none;
            border-radius: 6px;
            width: 30px;
            height: 30px;
            cursor: pointer;
            color: #fff;
            font-size: 1rem;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .imp-modal-close:hover {
                background: rgba(255,255,255,0.2);
            }

        .imp-modal-body {
            padding: 1.25rem 1.3rem;
        }

        .drop-zone {
            border: 2px dashed #d1d5db;
            border-radius: 10px;
            padding: 2rem 1rem;
            text-align: center;
            background: #f9fafc;
            position: relative;
            cursor: pointer;
            transition: border-color 0.15s, background 0.15s;
        }

            .drop-zone:hover {
                border-color: #059669;
                background: #f0fdf4;
            }

            .drop-zone input[type="file"] {
                position: absolute;
                inset: 0;
                opacity: 0;
                cursor: pointer;
            }

        .drop-zone-icon {
            font-size: 2rem;
            margin-bottom: 0.5rem;
        }

        .drop-zone-title {
            font-size: 0.9rem;
            font-weight: 600;
            color: #374151;
        }

        .drop-zone-sub {
            font-size: 0.75rem;
            color: #9ca3af;
            margin-top: 4px;
        }

        #dzFileName {
            margin-top: 10px;
            font-size: 0.82rem;
            color: #059669;
            font-weight: 600;
        }

        .import-opts {
            margin-top: 1rem;
            font-size: 0.82rem;
            color: #374151;
        }

            .import-opts label {
                display: flex;
                align-items: center;
                gap: 0.4rem;
                cursor: pointer;
            }

        .api-source-card {
            border: 1px solid #bfdbfe;
            border-radius: 10px;
            padding: 1rem;
            background: #eff6ff;
            color: #1e3a5f;
            font-size: 0.82rem;
            line-height: 1.5;
        }

        .api-source-card strong {
            display: block;
            color: #0f172a;
            margin-bottom: 0.25rem;
        }

        .api-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0.8rem;
            margin-top: 1rem;
        }

        .api-grid label {
            color: #374151;
            font-size: 0.78rem;
            font-weight: 600;
        }

        .api-grid input,
        .api-grid select {
            width: 100%;
            margin-top: 0.3rem;
            padding: 0.48rem 0.6rem;
            border: 1px solid #d1d5db;
            border-radius: 6px;
            background: #fff;
            color: #111827;
        }

        .api-url-field {
            grid-column: 1 / -1;
        }

        .api-help {
            margin: 0.8rem 0 0;
            color: #6b7280;
            font-size: 0.75rem;
        }

        /* Progress */
        .import-progress {
            display: none;
            margin-top: 1rem;
        }

            .import-progress.show {
                display: block;
            }

        .prog-label {
            display: flex;
            justify-content: space-between;
            font-size: 0.75rem;
            color: #6b7280;
            margin-bottom: 5px;
        }

        .prog-bar-wrap {
            background: #e5e7eb;
            border-radius: 20px;
            height: 8px;
            overflow: hidden;
        }

        .prog-bar {
            height: 100%;
            background: #059669;
            border-radius: 20px;
            width: 0%;
            transition: width 0.4s ease;
        }

        /* Result banner */
        .import-result {
            display: none;
            margin-top: 1rem;
            border-radius: 8px;
            overflow: hidden;
        }

            .import-result.show {
                display: block;
            }

        .import-result-inner {
            padding: 0.85rem 1rem;
            font-size: 0.82rem;
            font-weight: 500;
            display: flex;
            align-items: flex-start;
            gap: 0.6rem;
        }

        .import-result.success .import-result-inner {
            background: #ecfdf5;
            color: #065f46;
            border: 1px solid #a7f3d0;
            border-left: 4px solid #059669;
        }

        .import-result.error .import-result-inner {
            background: #fff0f0;
            color: #7b1e18;
            border: 1px solid #fca5a5;
            border-left: 4px solid #dc2626;
        }

        .import-result-icon {
            font-size: 1.1rem;
            flex-shrink: 0;
            margin-top: 1px;
        }

        .import-result-stats {
            display: flex;
            gap: 1.2rem;
            margin-top: 0.45rem;
            flex-wrap: wrap;
        }

        .import-stat {
            background: rgba(0,0,0,0.06);
            border-radius: 4px;
            padding: 0.2rem 0.55rem;
            font-size: 0.73rem;
            font-weight: 600;
        }

        .imp-modal-foot {
            padding: 0.85rem 1.3rem;
            border-top: 1px solid #e5e7eb;
            display: flex;
            gap: 0.5rem;
            justify-content: flex-end;
            background: #f9fafb;
        }

        .btn-cancel-sm {
            background: #fff;
            border: 1px solid #d1d5db;
            border-radius: 6px;
            padding: 0.42rem 0.9rem;
            cursor: pointer;
            font-size: 0.82rem;
            color: #374151;
        }

            .btn-cancel-sm:hover {
                background: #f3f4f6;
            }

        .btn-imp-do {
            background: #059669;
            color: #fff;
            border: none;
            border-radius: 6px;
            padding: 0.42rem 1.1rem;
            font-weight: 700;
            cursor: pointer;
            font-size: 0.82rem;
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
        }

            .btn-imp-do:hover {
                background: #047857;
            }

            .btn-imp-do:disabled {
                opacity: 0.55;
                cursor: not-allowed;
            }

        /* ── DELETE MODAL ── */
        .del-modal-head {
            background: linear-gradient(135deg, #7b1e18, #a93226);
            padding: 0.9rem 1.2rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            color: #fff;
            font-weight: 600;
            font-size: 0.95rem;
        }

        .del-modal-body {
            padding: 1rem 1.2rem;
        }

        .del-modal-warn {
            background: #fff0f0;
            border-left: 4px solid #dc2626;
            padding: 0.6rem 0.75rem;
            margin-bottom: 0.75rem;
            font-size: 0.82rem;
            color: #7b1e18;
            border-radius: 0 5px 5px 0;
        }

        #qDelRecord {
            font-size: 0.82rem;
            background: #f9fafb;
            border: 1px solid #e5e7eb;
            border-radius: 6px;
            overflow: hidden;
        }

            #qDelRecord > div {
                padding: 0.38rem 0.75rem;
                border-bottom: 1px solid #f3f4f6;
            }

                #qDelRecord > div:last-child {
                    border-bottom: none;
                }

            #qDelRecord strong {
                color: #6b7280;
                font-size: 0.68rem;
                text-transform: uppercase;
                letter-spacing: .4px;
                margin-right: 6px;
            }

        .del-modal-foot {
            padding: 0.75rem 1.2rem;
            border-top: 1px solid #eee;
            display: flex;
            gap: 0.5rem;
            justify-content: flex-end;
            background: #f9f9f9;
        }

        .btn-confirm-del {
            background: #dc2626;
            color: #fff;
            border: none;
            border-radius: 6px;
            padding: 0.42rem 1rem;
            font-weight: 700;
            cursor: pointer;
            font-size: 0.82rem;
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
        }

            .btn-confirm-del:hover {
                background: #b91c1c;
            }

            .btn-confirm-del:disabled {
                opacity: 0.55;
                cursor: not-allowed;
            }

        /* Toast */
        .toast-wrap {
            position: fixed;
            bottom: 1.5rem;
            right: 1.5rem;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .toast {
            background: #0f172a;
            color: #fff;
            border-radius: 7px;
            padding: 0.65rem 0.95rem;
            font-size: 0.83rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 0.45rem;
            box-shadow: 0 8px 24px rgba(0,0,0,0.2);
            animation: fadeIn 0.25s, fadeOut 0.3s 2.7s forwards;
            min-width: 220px;
        }

            .toast.success {
                border-left: 4px solid #16a34a;
            }

            .toast.error {
                border-left: 4px solid #dc2626;
            }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes fadeOut {
            to {
                opacity: 0;
                transform: translateY(-6px);
            }
        }

        .sm-spinner {
            display: inline-block;
            width: 12px;
            height: 12px;
            border: 2px solid rgba(255,255,255,0.35);
            border-top-color: #fff;
            border-radius: 50%;
            animation: spin 0.6s linear infinite;
        }
    </style>
}

<!-- LOADING OVERLAY -->
<div id="loadingOverlay" class="loading-overlay">
    <div class="ld-spinner"></div>
    <p style="font-size:0.85rem; color:#64748b; font-weight:600; letter-spacing:.5px;">LOADING CRIME DATA…</p>
</div>

<!-- PAGE HEADER -->
<div class="page-header">
    <div>
        <h1>
            <svg width="26" height="26" fill="currentColor" viewBox="0 0 16 16">
                <path d="M0 1.5A1.5 1.5 0 0 1 1.5 0h13A1.5 1.5 0 0 1 16 1.5v2A1.5 1.5 0 0 1 14.5 5h-13A1.5 1.5 0 0 1 0 3.5v-2z" />
                <path d="M2 2.5a.5.5 0 0 1 .5-.5h3a.5.5 0 0 1 0 1h-3a.5.5 0 0 1-.5-.5zM0 8a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V8z" />
            </svg>
            Crime Data
        </h1>
        <p>Imported crime records · Data source: CrimeReport database table</p>
    </div>
    <div class="page-header-actions">
        <a href="@Url.Action("CrimeReport", "CrimeReport")" class="btn-new-report">
            <svg width="13" height="13" fill="currentColor" viewBox="0 0 16 16"><path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z" /></svg>
            New Report
        </a>
        @if (User.IsInRole("SuperAdmin"))
        {
            <button class="btn-bulk-import" onclick="openImport()">
                <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z" />
                    <path d="M7.646 1.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1-.708.708L8.5 2.707V11.5a.5.5 0 0 1-1 0V2.707L5.354 4.854a.5.5 0 1 1-.708-.708l3-3z" />
                </svg>
                Bulk Import CSV
            </button>
            <button class="btn-bulk-import" onclick="openJsonImport()">
                <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M4.5 1A1.5 1.5 0 0 0 3 2.5v11A1.5 1.5 0 0 0 4.5 15h7a1.5 1.5 0 0 0 1.5-1.5v-11A1.5 1.5 0 0 0 11.5 1h-7zM6 5.5a.5.5 0 0 1-.5.5H5v4h.5a.5.5 0 0 1 0 1H5a1 1 0 0 1-1-1V9.5a1 1 0 0 0-.5-.866A1 1 0 0 1 4 6.5V6a1 1 0 0 1 1-1h.5a.5.5 0 0 1 .5.5zm4 0a.5.5 0 0 1 .5-.5h.5a1 1 0 0 1 1 1v.5a1 1 0 0 1 .5.866 1 1 0 0 0-.5.866V10a1 1 0 0 1-1 1h-.5a.5.5 0 0 1 0-1h.5V6h-.5a.5.5 0 0 1-.5-.5z"/>
                </svg>
                Import from JSON API
            </button>
        }
    </div>
</div>

<!-- TOOLBAR -->
<div class="toolbar">
    <button class="btn-export" id="btnExport">&#8595; Export CSV</button>
    <div class="stats-bar">
        <div>Total records: <strong id="statTotal">—</strong></div>
        <div>Filtered: <strong id="statFiltered">—</strong></div>
    </div>
</div>

@* <div class="source-audit">
    <div>SQL Server<strong id="srcServer">Checking…</strong></div>
    <div>Database<strong id="srcDatabase">Checking…</strong></div>
    <div>Table<strong id="srcTable">CrimeReports</strong></div>
    <div>SQL Row Count<strong id="srcRows">Checking…</strong></div>
</div>
 *@
<!-- DATA TABLE -->
<div class="table-wrap">
    <table id="crimeTable" class="table table-bordered w-100" style="display:none;">
        <thead>
            <tr>
                <th>File #</th>
                <th>Date of Report</th>
                <th>Crime Date/Time</th>
                <th>Crime Type</th>
                <th>Area</th>
                <th>Neighborhood</th>
                <th>Location</th>
                <th>Lat</th>
                <th>Lon</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>

<!-- ── IMPORT MODAL ── -->
<div class="imp-modal-overlay" id="importModal">
    <div class="imp-modal">
        <div class="imp-modal-head">
            <div>
                <h3>📂 Bulk Import CSV</h3>
                <p>Records will be saved directly to the database</p>
            </div>
            <button class="imp-modal-close" onclick="closeImport()">✕</button>
        </div>
        <div class="imp-modal-body">
            <div class="drop-zone" id="dropZone">
                <input type="file" id="csvFile" accept=".csv" onchange="onFileSelected(this)" />
                <div class="drop-zone-icon">📄</div>
                <div class="drop-zone-title">Drop your CSV file here</div>
                <div class="drop-zone-sub">or click to browse — .csv files only, max 50 MB</div>
                <div id="dzFileName"></div>
            </div>
            <div class="import-opts">
                <label>
                    <input type="checkbox" id="optSkipDuplicates" checked />
                    Skip records with duplicate file numbers
                </label>
            </div>
            <div class="api-grid">
                <label>
                    Default jurisdiction
                    <input type="text" id="csvJurisdiction" placeholder="e.g. Cambridge, MA, USA" />
                </label>
                <label>
                    Data source
                    <input type="text" id="csvDataSource" placeholder="e.g. city open-data CSV" />
                </label>
            </div>
            <p class="api-help">CSV columns named “Jurisdiction” and “Data Source” override these defaults per row.</p>
            <div class="import-progress" id="importProgress">
                <div class="prog-label">
                    <span id="progText">Uploading…</span>
                    <span id="progPct">0%</span>
                </div>
                <div class="prog-bar-wrap"><div class="prog-bar" id="progBar"></div></div>
            </div>
            <div class="import-result" id="importResult">
                <div class="import-result-inner">
                    <div class="import-result-icon" id="importResultIcon"></div>
                    <div>
                        <div id="importResultMsg"></div>
                        <div class="import-result-stats" id="importResultStats"></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="imp-modal-foot">
            <button class="btn-cancel-sm" id="btnImportCancel" onclick="closeImport()">Cancel</button>
            <button class="btn-imp-do" id="btnImport" onclick="doImport()" disabled>
                <svg width="13" height="13" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z" />
                    <path d="M7.646 1.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1-.708.708L8.5 2.707V11.5a.5.5 0 0 1-1 0V2.707L5.354 4.854a.5.5 0 1 1-.708-.708l3-3z" />
                </svg>
                Import to Database
            </button>
        </div>
    </div>
</div>

<!-- ── JSON API IMPORT MODAL ── -->
<div class="imp-modal-overlay" id="jsonImportModal">
    <div class="imp-modal">
        <div class="imp-modal-head">
            <div>
                <h3>Import from a JSON API</h3>
                <p>Fetch compatible crime records directly from a public API</p>
            </div>
            <button class="imp-modal-close" onclick="closeJsonImport()">✕</button>
        </div>
        <div class="imp-modal-body">
            <div class="api-source-card">
                <strong>Transactional API import</strong>
                The server validates and fetches JSON in small pages. Nothing is committed unless
                the complete import succeeds; cancelling or any failure rolls everything back.
            </div>
            <div class="api-grid">
                <label class="api-url-field">
                    JSON API URL
                    <input type="url" id="jsonApiUrl"
                           value="https://data.cityofchicago.org/resource/ijzp-q8t2.json"
                           placeholder="https://example.gov/resource/dataset.json" />
                </label>
                <label>
                    From year (optional)
                    <input type="number" id="jsonFromYear" min="2001" max="@DateTime.UtcNow.Year" value="@DateTime.UtcNow.Year" />
                </label>
                <label>
                    Jurisdiction
                    <input type="text" id="jsonJurisdiction" value="Chicago, IL, USA" placeholder="City, region, country" />
                </label>
                <label>
                    Maximum records to check
                    <select id="jsonMaxRecords">
                        <option value="5000">5,000</option>
                        <option value="25000" selected>25,000</option>
                        <option value="50000">50,000</option>
                        <option value="100000">100,000</option>
                    </select>
                </label>
            </div>
            <p class="api-help">
                Supports Socrata-style JSON arrays using fields such as case_number, date,
                primary_type, district, community_area, latitude and longitude.
            </p>
            <div class="import-progress" id="jsonImportProgress">
                <div class="prog-label">
                    <span id="jsonProgText">Connecting…</span>
                    <span id="jsonProgPct">0%</span>
                </div>
                <div class="prog-bar-wrap"><div class="prog-bar" id="jsonProgBar"></div></div>
            </div>
            <div class="import-result" id="jsonImportResult">
                <div class="import-result-inner">
                    <div class="import-result-icon" id="jsonImportResultIcon"></div>
                    <div>
                        <div id="jsonImportResultMsg"></div>
                        <div class="import-result-stats" id="jsonImportResultStats"></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="imp-modal-foot">
            <button class="btn-cancel-sm" id="btnJsonImportCancel" onclick="closeJsonImport()">Cancel</button>
            <button class="btn-imp-do" id="btnJsonImport" onclick="doJsonImport()">
                Import JSON to Database
            </button>
        </div>
    </div>
</div>

<!-- ── DELETE MODAL ── -->
<div class="del-modal-overlay" id="quickDelModal">
    <div class="del-modal">
        <div class="del-modal-head">⚠️ Confirm Deletion</div>
        <div class="del-modal-body">
            <div class="del-modal-warn">⚠ This record will be permanently removed from the database.</div>
            <div id="qDelRecord"></div>
        </div>
        <div class="del-modal-foot">
            <button class="btn-cancel-sm" onclick="closeQuickDel()">Cancel</button>
            <button class="btn-confirm-del" id="btnQDelConfirm" onclick="confirmQuickDel()">
                <svg width="11" height="11" fill="currentColor" viewBox="0 0 16 16"><path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5z" /></svg>
                Delete Record
            </button>
        </div>
    </div>
</div>

<div class="toast-wrap" id="toastWrap"></div>
@Html.AntiForgeryToken()

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script>
        // ── URL constants ──────────────────────────────────────────────────────
        const EDIT_BASE   = '@Url.Action("CrimeReport", "CrimeReport")';
        const DEL_URL     = '@Url.Action("Delete", "CrimeReport")';
        const IMPORT_URL  = '@Url.Action("ImportCsv", "CrimeReport")';
        const JSON_IMPORT_URL = '@Url.Action("ImportJsonApi", "CrimeReport")';
        const EXPORT_URL  = '@Url.Action("ExportCsv", "CrimeData")';
        const LOADDATA_URL= '@Url.Action("LoadData", "CrimeData")';
        const SOURCE_URL  = '@Url.Action("SourceInfo", "CrimeData")';
        const TOKEN       = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

        let quickDelTarget = null;
        let dtTable        = null;
        let csvImportController = null;
        let jsonImportController = null;

        function hideLoadingOverlay() {
        $('#loadingOverlay').fadeOut(300);
        $('#crimeTable').fadeIn(200);
        }

        $(function () {
        dtTable = $('#crimeTable').DataTable({
        processing: true,
        serverSide: true,
        ajax: {
        url: LOADDATA_URL,
        type: 'GET',
        cache: false,
        data: function (d) {
        return {
        draw:        d.draw,
        start:       d.start,
        length:      d.length,
        searchValue: d.search.value,
        sortColumn:  d.columns[d.order[0]?.column]?.data,
        sortDir:     d.order[0]?.dir,
        _:           Date.now()
        };
        },
        dataSrc: function (json) {
        $('#statTotal').text(Number(json.recordsTotal).toLocaleString());
        $('#statFiltered').text(Number(json.recordsFiltered).toLocaleString());
        updateSourceAudit(json.source);
        hideLoadingOverlay();
        return json.data;
        },
        error: function () {
        hideLoadingOverlay();
        showToast('Failed to load data. Please refresh.', 'error');
        }
        },
        columns: [
        { data: 'fileNumber' },
        { data: 'dateOfReport' },
        { data: 'crimeDateTime' },
        { data: 'crimeType', render: d => `<span class="badge-crime">${escapeHtml(d)}</span>` },
        { data: 'reportingArea' },
        { data: 'neighborhood' },
        { data: 'location', render: d => d && d !== '—' ? (d.length > 38 ? d.substr(0, 38) + '…' : d) : '—' },
        { data: 'latitude',  orderable: false },
        { data: 'longitude', orderable: false },
        {
        data: 'crimeReportId',
        orderable: false,
        searchable: false,
        render: function (id, type, row) {
        // All DB records have an id > 0
        const editUrl = `${EDIT_BASE}?id=${id}&mode=edit`;
        const editBtn = `<a href="${editUrl}" class="tbl-act-btn edit-btn" title="Edit record #${id}">✏️</a>`;
        const delBtn  = `<button class="tbl-act-btn del-btn" title="Delete record #${id}"
        onclick="openQuickDel(${id},'${escapeJs(row.fileNumber)}','${escapeJs(row.crimeType)}','${escapeJs(row.neighborhood)}')">🗑️</button>`;
        return `<div style="display:flex;gap:4px;">${editBtn}${delBtn}</div>`;
        }
        }
        ],
        pageLength: 25,
        order: [[1, 'desc']],
        language: { search: '', searchPlaceholder: 'Search…' },
        dom: '<"row"<"col-sm-6"l><"col-sm-6 d-flex justify-content-end"f>>rtip'
        });

        $('#btnExport').on('click', () => {
        window.location.href = `${EXPORT_URL}?searchValue=${encodeURIComponent(dtTable.search())}`;
        });

        // Safety timeout — hide overlay even if request takes long
        setTimeout(hideLoadingOverlay, 8000);
        loadSourceInfo();
        });

        async function loadSourceInfo() {
        try {
        const response = await fetch(`${SOURCE_URL}?_=${Date.now()}`, { cache: 'no-store' });
        if (!response.ok) return;
        updateSourceAudit(await response.json());
        } catch {}
        }

        function updateSourceAudit(source) {
        if (!source) return;
        const srcServer = document.getElementById('srcServer');
        const srcDatabase = document.getElementById('srcDatabase');
        const srcTable = document.getElementById('srcTable');
        const srcRows = document.getElementById('srcRows');
        if (srcServer) srcServer.textContent = source.server || 'Unknown';
        if (srcDatabase) srcDatabase.textContent = source.database || 'Unknown';
        if (srcTable) srcTable.textContent = source.table || 'CrimeReports';
        if (srcRows) srcRows.textContent = `${Number(source.rowCount || 0).toLocaleString()} rows @@ ${source.countedAt || source.checkedAt || ''}`;
        }

        // ── Delete ───────────────────────────────────────────────────────────
        function openQuickDel(id, fileNum, crimeType, nbr) {
        quickDelTarget = id;
        document.getElementById('qDelRecord').innerHTML = `
        <div><strong>File #</strong> ${escapeHtml(fileNum)}</div>
        <div><strong>Crime Type</strong> ${escapeHtml(crimeType)}</div>
        <div><strong>Neighborhood</strong> ${escapeHtml(nbr || '—')}</div>`;
        document.getElementById('quickDelModal').classList.add('open');
        }

        function closeQuickDel() {
        document.getElementById('quickDelModal').classList.remove('open');
        quickDelTarget = null;
        }

        async function confirmQuickDel() {
        if (!quickDelTarget) return;
        const btn = document.getElementById('btnQDelConfirm');
        btn.disabled = true;
        btn.innerHTML = '<span class="sm-spinner"></span> Deleting…';
        try {
        const res = await fetch(`${DEL_URL}/${quickDelTarget}`, {
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': TOKEN }
        });
        if (res.ok) {
        showToast('Report deleted successfully.', 'success');
        closeQuickDel();
        dtTable.ajax.reload(null, false);
        } else {
        showToast('Failed to delete. Please try again.', 'error');
        }
        } catch {
        showToast('Network error. Please try again.', 'error');
        } finally {
        btn.disabled = false;
        btn.innerHTML = '<svg width="11" height="11" fill="currentColor" viewBox="0 0 16 16"><path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5z"/></svg> Delete Record';
        }
        }

        // ── Import ───────────────────────────────────────────────────────────
        function openImport() {
        document.getElementById('importModal').classList.add('open');
        resetImportUI();
        }

        function closeImport() {
        if (csvImportController) csvImportController.abort();
        document.getElementById('importModal').classList.remove('open');
        resetImportUI();
        }

        function resetImportUI() {
        document.getElementById('csvFile').value = '';
        document.getElementById('dzFileName').innerHTML = '';
        document.getElementById('importProgress').classList.remove('show');
        setProgress(0, '');
        const res = document.getElementById('importResult');
        res.className = 'import-result';
        document.getElementById('btnImport').disabled = true;
        document.getElementById('btnImport').innerHTML = `
        <svg width="13" height="13" fill="currentColor" viewBox="0 0 16 16">
        <path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z"/>
        <path d="M7.646 1.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1-.708.708L8.5 2.707V11.5a.5.5 0 0 1-1 0V2.707L5.354 4.854a.5.5 0 1 1-.708-.708l3-3z"/>
        </svg>
        Import to Database`;
        document.getElementById('btnImportCancel').textContent = 'Cancel';
        }

        function openJsonImport() {
        document.getElementById('jsonImportModal').classList.add('open');
        resetJsonImportUI();
        }

        function closeJsonImport() {
        if (jsonImportController) jsonImportController.abort();
        document.getElementById('jsonImportModal').classList.remove('open');
        resetJsonImportUI();
        }

        function setJsonProgress(pct, label) {
        document.getElementById('jsonProgBar').style.width = pct + '%';
        document.getElementById('jsonProgText').textContent = label;
        document.getElementById('jsonProgPct').textContent = pct + '%';
        }

        function resetJsonImportUI() {
        document.getElementById('jsonImportProgress').classList.remove('show');
        document.getElementById('jsonImportResult').className = 'import-result';
        document.getElementById('btnJsonImport').disabled = false;
        document.getElementById('btnJsonImport').textContent = 'Import JSON to Database';
        document.getElementById('btnJsonImportCancel').textContent = 'Cancel';
        setJsonProgress(0, '');
        }

        async function doJsonImport() {
        const apiUrl = document.getElementById('jsonApiUrl').value.trim();
        const fromYear = document.getElementById('jsonFromYear').value;
        const jurisdiction = document.getElementById('jsonJurisdiction').value.trim();
        const maxRecords = document.getElementById('jsonMaxRecords').value;
        const btn = document.getElementById('btnJsonImport');
        const resultEl = document.getElementById('jsonImportResult');

        if (!apiUrl) {
        showToast('Enter a JSON API URL.', 'error');
        return;
        }

        jsonImportController = new AbortController();
        btn.disabled = true;
        btn.innerHTML = '<span class="sm-spinner"></span> Importing…';
        document.getElementById('btnJsonImportCancel').textContent = 'Cancel Import';
        document.getElementById('jsonImportProgress').classList.add('show');
        resultEl.className = 'import-result';
        setJsonProgress(15, 'Connecting to JSON API…');

        const body = new URLSearchParams({ apiUrl, maxRecords });
        if (fromYear) body.append('fromYear', fromYear);
        if (jurisdiction) body.append('jurisdiction', jurisdiction);
        try {
        setJsonProgress(60, 'Fetching and validating JSON pages…');
        const res = await fetch(JSON_IMPORT_URL, {
        method: 'POST',
        headers: {
        'Content-Type': 'application/x-www-form-urlencoded',
        'X-Requested-With': 'XMLHttpRequest',
        'RequestVerificationToken': TOKEN
        },
        body,
        signal: jsonImportController.signal
        });
        const data = await res.json();
        setJsonProgress(100, res.ok ? 'Done' : 'Stopped');

        if (res.ok) {
        resultEl.className = 'import-result show success';
        document.getElementById('jsonImportResultIcon').textContent = '✅';
        document.getElementById('jsonImportResultMsg').textContent =
        `Import complete — ${data.inserted.toLocaleString()} new records saved.`;
        document.getElementById('jsonImportResultStats').innerHTML = `
        <span class="import-stat">Fetched: ${data.fetched.toLocaleString()}</span>
        <span class="import-stat">Inserted: ${data.inserted.toLocaleString()}</span>
        <span class="import-stat">Skipped: ${data.skipped.toLocaleString()}</span>
        ${data.errors > 0 ? `<span class="import-stat">Errors: ${data.errors.toLocaleString()}</span>` : ''}`;
        showToast(`Imported ${data.inserted.toLocaleString()} API records.`, 'success');
        dtTable.ajax.reload(null, false);
        } else {
        resultEl.className = 'import-result show error';
        document.getElementById('jsonImportResultIcon').textContent = '❌';
        document.getElementById('jsonImportResultMsg').textContent =
        data.message || 'The JSON import could not be completed.';
        document.getElementById('jsonImportResultStats').textContent =
        data.rolledBack ? 'No records were saved.' : '';
        showToast('JSON API import failed.', 'error');
        }
        } catch (error) {
        setJsonProgress(100, 'Stopped');
        resultEl.className = 'import-result show error';
        document.getElementById('jsonImportResultIcon').textContent = '❌';
        document.getElementById('jsonImportResultMsg').textContent =
        error.name === 'AbortError'
        ? 'Import cancelled. The server will roll back all database changes.'
        : 'The request was interrupted. No partial import will be kept.';
        document.getElementById('jsonImportResultStats').textContent = 'No records were saved.';
        showToast(error.name === 'AbortError' ? 'Import cancelled.' : 'JSON API import failed.', 'error');
        } finally {
        jsonImportController = null;
        btn.disabled = false;
        btn.textContent = 'Import Again';
        document.getElementById('btnJsonImportCancel').textContent = 'Close';
        }
        }

        function setProgress(pct, label) {
        document.getElementById('progBar').style.width = pct + '%';
        document.getElementById('progText').textContent = label;
        document.getElementById('progPct').textContent  = pct + '%';
        }

        function onFileSelected(input) { if (input.files[0]) setFile(input.files[0]); }

        function setFile(file) {
        if (!file.name.toLowerCase().endsWith('.csv')) {
        showToast('Only .csv files are allowed.', 'error');
        return;
        }
        const sizeKb = (file.size / 1024).toFixed(1);
        document.getElementById('dzFileName').innerHTML =
        `✅ <strong>${escapeHtml(file.name)}</strong> <span style="color:#6b7280;">(${sizeKb} KB)</span>`;
        document.getElementById('btnImport').disabled = false;
        document.getElementById('importResult').className = 'import-result';
        }

        async function doImport() {
        const file = document.getElementById('csvFile').files[0];
        if (!file) return;

        const skipDupes = document.getElementById('optSkipDuplicates').checked;
        const btn = document.getElementById('btnImport');
        csvImportController = new AbortController();
        btn.disabled = true;
        btn.innerHTML = '<span class="sm-spinner"></span> Importing…';
        document.getElementById('btnImportCancel').textContent = 'Cancel Import';

        const prog = document.getElementById('importProgress');
        prog.classList.add('show');
        document.getElementById('importResult').className = 'import-result';

        setProgress(20, 'Uploading file…');

        const fd = new FormData();
        fd.append('file', file);
        fd.append('skipDuplicates', skipDupes);
        fd.append('defaultJurisdiction', document.getElementById('csvJurisdiction').value.trim());
        fd.append('defaultDataSource', document.getElementById('csvDataSource').value.trim());

        try {
        setProgress(55, 'Processing rows…');
        const res  = await fetch(IMPORT_URL, {
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': TOKEN },
        body: fd,
        signal: csvImportController.signal
        });

        setProgress(90, 'Saving to database…');
        const data = await res.json();
        setProgress(100, 'Done');

        const resultEl   = document.getElementById('importResult');
        const iconEl     = document.getElementById('importResultIcon');
        const msgEl      = document.getElementById('importResultMsg');
        const statsEl    = document.getElementById('importResultStats');

        if (res.ok) {
        resultEl.className = 'import-result show success';
        iconEl.textContent = '✅';
        msgEl.textContent  = `Import complete — ${data.inserted} record${data.inserted !== 1 ? 's' : ''} saved to database.`;
        statsEl.innerHTML  = `
        <span class="import-stat">✅ Inserted: ${data.inserted}</span>
        <span class="import-stat">⏭ Skipped: ${data.skipped}</span>
        ${data.errors > 0 ? `<span class="import-stat">⚠ Errors: ${data.errors}</span>` : ''}
        <span class="import-stat">📄 Total rows: ${data.total}</span>`;
        showToast(`Imported ${data.inserted} records successfully.`, 'success');
        dtTable.ajax.reload(null, false);
        } else {
        resultEl.className = 'import-result show error';
        iconEl.textContent = '❌';
        msgEl.textContent  = `Import failed: ${data.message || 'Unknown error.'}`;
        statsEl.innerHTML  = '';
        showToast('Import failed. See details above.', 'error');
        }
        } catch (e) {
        const resultEl = document.getElementById('importResult');
        resultEl.className = 'import-result show error';
        document.getElementById('importResultIcon').textContent = '❌';
        document.getElementById('importResultMsg').textContent =
        e.name === 'AbortError'
        ? 'Import cancelled. All database changes will be rolled back.'
        : 'Import interrupted. No partial import will be kept.';
        document.getElementById('importResultStats').textContent = 'No records were saved.';
        showToast(e.name === 'AbortError' ? 'Import cancelled.' : 'Import failed.', 'error');
        } finally {
        csvImportController = null;
        btn.disabled = false;
        btn.innerHTML = `
        <svg width="13" height="13" fill="currentColor" viewBox="0 0 16 16">
        <path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z"/>
        <path d="M7.646 1.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1-.708.708L8.5 2.707V11.5a.5.5 0 0 1-1 0V2.707L5.354 4.854a.5.5 0 1 1-.708-.708l3-3z"/>
        </svg>
        Import Again`;
        document.getElementById('btnImportCancel').textContent = 'Close';
        }
        }

        // ── Drag & drop ───────────────────────────────────────────────────────
        document.addEventListener('DOMContentLoaded', () => {
        const dz = document.getElementById('dropZone');
        dz.addEventListener('dragover',  e => { e.preventDefault(); dz.style.borderColor = '#059669'; dz.style.background = '#f0fdf4'; });
        dz.addEventListener('dragleave', ()  => { dz.style.borderColor = '#d1d5db'; dz.style.background = '#f9fafc'; });
        dz.addEventListener('drop', e => {
        e.preventDefault();
        dz.style.borderColor = '#d1d5db';
        dz.style.background  = '#f9fafc';
        const file = e.dataTransfer.files[0];
        if (file) {
        const dt = new DataTransfer();
        dt.items.add(file);
        document.getElementById('csvFile').files = dt.files;
        setFile(file);
        }
        });
        document.addEventListener('keydown', e => {
        if (e.key === 'Escape') { closeImport(); closeJsonImport(); closeQuickDel(); }
        });
        });

        // ── Helpers ───────────────────────────────────────────────────────────
        function showToast(msg, type) {
        const wrap = document.getElementById('toastWrap');
        const t = document.createElement('div');
        t.className = `toast ${type}`;
        t.innerHTML = `<span>${type === 'success' ? '✓' : '✕'}</span> ${escapeHtml(msg)}`;
        wrap.appendChild(t);
        setTimeout(() => t.remove(), 3200);
        }

        function escapeHtml(s) {
        if (!s || s === '—') return s || '';
        return String(s).replace(/[&<>"]/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[m]));
        }

        function escapeJs(s) {
        return s ? String(s).replace(/\\/g,'\\\\').replace(/'/g,"\\'") : '';
        }
    </script>
}
