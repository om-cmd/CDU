<div class="toast-wrap" id="toastWrap"></div>
@Html.AntiForgeryToken()

@section Scripts {
    <script>
        const BASE = '@Url.Action("CrimeReport", "CrimeReport")'.replace('/CrimeReport','');
        const URLS = {
            get:    (id) => `${BASE}/CrimeReport/Details/${id}`,
            create: '@Url.Action("Create", "CrimeReport")',
            edit:   (id) => `${BASE}/CrimeReport/Edit/${id}`,
            del:    (id) => `${BASE}/CrimeReport/Delete/${id}`,
            import: '@Url.Action("ImportCsv", "CrimeReport")',
        };

        let isEditMode = false;
        let currentId  = 0;

        document.addEventListener('DOMContentLoaded', () => {
            const params = new URLSearchParams(location.search);
            const id     = parseInt(params.get('id')) || 0;
            const mode   = params.get('mode');
            if (id > 0 && mode === 'edit') loadForEdit(id);

            // Drag & drop
            const dz = document.getElementById('dropZone');
            dz.addEventListener('dragover',  e => { e.preventDefault(); dz.classList.add('drag-over'); });
            dz.addEventListener('dragleave', ()  => dz.classList.remove('drag-over'));
            dz.addEventListener('drop', e => {
                e.preventDefault();
                dz.classList.remove('drag-over');
                const file = e.dataTransfer.files[0];
                if (file) {
                    const dt = new DataTransfer();
                    dt.items.add(file);
                    document.getElementById('csvFile').files = dt.files;
                    setFile(file);
                }
            });

            document.addEventListener('keydown', e => {
                if (e.key === 'Escape') { closeImport(); closeDeleteModal(); }
            });
        });

        // ── Mode switching ────────────────────────────────────────────────────
        function setMode(mode, id = 0, fileNumber = '') {
            isEditMode = mode === 'edit';
            currentId  = id;

            const badge     = document.getElementById('modeBadge');
            const btnSave   = document.getElementById('btnSave');
            const btnText   = document.getElementById('btnSaveText');
            const btnReset  = document.getElementById('btnReset');
            const btnDel    = document.getElementById('btnDelete');
            const editInfo  = document.getElementById('editInfo');
            const cardTitle = document.getElementById('formCardTitle');
            const pageTitle = document.getElementById('pageTitle');
            const modeLabel = document.getElementById('modeLabel');
            const editIdDsp = document.getElementById('editIdDisplay');

            if (isEditMode) {
                badge.className     = 'mode-badge edit';
                badge.textContent   = 'Editing';
                btnSave.className   = 'btn-save edit-mode';
                btnText.textContent = 'Update Report';
                cardTitle.textContent = 'Edit Crime Report';
                pageTitle.textContent = fileNumber ? `Editing: ${fileNumber}` : 'Edit Crime Report';
                modeLabel.textContent = 'Edit Mode';
                btnReset.style.display = '';
                btnDel.style.display   = '';
                editInfo.style.display = '';
                editIdDsp.textContent  = `#${id}`;
                document.getElementById('frmId').value = id;
            } else {
                badge.className     = 'mode-badge create';
                badge.textContent   = 'New';
                btnSave.className   = 'btn-save';
                btnText.textContent = 'Create Report';
                cardTitle.textContent = 'Create Crime Report';
                pageTitle.textContent = 'New Crime Report';
                modeLabel.textContent = 'Create Mode';
                btnReset.style.display = 'none';
                btnDel.style.display   = 'none';
                editInfo.style.display = 'none';
                document.getElementById('frmId').value = 0;
            }
        }

        function resetToCreate() {
            setMode('create');
            clearForm();
            clearErrors();
            history.replaceState({}, '', location.pathname);
        }

        // ── Load for edit ─────────────────────────────────────────────────────
        async function loadForEdit(id) {
            try {
                const res = await fetch(URLS.get(id), { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                if (!res.ok) throw new Error();
                const r = await res.json();
                setMode('edit', r.crimeReportId, r.fileNumber);
                populateForm(r);
            } catch {
                showToast('Failed to load record for editing.', 'error');
            }
        }

        function populateForm(r) {
            document.getElementById('frmFileNumber').value       = r.fileNumber       || '';
            document.getElementById('frmCrimeType').value        = r.crimeType        || '';
            document.getElementById('frmDateOfReport').value     = r.dateOfReport     ? r.dateOfReport.substring(0,10)  : '';
            document.getElementById('frmCrimeDateTime').value    = r.crimeDateTime    ? r.crimeDateTime.substring(0,16) : '';
            document.getElementById('frmCrimeDateTimeRaw').value = r.crimeDateTimeRaw || '';
            document.getElementById('frmLocation').value         = r.location         || '';
            document.getElementById('frmNeighborhood').value     = r.neighborhood     || '';
            document.getElementById('frmReportingArea').value    = r.reportingArea    || '';
            document.getElementById('frmLatitude').value         = r.latitude  != null ? r.latitude  : '';
            document.getElementById('frmLongitude').value        = r.longitude != null ? r.longitude : '';
        }

        function clearForm() {
            ['frmFileNumber','frmCrimeType','frmDateOfReport','frmCrimeDateTime',
             'frmCrimeDateTimeRaw','frmLocation','frmNeighborhood','frmReportingArea',
             'frmLatitude','frmLongitude'].forEach(id => {
                const el = document.getElementById(id);
                if (el) el.value = '';
            });
        }

        // ── Save (create / update) ────────────────────────────────────────────
        async function saveReport() {
            clearErrors();
            const id = parseInt(document.getElementById('frmId').value) || 0;

            const payload = {
                crimeReportId:    id,
                fileNumber:       document.getElementById('frmFileNumber').value.trim(),
                crimeType:        document.getElementById('frmCrimeType').value,
                dateOfReport:     document.getElementById('frmDateOfReport').value     || null,
                crimeDateTime:    document.getElementById('frmCrimeDateTime').value    || null,
                crimeDateTimeRaw: document.getElementById('frmCrimeDateTimeRaw').value.trim() || null,
                location:         document.getElementById('frmLocation').value.trim()         || null,
                neighborhood:     document.getElementById('frmNeighborhood').value.trim()     || null,
                reportingArea:    document.getElementById('frmReportingArea').value.trim()    || null,
                latitude:  document.getElementById('frmLatitude').value  !== '' ? parseFloat(document.getElementById('frmLatitude').value)  : null,
                longitude: document.getElementById('frmLongitude').value !== '' ? parseFloat(document.getElementById('frmLongitude').value) : null,
            };

            let valid = true;
            if (!payload.fileNumber) { showErr('errFileNumber','File number is required.'); valid = false; }
            if (!payload.crimeType)  { showErr('errCrimeType', 'Crime type is required.');  valid = false; }
            if (payload.latitude  != null && (payload.latitude  < -90  || payload.latitude  > 90))  { showToast('Latitude must be −90 to 90.',   'error'); valid = false; }
            if (payload.longitude != null && (payload.longitude < -180 || payload.longitude > 180)) { showToast('Longitude must be −180 to 180.', 'error'); valid = false; }
            if (!valid) return;

            const btn = document.getElementById('btnSave');
            btn.disabled = true;
            const origHTML = btn.innerHTML;
            btn.innerHTML = `<span class="spinner"></span> ${isEditMode ? 'Updating…' : 'Creating…'}`;

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const url   = isEditMode ? URLS.edit(id) : URLS.create;

            try {
                const res = await fetch(url, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();

                if (!res.ok) {
                    if (data.errors) {
                        Object.entries(data.errors).forEach(([k,v]) => {
                            showErr('err' + k.charAt(0).toUpperCase() + k.slice(1), Array.isArray(v) ? v[0] : v);
                        });
                    } else {
                        showToast(data.message || 'Save failed.', 'error');
                    }
                } else {
                    showToast(
                        isEditMode
                            ? `Report ${data.fileNumber} updated successfully.`
                            : `Report ${data.fileNumber} created. You can now edit or create another.`,
                        'success'
                    );
                    setMode('edit', data.crimeReportId, data.fileNumber);
                    populateForm(data);
                }
            } catch {
                showToast('Network error. Please try again.', 'error');
            } finally {
                btn.disabled  = false;
                btn.innerHTML = origHTML;
            }
        }

        // ── Delete ────────────────────────────────────────────────────────────
        function openDeleteModal() {
            const id      = parseInt(document.getElementById('frmId').value) || 0;
            const fileNum = document.getElementById('frmFileNumber').value || '—';
            const crime   = document.getElementById('frmCrimeType').value  || '—';
            const nbr     = document.getElementById('frmNeighborhood').value || '—';
            if (!id) return;

            document.getElementById('delSubtitle').textContent = `File No. ${fileNum} · Record #${id}`;
            document.getElementById('delRecord').innerHTML = `
                <div class="mr-row"><span class="mr-key">File Number</span><span class="mr-val mono">${esc(fileNum)}</span></div>
                <div class="mr-row"><span class="mr-key">Crime Type</span><span class="mr-val">${esc(crime)}</span></div>
                <div class="mr-row"><span class="mr-key">Neighbourhood</span><span class="mr-val">${esc(nbr)}</span></div>`;
            document.getElementById('delModal').classList.add('open');
        }

        async function confirmDelete() {
            const id  = parseInt(document.getElementById('frmId').value) || 0;
            if (!id) return;
            const btn = document.getElementById('btnConfirmDel');
            btn.disabled = true;
            btn.innerHTML = `<span class="spinner"></span> Deleting…`;
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

            try {
                const res = await fetch(URLS.del(id), {
                    method: 'POST',
                    headers: { 'X-Requested-With':'XMLHttpRequest', 'RequestVerificationToken': token },
                });
                if (res.ok) {
                    showToast('Crime report deleted successfully.', 'success');
                    closeDeleteModal();
                    resetToCreate();
                } else {
                    showToast('Failed to delete report.', 'error');
                }
            } catch {
                showToast('Network error.', 'error');
            } finally {
                btn.disabled  = false;
                btn.innerHTML = `<svg width="13" height="13" fill="currentColor" viewBox="0 0 16 16"><path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5z"/></svg> Delete Report`;
            }
        }

        function closeDeleteModal() { document.getElementById('delModal').classList.remove('open'); }

        // ── Import ────────────────────────────────────────────────────────────
        // function openImport() {
        //     document.getElementById('importModal').classList.add('open');
        //     resetImportUI();
        // }

        // function closeImport() {
        //     document.getElementById('importModal').classList.remove('open');
        //     resetImportUI();
        // }

        function resetImportUI() {
            document.getElementById('csvFile').value             = '';
            document.getElementById('dzFileName').style.display  = 'none';
            document.getElementById('importProgress').classList.remove('show');
            document.getElementById('importResult').classList.remove('show');
            document.getElementById('btnImport').disabled        = true;
            document.getElementById('progBar').style.width       = '0%';
            document.getElementById('progText').textContent      = 'Uploading…';
        }

        function onFileSelected(input) { if (input.files[0]) setFile(input.files[0]); }

        function setFile(file) {
            if (!file.name.toLowerCase().endsWith('.csv')) { showToast('Please select a .csv file.', 'error'); return; }
            document.getElementById('dzFileNameText').textContent = file.name;
            document.getElementById('dzFileName').style.display   = 'inline-flex';
            document.getElementById('btnImport').disabled         = false;
            document.getElementById('importResult').classList.remove('show');
        }

        async function doImport() {
            const fileInput = document.getElementById('csvFile');
            const file      = fileInput.files[0];
            if (!file) { showToast('No file selected.', 'error'); return; }

            const skipDupes = document.getElementById('optSkipDuplicates').checked;
            const btn = document.getElementById('btnImport');
            btn.disabled  = true;
            btn.innerHTML = `<span class="spinner"></span> Importing…`;

            const prog = document.getElementById('importProgress');
            prog.classList.add('show');
            document.getElementById('progBar').style.width  = '30%';
            document.getElementById('progText').textContent = 'Uploading file…';

            const fd = new FormData();
            fd.append('file', file);
            fd.append('skipDuplicates', skipDupes);
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

            try {
                document.getElementById('progBar').style.width  = '60%';
                document.getElementById('progText').textContent = 'Processing records…';

                const res = await fetch(URLS.import, {
                    method: 'POST',
                    headers: { 'X-Requested-With':'XMLHttpRequest', 'RequestVerificationToken': token },
                    body: fd
                });

                document.getElementById('progBar').style.width  = '100%';
                document.getElementById('progText').textContent = 'Done.';

                const data = await res.json();
                const el   = document.getElementById('importResult');
                el.classList.add('show');

                if (res.ok) {
                    el.className = 'import-result show success';
                    el.innerHTML = `✓ Imported <strong>${data.inserted}</strong> records. Skipped <strong>${data.skipped}</strong> duplicates.${data.errors > 0 ? ` <br>⚠ ${data.errors} rows had errors.` : ''}`;
                    showToast(`CSV import complete: ${data.inserted} records added.`, 'success');
                } else {
                    el.className = 'import-result show error';
                    el.textContent = `✕ Import failed: ${data.message || 'Unknown error'}`;
                    showToast('Import failed.', 'error');
                }
            } catch {
                showToast('Network error during import.', 'error');
                document.getElementById('progText').textContent = 'Failed.';
            } finally {
                btn.disabled  = false;
                btn.innerHTML = `<svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z"/>
                    <path d="M7.646 1.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1-.708.708L8.5 2.707V11.5a.5.5 0 0 1-1 0V2.707L5.354 4.854a.5.5 0 1 1-.708-.708l3-3z"/>
                    </svg> Import Records`;
            }
        }

        // ── Helpers ───────────────────────────────────────────────────────────
        function showErr(id, msg) {
            const el = document.getElementById(id);
            if (!el) return;
            el.textContent = msg;
            el.classList.add('show');
            el.previousElementSibling?.classList.add('err');
        }

        function clearErrors() {
            document.querySelectorAll('.field-err').forEach(el => {
                el.classList.remove('show');
                el.previousElementSibling?.classList.remove('err');
            });
        }

        function showToast(msg, type = 'success') {
            const wrap = document.getElementById('toastWrap');
            const t = document.createElement('div');
            t.className = `toast ${type}`;
            t.innerHTML = `<span>${type === 'success' ? '✓' : type === 'warn' ? '⚠' : '✕'}</span> ${esc(msg)}`;
            wrap.appendChild(t);
            setTimeout(() => t.remove(), 3100);
        }

        function esc(s) {
            if (s == null) return '';
            return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
        }
    </script>
}
