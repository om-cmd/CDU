@using Domain_Layer.DbModels.Enum
@{
    ViewData["Title"] = "Crime Reports";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Syne:wght@600;700;800&family=Lato:wght@400;500;600;700&display=swap" rel="stylesheet" />

<style>
    /* ── PAGE HEADER ── */
    .pg-head {
        background: var(--ink);
        border-bottom: 3px solid var(--gold);
        padding: 1.25rem 2rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 1.5rem;
        border-radius: var(--r-lg);
    }

    .pg-head-left {
        display: flex;
        align-items: center;
        gap: .9rem;
    }

    /* Crime Report icon badge — pencil on clipboard, distinct from CrimeData's database icon */
    .pg-icon-badge {
        width: 44px;
        height: 44px;
        background: var(--gold);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--ink);
        flex-shrink: 0;
    }

    .pg-head h1 {
        font-family: 'Syne', sans-serif;
        font-weight: 800;
        font-size: 1.3rem;
        color: #fff;
        letter-spacing: .2px;
        line-height: 1.1;
    }

    .pg-head .sub {
        font-size: .73rem;
        color: #8fa3bb;
        font-weight: 500;
        letter-spacing: .5px;
        text-transform: uppercase;
        margin-top: .15rem;
    }

    .head-actions {
        display: flex;
        gap: .5rem;
        flex-wrap: wrap;
    }

    /* ── BUTTONS ── */
    .btn-primary {
        background: var(--gold);
        color: var(--ink);
        border: none;
        border-radius: var(--r);
        padding: .55rem 1.2rem;
        font-family: 'Syne', sans-serif;
        font-size: .85rem;
        font-weight: 700;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        transition: background var(--transit), transform var(--transit);
        text-decoration: none;
    }

        .btn-primary:hover {
            background: #b8952e;
            transform: translateY(-1px);
            color: var(--ink);
        }

    .btn-import {
        background: rgba(255,255,255,.12);
        color: #fff;
        border: 1px solid rgba(255,255,255,.25);
        border-radius: var(--r);
        padding: .53rem 1.1rem;
        font-family: 'Lato', sans-serif;
        font-size: .84rem;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        transition: background var(--transit);
    }

        .btn-import:hover {
            background: rgba(255,255,255,.22);
        }

    .btn-back {
        background: rgba(255,255,255,.08);
        color: #cdd8e8;
        border: 1px solid rgba(255,255,255,.15);
        border-radius: var(--r);
        padding: .48rem .95rem;
        font-family: 'Lato', sans-serif;
        font-size: .83rem;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        text-decoration: none;
        transition: background var(--transit);
    }

        .btn-back:hover {
            background: rgba(255,255,255,.16);
            color: #fff;
        }

    /* ── FORM CARD ── */
    .form-card {
        background: var(--white);
        border: 1px solid var(--line);
        border-radius: var(--r-lg);
        box-shadow: var(--sh);
        overflow: hidden;
        margin-bottom: 1.25rem;
    }

    .form-card-head {
        background: #f9fafc;
        border-bottom: 1px solid var(--line);
        padding: .85rem 1.4rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: .5rem;
    }

    .form-card-head-title {
        font-family: 'Syne', sans-serif;
        font-size: .95rem;
        font-weight: 800;
        color: var(--ink);
        display: flex;
        align-items: center;
        gap: .5rem;
    }

    .mode-badge {
        font-size: .66rem;
        font-weight: 700;
        letter-spacing: .5px;
        text-transform: uppercase;
        padding: .2rem .5rem;
        border-radius: 20px;
        font-family: 'Lato', sans-serif;
    }

        .mode-badge.create {
            background: var(--green-lt);
            color: var(--green);
        }

        .mode-badge.edit {
            background: var(--amber-lt);
            color: var(--amber);
        }

    .form-card-body {
        padding: 1.4rem;
    }

    .form-card-foot {
        border-top: 1px solid var(--line);
        padding: .85rem 1.4rem;
        background: #f9fafc;
        display: flex;
        gap: .5rem;
        flex-wrap: wrap;
    }

    /* ── FORM GRID ── */
    .drw-section {
        margin-bottom: 1.25rem;
    }

    .drw-section-title {
        font-size: .67rem;
        font-weight: 700;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: .8px;
        border-bottom: 1px solid var(--line);
        padding-bottom: .4rem;
        margin-bottom: .9rem;
        display: flex;
        align-items: center;
        gap: .35rem;
    }

    .drw-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: .8rem 1rem;
    }

        .drw-grid .full {
            grid-column: 1 / -1;
        }

    .fg-drw {
        display: flex;
        flex-direction: column;
        gap: .25rem;
    }

        .fg-drw label {
            font-size: .69rem;
            font-weight: 700;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: .5px;
        }

            .fg-drw label .req {
                color: var(--red);
            }

        .fg-drw input, .fg-drw select, .fg-drw textarea {
            border: 1.5px solid var(--line);
            border-radius: var(--r);
            padding: .46rem .75rem;
            font-size: .875rem;
            color: var(--ink);
            background: var(--white);
            font-family: 'Lato', sans-serif;
            transition: border-color var(--transit), box-shadow var(--transit);
            width: 100%;
        }

            .fg-drw input:focus, .fg-drw select:focus, .fg-drw textarea:focus {
                outline: none;
                border-color: var(--blue);
                box-shadow: 0 0 0 3px rgba(18,70,160,.1);
            }

            .fg-drw input.err, .fg-drw select.err {
                border-color: var(--red);
            }

        .fg-drw .field-err {
            font-size: .72rem;
            color: var(--red);
            font-weight: 600;
            margin-top: .1rem;
            display: none;
        }

            .fg-drw .field-err.show {
                display: block;
            }

        .fg-drw .hint {
            font-size: .69rem;
            color: var(--muted);
            margin-top: .15rem;
        }

    /* ── SAVE BUTTONS ── */
    .btn-save {
       
        border: none;
        border-radius: var(--r);
        padding: .52rem 1.3rem;
        font-size: .875rem;
        font-weight: 700;
        cursor: pointer;
        font-family: 'Syne', sans-serif;
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        transition: background var(--transit), transform var(--transit);
    }

        .btn-save:hover {
            background: #0d3580;
            transform: translateY(-1px);
        }

        .btn-save:disabled {
            opacity: .6;
            cursor: not-allowed;
            transform: none;
        }

        .btn-save.edit-mode {
            background: var(--amber);
        }

            .btn-save.edit-mode:hover {
                background: #b87a00;
            }

    .btn-cancel-drw {
        background: none;
        color: var(--ink-3);
        border: 1px solid var(--line);
        border-radius: var(--r);
        padding: .5rem 1rem;
        font-size: .875rem;
        font-weight: 600;
        cursor: pointer;
        font-family: 'Lato', sans-serif;
        display: inline-flex;
        align-items: center;
        transition: background var(--transit);
        text-decoration: none;
    }

        .btn-cancel-drw:hover {
            background: var(--surface);
            color: var(--ink);
        }

    .btn-delete {
        background: var(--red-lt);
        color: var(--red);
        border: 1px solid var(--red);
        border-radius: var(--r);
        padding: .5rem 1rem;
        font-size: .875rem;
        font-weight: 700;
        cursor: pointer;
        font-family: 'Syne', sans-serif;
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        transition: background var(--transit);
        margin-left: auto;
    }

        .btn-delete:hover {
            background: var(--red);
            color: #fff;
        }

    /* ── IMPORT MODAL ── */
    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(11,22,36,.55);
        z-index: 950;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
        opacity: 0;
        visibility: hidden;
        transition: opacity .2s, visibility .2s;
    }

        .modal-overlay.open {
            opacity: 1;
            visibility: visible;
        }

    .modal {
        background: var(--white);
        border-radius: var(--r-lg);
        box-shadow: var(--sh-lg);
        width: min(520px, 100%);
        overflow: hidden;
        transform: scale(.95) translateY(8px);
        transition: transform .2s;
    }

    .modal-overlay.open .modal {
        transform: scale(1) translateY(0);
    }

    .modal-head {
        background: var(--ink);
        border-bottom: 3px solid var(--gold);
        padding: 1rem 1.3rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

        .modal-head h3 {
            font-family: 'Syne', sans-serif;
            font-size: 1rem;
            font-weight: 800;
            color: #fff;
            display: flex;
            align-items: center;
            gap: .5rem;
            margin: 0;
        }

    .modal-close {
        background: rgba(255,255,255,.1);
        border: 1px solid rgba(255,255,255,.2);
        border-radius: var(--r);
        width: 30px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        color: #fff;
        transition: background var(--transit);
    }

        .modal-close:hover {
            background: rgba(255,255,255,.25);
        }

    .modal-body {
        padding: 1.3rem;
    }

    .modal-foot {
        padding: .85rem 1.3rem;
        border-top: 1px solid var(--line);
        display: flex;
        gap: .5rem;
        justify-content: flex-end;
        background: #f9fafc;
    }

    /* Drop zone */
    .drop-zone {
        border: 2px dashed var(--line);
        border-radius: var(--r-lg);
        padding: 2rem 1rem;
        text-align: center;
        cursor: pointer;
        transition: border-color var(--transit), background var(--transit);
        background: #f9fafc;
        position: relative;
    }

        .drop-zone:hover, .drop-zone.drag-over {
            border-color: var(--blue);
            background: var(--blue-lt);
        }

        .drop-zone input[type=file] {
            position: absolute;
            inset: 0;
            opacity: 0;
            cursor: pointer;
            width: 100%;
            height: 100%;
        }

        .drop-zone .dz-icon {
            font-size: 2rem;
            margin-bottom: .5rem;
        }

        .drop-zone .dz-text {
            font-size: .88rem;
            color: var(--muted);
            font-weight: 600;
        }

        .drop-zone .dz-sub {
            font-size: .75rem;
            color: #aaa;
            margin-top: .25rem;
        }

        .drop-zone .dz-file {
            margin-top: .75rem;
            background: var(--white);
            border: 1px solid var(--line);
            border-radius: var(--r);
            padding: .5rem .8rem;
            font-family: 'DM Mono', monospace;
            font-size: .8rem;
            color: var(--blue);
            display: inline-flex;
            align-items: center;
            gap: .4rem;
        }

    .import-opts {
        margin-top: 1rem;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--r);
        padding: .8rem 1rem;
    }

        .import-opts label {
            display: flex;
            align-items: center;
            gap: .5rem;
            font-size: .84rem;
            color: var(--ink);
            cursor: pointer;
            font-weight: 600;
            margin: 0;
        }

        .import-opts .sub-opt {
            font-size: .75rem;
            color: var(--muted);
            margin-top: .35rem;
            padding-left: 1.6rem;
        }

    /* Progress */
    .import-progress {
        display: none;
        margin-top: 1rem;
    }

        .import-progress.show {
            display: block;
        }

    .prog-bar-wrap {
        background: var(--line);
        border-radius: 20px;
        height: 8px;
        overflow: hidden;
        margin-bottom: .5rem;
    }

    .prog-bar {
        height: 100%;
        background: var(--blue);
        border-radius: 20px;
        transition: width .3s;
        width: 0%;
    }

    .prog-text {
        font-size: .78rem;
        color: var(--muted);
        font-weight: 600;
    }

    /* Import result */
    .import-result {
        margin-top: .75rem;
        padding: .65rem .9rem;
        border-radius: var(--r);
        font-size: .83rem;
        font-weight: 600;
        display: none;
    }

        .import-result.show {
            display: block;
        }

        .import-result.success {
            background: var(--green-lt);
            color: var(--green);
            border-left: 4px solid var(--green);
        }

        .import-result.error {
            background: var(--red-lt);
            color: var(--red);
            border-left: 4px solid var(--red);
        }

        .import-result.warn {
            background: var(--amber-lt);
            color: var(--amber);
            border-left: 4px solid var(--amber);
        }

    /* ── DELETE CONFIRM MODAL ── */
    .del-modal-head {
        background: linear-gradient(135deg,#7b1e18,#a93226);
        border-bottom: 3px solid var(--gold);
        padding: 1rem 1.3rem;
        display: flex;
        align-items: center;
        gap: .75rem;
    }

        .del-modal-head h3 {
            font-family: 'Syne',sans-serif;
            font-size: 1rem;
            font-weight: 800;
            color: #fff;
            margin-bottom: .1rem;
        }

        .del-modal-head p {
            font-size: .75rem;
            color: #f5b7b1;
        }

    .del-icon {
        background: rgba(255,255,255,.15);
        border-radius: 50%;
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        flex-shrink: 0;
    }

    .modal-warn {
        background: var(--red-lt);
        border-left: 4px solid var(--red);
        border-radius: var(--r);
        padding: .7rem .9rem;
        font-size: .84rem;
        color: #7b1e18;
        margin-bottom: .9rem;
    }

    .modal-record {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--r);
        padding: .75rem .9rem;
        font-size: .84rem;
    }

        .modal-record .mr-row {
            display: flex;
            justify-content: space-between;
            border-bottom: 1px solid var(--line);
            padding: .35rem 0;
        }

            .modal-record .mr-row:last-child {
                border-bottom: none;
            }

        .modal-record .mr-key {
            font-size: .7rem;
            font-weight: 700;
            color: var(--muted);
            text-transform: uppercase;
        }

        .modal-record .mr-val {
            font-size: .82rem;
            font-weight: 600;
            color: var(--ink);
        }

            .modal-record .mr-val.mono {
                font-family: 'DM Mono', monospace;
                color: var(--blue);
            }

    .btn-confirm-del {
        background: var(--red);
        color: #fff;
        border: none;
        border-radius: var(--r);
        padding: .5rem 1.1rem;
        font-size: .86rem;
        font-weight: 700;
        cursor: pointer;
        font-family: 'Syne', sans-serif;
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        transition: background var(--transit);
    }

        .btn-confirm-del:hover {
            background: #a93226;
        }

        .btn-confirm-del:disabled {
            opacity: .6;
            cursor: not-allowed;
        }

    /* ── TOAST ── */
    .toast-wrap {
        position: fixed;
        bottom: 1.5rem;
        right: 1.5rem;
        z-index: 9999;
        display: flex;
        flex-direction: column;
        gap: .5rem;
        pointer-events: none;
    }

    .toast {
        background: var(--ink);
        color: #fff;
        border-radius: var(--r);
        padding: .7rem 1rem;
        font-size: .84rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: .5rem;
        box-shadow: var(--sh-lg);
        min-width: 240px;
        animation: crToastIn .25s ease, crToastOut .3s ease 2.7s forwards;
        pointer-events: auto;
    }

        .toast.success {
            border-left: 4px solid var(--green);
        }

        .toast.error {
            border-left: 4px solid var(--red);
        }

        .toast.warn {
            border-left: 4px solid var(--amber);
        }

    /* ── SPINNER ── */
    .spinner {
        display: inline-block;
        width: 14px;
        height: 14px;
        border: 2px solid rgba(255,255,255,.35);
        border-top-color: #fff;
        border-radius: 50%;
        animation: crSpin .6s linear infinite;
        flex-shrink: 0;
    }

        .spinner.dark {
            border-color: rgba(0,0,0,.15);
            border-top-color: var(--blue);
        }

    @@keyframes crSpin {
        to {
            transform: rotate(360deg);
        }
    }

    @@keyframes crToastIn {
        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes crToastOut {
        from {
            opacity: 1;
        }

        to {
            opacity: 0;
            transform: translateY(-8px);
        }
    }

    @@media(max-width:640px) {
        .drw-grid {
            grid-template-columns: 1fr;
        }

        .pg-head {
            padding: 1rem 1.1rem;
        }
    }
</style>

<!-- ══════════════════════════════════════════════════════════ PAGE HEADER -->
<div class="pg-head">
    <div class="pg-head-left">
        <!--
            Crime REPORT icon: clipboard with pencil — clearly different from
            CrimeData's database/table icon
        -->
        <div class="pg-icon-badge">
            <svg width="22" height="22" fill="currentColor" viewBox="0 0 16 16">
                <path d="M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1h1a1 1 0 0 1 1 1V14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1h1z" />
                <path d="M9.5 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5zm-3-1A1.5 1.5 0 0 0 5 1.5H3.5A1.5 1.5 0 0 0 2 3h12a1.5 1.5 0 0 0-1.5-1.5H11A1.5 1.5 0 0 0 9.5 0z" />
                <path d="M9.854 7.146a.5.5 0 0 0-.707 0l-3 3a.5.5 0 0 0-.128.21l-.5 1.75a.5.5 0 0 0 .612.612l1.75-.5a.5.5 0 0 0 .21-.128l3-3a.5.5 0 0 0 0-.707l-1.237-1.237zM11 6.586l.707.707-2.854 2.853-1.086.31.31-1.086z" />
            </svg>
        </div>
        <div>
            <h1 id="pageTitle">New Crime Report</h1>
            <div class="sub">Australian Crime Analysis System · <span id="modeLabel">Create Mode</span></div>
        </div>
    </div>
    <div class="head-actions">
        <a href="@Url.Action("Index", "CrimeData")" class="btn-back">
            <svg width="13" height="13" fill="currentColor" viewBox="0 0 16 16"><path d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z" /></svg>
            Crime Data
        </a>
       @*  <button class="btn-import" onclick="openImport()">
            <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z" /><path d="M7.646 1.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1-.708.708L8.5 2.707V11.5a.5.5 0 0 1-1 0V2.707L5.354 4.854a.5.5 0 1 1-.708-.708l3-3z" /></svg>
            Import CSV
        </button> *@
        <button class="btn-primary" onclick="resetToCreate()">
            <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z" /></svg>
            New Report
        </button>
    </div>
</div>

<!-- ══════════════════════════════════════════════════════════ FORM CARD -->
<div class="form-card">
    <div class="form-card-head">
        <div class="form-card-head-title">
            <!-- Small clipboard icon matching the header -->
            <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                <path d="M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1h1a1 1 0 0 1 1 1V14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1h1z" />
                <path d="M9.5 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5zm-3-1A1.5 1.5 0 0 0 5 1.5H3.5A1.5 1.5 0 0 0 2 3h12a1.5 1.5 0 0 0-1.5-1.5H11A1.5 1.5 0 0 0 9.5 0z" />
            </svg>
            <span id="formCardTitle">Create Crime Report</span>
            <span class="mode-badge create" id="modeBadge">New</span>
        </div>
        <div id="editInfo" style="font-size:.76rem; color:var(--muted); font-family:'DM Mono',monospace; display:none;">
            ID: <strong id="editIdDisplay" style="color:var(--blue);">—</strong>
        </div>
    </div>

    <div class="form-card-body">
        <input type="hidden" id="frmId" value="0" />

        <!-- CASE IDENTIFICATION -->
        <div class="drw-section">
            <div class="drw-section-title">
                <svg width="11" height="11" fill="currentColor" viewBox="0 0 16 16"><path d="M0 1.5A1.5 1.5 0 0 1 1.5 0h13A1.5 1.5 0 0 1 16 1.5v13a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 0 14.5z" /></svg>
                Case Identification
            </div>
            <div class="drw-grid">
                <div class="fg-drw">
                    <label>File Number <span class="req">*</span></label>
                    <input type="text" id="frmFileNumber" placeholder="e.g. CR-2024-00001" maxlength="50" />
                    <span class="field-err" id="errFileNumber">Required</span>
                </div>
                <div class="fg-drw">
                    <label>Crime Type <span class="req">*</span></label>
                    <select id="frmCrimeType">
                        <option value="">— Select —</option>
                        @foreach (var ct in Enum.GetValues<CrimeType>())
                        {
                            <option value="@ct">@ct</option>
                        }
                    </select>
                    <span class="field-err" id="errCrimeType">Required</span>
                </div>
                <div class="fg-drw">
                    <label>Date of Report</label>
                    <input type="date" id="frmDateOfReport" />
                </div>
                <div class="fg-drw">
                    <label>Crime Date &amp; Time</label>
                    <input type="datetime-local" id="frmCrimeDateTime" />
                </div>
                <div class="fg-drw full">
                    <label>Raw Date/Time String</label>
                    <input type="text" id="frmCrimeDateTimeRaw" placeholder="Original unparsed value (optional)" maxlength="100" />
                </div>
            </div>
        </div>

        <!-- LOCATION DETAILS -->
        <div class="drw-section">
            <div class="drw-section-title">
                <svg width="11" height="11" fill="currentColor" viewBox="0 0 16 16"><path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10zm0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6z" /></svg>
                Location Details
            </div>
            <div class="drw-grid">
                <div class="fg-drw full">
                    <label>Street Address / Location</label>
                    <input type="text" id="frmLocation" placeholder="e.g. 42 King Street, Melbourne VIC 3000" maxlength="255" />
                </div>
                <div class="fg-drw">
                    <label>Neighbourhood / Suburb</label>
                    <input type="text" id="frmNeighborhood" placeholder="e.g. Fitzroy" maxlength="100" />
                </div>
                <div class="fg-drw">
                    <label>Reporting Area / Beat</label>
                    <input type="text" id="frmReportingArea" placeholder="e.g. AREA-07" maxlength="20" />
                </div>
                <div class="fg-drw">
                    <label>Latitude</label>
                    <input type="number" id="frmLatitude" step="0.0000001" placeholder="-33.8688197" min="-90" max="90" />
                    <span class="hint">Decimal degrees (−90 to 90)</span>
                </div>
                <div class="fg-drw">
                    <label>Longitude</label>
                    <input type="number" id="frmLongitude" step="0.0000001" placeholder="151.2092955" min="-180" max="180" />
                    <span class="hint">Decimal degrees (−180 to 180)</span>
                </div>
            </div>
        </div>
    </div>

    <div class="form-card-foot">
        <button class="btn-save" id="btnSave" onclick="saveReport()">
            <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M2 1a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H9.5a1 1 0 0 0-1 1v7.293l2.646-2.647a.5.5 0 0 1 .708.708l-3.5 3.5a.5.5 0 0 1-.708 0l-3.5-3.5a.5.5 0 1 1 .708-.708L7.5 9.293V2a2 2 0 0 1 2-2H14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h2.5a.5.5 0 0 1 0 1H2z" /></svg>
            <span id="btnSaveText">Create Report</span>
        </button>
        <button class="btn-cancel-drw" onclick="resetToCreate()" id="btnReset" style="display:none;">
            <svg width="12" height="12" fill="currentColor" viewBox="0 0 16 16"><path d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z" /><path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z" /></svg>
            New Report
        </button>
        <button class="btn-delete" id="btnDelete" onclick="openDeleteModal()" style="display:none;">
            <svg width="13" height="13" fill="currentColor" viewBox="0 0 16 16"><path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z" /><path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1z" /></svg>
            Delete Report
        </button>
    </div>
</div>

@* <!-- ══════════════════════════════════════════════════════════ IMPORT MODAL -->
<div class="modal-overlay" id="importModal">
    <div class="modal">
        <div class="modal-head">
            <h3>
                <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z" /><path d="M7.646 1.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1-.708.708L8.5 2.707V11.5a.5.5 0 0 1-1 0V2.707L5.354 4.854a.5.5 0 1 1-.708-.708l3-3z" /></svg>
                Import CSV to Database
            </h3>
            <button class="modal-close" onclick="closeImport()">
                <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z" /></svg>
            </button>
        </div>
        <div class="modal-body">
            <div class="drop-zone" id="dropZone">
                <input type="file" id="csvFile" accept=".csv" onchange="onFileSelected(this)" />
                <div class="dz-icon">📂</div>
                <div class="dz-text">Drop your CSV file here or click to browse</div>
                <div class="dz-sub">Supports Crime_Reports format &middot; Max 50 MB</div>
                <div class="dz-file" id="dzFileName" style="display:none;">
                    <svg width="12" height="12" fill="currentColor" viewBox="0 0 16 16"><path d="M4 0h5.293A1 1 0 0 1 10 .293L13.707 4a1 1 0 0 1 .293.707V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2zm5.5 1.5v2a1 1 0 0 0 1 1h2l-3-3z" /></svg>
