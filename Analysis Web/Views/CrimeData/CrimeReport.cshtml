@Html.AntiForgeryToken()

@section Scripts {
    <script>
        // ─── Config ──────────────────────────────────────────────────────────────────
        const BASE        = '@Url.Action("Index", "CrimeReport")'.replace('/Index','');
        const URLS = {
          list:   '@Url.Action("Index", "CrimeReport")',
          get:    (id) => `${BASE}/Details/${id}`,
          create: '@Url.Action("Create", "CrimeReport")',
          edit:   (id) => `${BASE}/Edit/${id}`,
          del:    (id) => `${BASE}/Delete/${id}`,
          stats:  '@Url.Action("Dashboard", "CrimeReport")',
          bulk:   '@Url.Action("BulkDelete", "CrimeReport")',
        };

        const CRIME_TYPES = @Html.Raw(
        "[" + string.Join(",",
                    Enum.GetValues<CrimeType>().Select(e => $"\"{e}\"")
                ) + "]"
            );

        // ─── State ───────────────────────────────────────────────────────────────────
        let state = { page: 1, pageSize: 20, search:'', crimeType:'', year:'', sortBy:'DateOfReport', asc:'false' };
        let deleteTarget = null;
        let viewRecord   = null;
        let isEditMode   = false;

        // ─── Init ────────────────────────────────────────────────────────────────────
        document.addEventListener('DOMContentLoaded', () => {
          populateEnums();
          populateYears();
          loadPage(1);
          loadStats();

          document.getElementById('selAll').addEventListener('change', e => {
            document.querySelectorAll('.row-cb').forEach(cb => cb.checked = e.target.checked);
            updateBulkBar();
          });
          document.getElementById('fSearch').addEventListener('keydown', e => { if(e.key==='Enter') loadPage(1); });
          document.getElementById('perPage').addEventListener('change', () => loadPage(1));

          document.addEventListener('keydown', e => {
            if (e.key === 'Escape') { closeDrawer(); closeDeleteModal(); }
          });
        });

        function populateEnums() {
          const sel = document.getElementById('frmCrimeType');
          const flt = document.getElementById('fType');
          CRIME_TYPES.forEach(ct => {
            sel.add(new Option(ct, ct));
            flt.add(new Option(ct, ct));
          });
        }

        function populateYears() {
          const sel = document.getElementById('fYear');
          const yr  = new Date().getFullYear();
          for (let y = yr; y >= yr - 10; y--) sel.add(new Option(y, y));
        }

        // ─── Load Table ──────────────────────────────────────────────────────────────
        async function loadPage(page) {
          state.page      = page;
          state.pageSize  = document.getElementById('perPage').value;
          state.search    = document.getElementById('fSearch').value.trim();
          state.crimeType = document.getElementById('fType').value;
          state.year      = document.getElementById('fYear').value;
          state.sortBy    = document.getElementById('fSort').value;
          state.asc       = document.getElementById('fAsc').value;

          const params = new URLSearchParams({
            page: state.page,
            pageSize: state.pageSize,
            search: state.search,
            sortBy: state.sortBy,
            ascending: state.asc,
            ...(state.crimeType && { crimeType: state.crimeType }),
            ...(state.year      && { year: state.year }),
            handler: 'json'
          });

          // Call the server — the controller returns JSON when handler=json
          let data;
          try {
            const res = await fetch(`${URLS.list}?${params}`, { headers: { 'X-Requested-With':'XMLHttpRequest' } });
            if (!res.ok) throw new Error(res.statusText);
            data = await res.json();
          } catch(e) {
            showToast('Failed to load records.', 'error');
            return;
          }

          renderTable(data.reports);
          renderPager(data.totalCount, data.page, data.pageSize);
          document.getElementById('resultInfo').textContent =
            data.totalCount === 0 ? 'No records found' :
            `Showing ${(data.page-1)*data.pageSize+1}–${Math.min(data.page*data.pageSize,data.totalCount)} of ${data.totalCount.toLocaleString()} records`;
          document.getElementById('headCount').textContent = data.totalCount.toLocaleString();
          document.getElementById('statTotal').textContent = data.totalCount.toLocaleString();

          document.getElementById('selAll').checked = false;
          updateBulkBar();
        }

        function renderTable(reports) {
          const tbody = document.getElementById('tblBody');
          if (!reports || reports.length === 0) {
            tbody.innerHTML = `<tr><td colspan="9">
              <div class="empty-state">
                <div class="empty-icon">📂</div>
                <h3>No records found</h3>
                <p>Adjust your search or filter criteria, or create a new report.</p>
              </div>
            </td></tr>`;
            return;
          }

          tbody.innerHTML = reports.map(r => {
            const pillCls  = 'pill pill-' + (r.crimeType || 'default');
            const dateRep  = r.dateOfReport  ? formatDate(r.dateOfReport)     : '—';
            const dateCrim = r.crimeDateTime ? formatDateTime(r.crimeDateTime) : '—';
            return `<tr onclick="openView(${r.crimeReportId})" data-id="${r.crimeReportId}">
              <td onclick="event.stopPropagation()">
                <input type="checkbox" class="cb row-cb" data-id="${r.crimeReportId}" onchange="updateBulkBar()" />
              </td>
              <td class="mono">${esc(r.fileNumber)}</td>
              <td>${dateRep}</td>
              <td>${dateCrim}</td>
              <td><span class="${pillCls}">${esc(r.crimeType)}</span></td>
              <td>${esc(r.neighborhood||'—')}</td>
              <td style="max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="${esc(r.location||'')}">${esc(r.location||'—')}</td>
              <td>${esc(r.reportingArea||'—')}</td>
              <td class="actions" onclick="event.stopPropagation()">
                <button class="act-btn view" title="View" onclick="openView(${r.crimeReportId})">
                  <svg width="13" height="13" fill="currentColor" viewBox="0 0 16 16"><path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zM1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z"/><path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0z"/></svg>
                </button>
                <button class="act-btn edit" title="Edit" onclick="openEdit(${r.crimeReportId})">
                  <svg width="13" height="13" fill="currentColor" viewBox="0 0 16 16"><path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10z"/></svg>
                </button>
                <button class="act-btn del" title="Delete" onclick="openDelete(${r.crimeReportId},'${esc(r.fileNumber)}','${esc(r.crimeType)}','${esc(r.neighborhood||'')}')">
                  <svg width="13" height="13" fill="currentColor" viewBox="0 0 16 16"><path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z"/><path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1z"/></svg>
                </button>
              </td>
            </tr>`;
          }).join('');
        }

        function renderPager(total, page, pageSize) {
          const totalPages = Math.ceil(total / pageSize);
          const pager = document.getElementById('pagerRow');
          if (totalPages <= 1) { pager.style.display = 'none'; return; }
          pager.style.display = 'flex';
          document.getElementById('pgInfo').textContent = `Page ${page} of ${totalPages}`;

          const links = document.getElementById('pgLinks');
          let html = '';
          const disabled = (t,lbl) => `<span class="pg-btn disabled">${lbl}</span>`;
          const link = (p,lbl) => `<button class="pg-btn${p===page?' active':''}" onclick="loadPage(${p})">${lbl}</button>`;

          html += page > 1 ? link(1,'«') + link(page-1,'‹') : disabled('','«') + disabled('','‹');
          for (let p = Math.max(1,page-2); p <= Math.min(totalPages,page+2); p++) html += link(p,p);
          html += page < totalPages ? link(page+1,'›') + link(totalPages,'»') : disabled('','›') + disabled('','»');
          links.innerHTML = html;
        }

        // ─── Stats ───────────────────────────────────────────────────────────────────
        async function loadStats() {
          try {
            const res = await fetch(URLS.stats, { headers: { 'X-Requested-With':'XMLHttpRequest' } });
            if (!res.ok) return;
            const s = await res.json();
            document.getElementById('statYear').textContent  = (s.reportsThisYear||0).toLocaleString();
            document.getElementById('statMonth').textContent = (s.reportsThisMonth||0).toLocaleString();
            if (s.byType) {
              const top = Object.entries(s.byType).sort((a,b)=>b[1]-a[1])[0];
              document.getElementById('statType').textContent = top ? top[0] : '—';
            }
          } catch {}
        }

        // ─── Drawer — CREATE ─────────────────────────────────────────────────────────
        function openCreate() {
          isEditMode = false;
          setDrawerMode('form');
          document.getElementById('drawerTitleText').textContent = 'New Crime Report';
          document.getElementById('btnSave').innerHTML = `<svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M2 1a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H9.5a1 1 0 0 0-1 1v7.293l2.646-2.647a.5.5 0 0 1 .708.708l-3.5 3.5a.5.5 0 0 1-.708 0l-3.5-3.5a.5.5 0 1 1 .708-.708L7.5 9.293V2a2 2 0 0 1 2-2H14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h2.5a.5.5 0 0 1 0 1H2z"/></svg> Create Report`;
          resetForm();
          openDrawer();
        }

        // ─── Drawer — VIEW ───────────────────────────────────────────────────────────
        async function openView(id) {
          setDrawerMode('view');
          document.getElementById('drawerTitleText').textContent = 'Loading…';
          openDrawer();

          try {
            const res = await fetch(URLS.get(id), { headers: { 'X-Requested-With':'XMLHttpRequest' } });
            if (!res.ok) throw new Error();
            const r = await res.json();
            viewRecord = r;
            document.getElementById('drawerTitleText').textContent = r.fileNumber;
            document.getElementById('frmId').value = r.crimeReportId;

            const pillCls = 'pill pill-'+(r.crimeType||'default');
            document.getElementById('viewContent').innerHTML = `
              <dl class="detail-dl">
                <dt class="detail-dt">File Number</dt><dd class="detail-dd mono">${esc(r.fileNumber)}</dd>
                <dt class="detail-dt">Crime Type</dt><dd class="detail-dd"><span class="${pillCls}">${esc(r.crimeType)}</span></dd>
                <dt class="detail-dt">Date Reported</dt><dd class="detail-dd">${r.dateOfReport ? formatDate(r.dateOfReport) : '<span class="empty">Not recorded</span>'}</dd>
                <dt class="detail-dt">Crime Date/Time</dt><dd class="detail-dd">${r.crimeDateTime ? formatDateTime(r.crimeDateTime) : '<span class="empty">Not recorded</span>'}</dd>
                <dt class="detail-dt">Raw Date/Time</dt><dd class="detail-dd ${!r.crimeDateTimeRaw?'empty':''}">${r.crimeDateTimeRaw ? esc(r.crimeDateTimeRaw) : 'Not recorded'}</dd>
                <dt class="detail-dt">Location</dt><dd class="detail-dd ${!r.location?'empty':''}">${r.location ? esc(r.location) : 'Not recorded'}</dd>
                <dt class="detail-dt">Neighbourhood</dt><dd class="detail-dd ${!r.neighborhood?'empty':''}">${r.neighborhood ? esc(r.neighborhood) : 'Not recorded'}</dd>
                <dt class="detail-dt">Reporting Area</dt><dd class="detail-dd ${!r.reportingArea?'empty':''}">${r.reportingArea ? esc(r.reportingArea) : 'Not recorded'}</dd>
                <dt class="detail-dt">Latitude</dt><dd class="detail-dd mono ${!r.latitude?'empty':''}">${r.latitude != null ? r.latitude.toFixed(7) : '—'}</dd>
                <dt class="detail-dt">Longitude</dt><dd class="detail-dd mono ${!r.longitude?'empty':''}">${r.longitude != null ? r.longitude.toFixed(7) : '—'}</dd>
                <dt class="detail-dt">Record ID</dt><dd class="detail-dd mono">#${r.crimeReportId}</dd>
                <dt class="detail-dt">Imported At</dt><dd class="detail-dd">${formatDateTime(r.importedAt)} UTC</dd>
                <dt class="detail-dt">Row Stamp</dt><dd class="detail-dd" style="font-family:'DM Mono',monospace;font-size:.72rem;color:var(--muted);">${r.rowStamp}</dd>
              </dl>
              ${r.latitude != null && r.longitude != null ? `
                <div style="margin-top:1rem;">
                  <div style="font-size:.67rem;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.8px;margin-bottom:.5rem;">📍 Incident Map</div>
                  <iframe
                    style="width:100%;height:240px;border:1px solid var(--line);border-radius:var(--r);"
                    title="Incident location"
                    src="https://www.openstreetmap.org/export/embed.html?bbox=${r.longitude-0.01},${r.latitude-0.01},${r.longitude+0.01},${r.latitude+0.01}&layer=mapnik&marker=${r.latitude},${r.longitude}"
                    loading="lazy">
                  </iframe>
                </div>` : ''}
            `;
          } catch {
            document.getElementById('viewContent').innerHTML = '<p style="color:var(--red);padding:1rem;">Failed to load record.</p>';
          }
        }

        // ─── Drawer — EDIT ───────────────────────────────────────────────────────────
        async function openEdit(id) {
          isEditMode = true;
          setDrawerMode('form');
          document.getElementById('drawerTitleText').textContent = 'Loading…';
          document.getElementById('btnSave').innerHTML = `<svg width="13" height="13" fill="currentColor" viewBox="0 0 16 16"><path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10z"/></svg> Save Changes`;
          openDrawer();
          resetForm();

          try {
            const res = await fetch(URLS.get(id), { headers: { 'X-Requested-With':'XMLHttpRequest' } });
            if (!res.ok) throw new Error();
            const r = await res.json();
            document.getElementById('drawerTitleText').textContent = `Edit — ${r.fileNumber}`;
            document.getElementById('frmId').value         = r.crimeReportId;
            document.getElementById('frmFileNumber').value = r.fileNumber;
            document.getElementById('frmCrimeType').value  = r.crimeType;
            document.getElementById('frmDateOfReport').value   = r.dateOfReport   ? r.dateOfReport.substring(0,10) : '';
            document.getElementById('frmCrimeDateTime').value  = r.crimeDateTime  ? r.crimeDateTime.substring(0,16) : '';
            document.getElementById('frmCrimeDateTimeRaw').value = r.crimeDateTimeRaw || '';
            document.getElementById('frmLocation').value    = r.location    || '';
            document.getElementById('frmNeighborhood').value= r.neighborhood|| '';
            document.getElementById('frmReportingArea').value = r.reportingArea || '';
            document.getElementById('frmLatitude').value    = r.latitude  != null ? r.latitude  : '';
            document.getElementById('frmLongitude').value   = r.longitude != null ? r.longitude : '';
          } catch {
            showToast('Failed to load record.', 'error');
            closeDrawer();
          }
        }

        function switchToEdit() {
          if (viewRecord) openEdit(viewRecord.crimeReportId || document.getElementById('frmId').value);
        }

        // ─── Save (Create / Edit) ────────────────────────────────────────────────────
        async function saveReport() {
          clearErrors();
          const id = parseInt(document.getElementById('frmId').value) || 0;

          const payload = {
            crimeReportId:    id,
            fileNumber:       document.getElementById('frmFileNumber').value.trim(),
            crimeType:        document.getElementById('frmCrimeType').value,
            dateOfReport:     document.getElementById('frmDateOfReport').value || null,
            crimeDateTime:    document.getElementById('frmCrimeDateTime').value || null,
            crimeDateTimeRaw: document.getElementById('frmCrimeDateTimeRaw').value.trim() || null,
            location:         document.getElementById('frmLocation').value.trim() || null,
            neighborhood:     document.getElementById('frmNeighborhood').value.trim() || null,
            reportingArea:    document.getElementById('frmReportingArea').value.trim() || null,
            latitude:         document.getElementById('frmLatitude').value  !== '' ? parseFloat(document.getElementById('frmLatitude').value)  : null,
            longitude:        document.getElementById('frmLongitude').value !== '' ? parseFloat(document.getElementById('frmLongitude').value) : null,
          };

          // Client-side validation
          let valid = true;
          if (!payload.fileNumber) { showErr('errFileNumber', 'File number is required.'); valid = false; }
          if (!payload.crimeType)  { showErr('errCrimeType',  'Crime type is required.');  valid = false; }
          if (payload.latitude  != null && (payload.latitude  < -90  || payload.latitude  > 90))  { showToast('Latitude must be −90 to 90.',   'error'); valid = false; }
          if (payload.longitude != null && (payload.longitude < -180 || payload.longitude > 180)) { showToast('Longitude must be −180 to 180.', 'error'); valid = false; }
          if (!valid) return;

          const btn  = document.getElementById('btnSave');
          btn.disabled = true;
          const origHTML = btn.innerHTML;
          btn.innerHTML = `<span class="spinner"></span> Saving…`;

          const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
          const url    = isEditMode ? URLS.edit(id) : URLS.create;
          const method = 'POST';

          try {
            const res = await fetch(url, {
              method,
              headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest',
                'RequestVerificationToken': token
              },
              body: JSON.stringify(payload)
            });

            const data = await res.json();
            if (!res.ok) {
              if (data.errors) {
                Object.entries(data.errors).forEach(([k,v]) => {
                  const errId = 'err' + k.charAt(0).toUpperCase() + k.slice(1);
                  showErr(errId, Array.isArray(v) ? v[0] : v);
                });
              } else {
                showToast(data.message || 'Save failed.', 'error');
              }
            } else {
              showToast(isEditMode ? `Report ${data.fileNumber} updated.` : `Report ${data.fileNumber} created.`, 'success');
              closeDrawer();
              loadPage(state.page);
              loadStats();
            }
          } catch {
            showToast('Network error. Please try again.', 'error');
          } finally {
            btn.disabled  = false;
            btn.innerHTML = origHTML;
          }
        }

        // ─── Delete ───────────────────────────────────────────────────────────────────
        function openDelete(id, fileNum, crimeType, neighborhood) {
          deleteTarget = id;
          document.getElementById('delSubtitle').textContent = `File No. ${fileNum} · Record #${id}`;
          document.getElementById('delRecord').innerHTML = `
            <div class="mr-row"><span class="mr-key">File Number</span><span class="mr-val mono">${esc(fileNum)}</span></div>
            <div class="mr-row"><span class="mr-key">Crime Type</span><span class="mr-val">${esc(crimeType)}</span></div>
            <div class="mr-row"><span class="mr-key">Neighbourhood</span><span class="mr-val">${esc(neighborhood||'—')}</span></div>
          `;
          document.getElementById('delModal').classList.add('open');
        }

        async function confirmDelete() {
          if (!deleteTarget) return;
          const btn = document.getElementById('btnConfirmDel');
          btn.disabled = true;
          btn.innerHTML = `<span class="spinner"></span> Deleting…`;
          const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

          try {
            const res = await fetch(URLS.del(deleteTarget), {
              method: 'POST',
              headers: { 'X-Requested-With':'XMLHttpRequest', 'RequestVerificationToken': token },
            });
            if (res.ok) {
              showToast('Crime report deleted.', 'success');
              closeDeleteModal();
              loadPage(state.page);
              loadStats();
            } else {
              showToast('Failed to delete report.', 'error');
            }
          } catch {
            showToast('Network error.', 'error');
          } finally {
            btn.disabled = false;
            btn.innerHTML = `<svg width="13" height="13" fill="currentColor" viewBox="0 0 16 16"><path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5z"/></svg> Delete Report`;
          }
        }

        function closeDeleteModal() {
          document.getElementById('delModal').classList.remove('open');
          deleteTarget = null;
        }

        // ─── Bulk Delete ──────────────────────────────────────────────────────────────
        async function bulkDelete() {
          const ids = [...document.querySelectorAll('.row-cb:checked')].map(cb => +cb.dataset.id);
          if (!ids.length) return;
          if (!confirm(`Permanently delete ${ids.length} record(s)?`)) return;
          const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

          try {
            const res = await fetch(URLS.bulk, {
              method: 'POST',
              headers: { 'Content-Type':'application/json', 'X-Requested-With':'XMLHttpRequest', 'RequestVerificationToken': token },
              body: JSON.stringify(ids)
            });
            const d = await res.json();
            showToast(`Deleted ${d.deleted} record(s).`, 'success');
            loadPage(state.page);
            loadStats();
          } catch {
            showToast('Bulk delete failed.', 'error');
          }
        }

        // ─── Helpers ──────────────────────────────────────────────────────────────────
        function openDrawer()  { document.getElementById('drawer').classList.add('open'); document.getElementById('drawerOverlay').classList.add('open'); }
        function closeDrawer() { document.getElementById('drawer').classList.remove('open'); document.getElementById('drawerOverlay').classList.remove('open'); }

        function setDrawerMode(mode) {
          const isForm = mode === 'form';
          document.getElementById('formBody').style.display = isForm ? '' : 'none';
          document.getElementById('formFoot').style.display = isForm ? '' : 'none';
          document.getElementById('viewBody').style.display = isForm ? 'none' : '';
          document.getElementById('viewFoot').style.display = isForm ? 'none' : '';
        }

        function resetForm() {
          ['frmFileNumber','frmCrimeType','frmDateOfReport','frmCrimeDateTime','frmCrimeDateTimeRaw',
           'frmLocation','frmNeighborhood','frmReportingArea','frmLatitude','frmLongitude']
            .forEach(id => { const el = document.getElementById(id); if(el) el.value = ''; });
          document.getElementById('frmId').value = '0';
          clearErrors();
        }

        function showErr(id, msg) {
          const el = document.getElementById(id);
          if (!el) return;
          el.textContent = msg;
          el.classList.add('show');
          el.previousElementSibling?.classList.add('err');
        }
        function clearErrors() {
          document.querySelectorAll('.field-err').forEach(el => { el.classList.remove('show'); el.previousElementSibling?.classList.remove('err'); });
        }

        function updateBulkBar() {
          const checked = document.querySelectorAll('.row-cb:checked');
          const bar = document.getElementById('bulkBar');
          if (checked.length > 0) { bar.classList.add('show'); document.getElementById('bulkCount').textContent = checked.length + ' selected'; }
          else bar.classList.remove('show');
        }

        function clearFilters() {
          document.getElementById('fSearch').value = '';
          document.getElementById('fType').value   = '';
          document.getElementById('fYear').value   = '';
          document.getElementById('fSort').value   = 'DateOfReport';
          document.getElementById('fAsc').value    = 'false';
          loadPage(1);
        }

        function showToast(msg, type='success') {
          const wrap = document.getElementById('toastWrap');
          const t    = document.createElement('div');
          t.className = `toast ${type}`;
          t.innerHTML = `<span>${type==='success'?'✓':'✕'}</span> ${esc(msg)}`;
          wrap.appendChild(t);
          setTimeout(() => t.remove(), 3100);
        }

        function esc(s) {
          if (s == null) return '';
          return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
        }

        function formatDate(s) {
          if (!s) return '—';
          const d = new Date(s);
          return isNaN(d) ? s : d.toLocaleDateString('en-AU', { day:'2-digit', month:'short', year:'numeric' });
        }
        function formatDateTime(s) {
          if (!s) return '—';
          const d = new Date(s);
          return isNaN(d) ? s : d.toLocaleString('en-AU', { day:'2-digit', month:'short', year:'numeric', hour:'2-digit', minute:'2-digit', hour12:false });
        }
    </script>
}