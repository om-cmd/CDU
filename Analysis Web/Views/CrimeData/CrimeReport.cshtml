@using Domain_Layer.DbModels.Enum
@{
    ViewData["Title"] = "Crime Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />

<style>
    /* (keep all your existing CSS here — unchanged) */
    .content-wrapper, .container-fluid, main > .container,
    main > .container-fluid, .page-content, .main-content {
        padding: 0 !important;
        margin: 0 !important;
    }

    .cr-page {
        display: flex;
        flex-direction: column;
        min-height: calc(100vh - 56px);
        background: #f1f5f9;
        font-family: 'Inter', sans-serif;
        font-size: .875rem;
        color: #111827;
    }

    .cr-topbar {
        background: #0f172a;
        border-bottom: 2px solid #c9a227;
        padding: .55rem 1.25rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-shrink: 0;
    }

    .cr-topbar-left {
        display: flex;
        align-items: center;
        gap: .6rem;
    }

    .cr-topbar-icon {
        width: 28px;
        height: 28px;
        background: #c9a227;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #0f172a;
        flex-shrink: 0;
    }

    .cr-topbar-title {
        font-size: .88rem;
        font-weight: 600;
        color: #fff;
        line-height: 1.1;
    }

    .cr-topbar-sub {
        font-size: .66rem;
        color: #94a3b8;
        letter-spacing: .3px;
        margin-top: 1px;
    }

    .cr-topbar-right {
        display: flex;
        align-items: center;
        gap: .45rem;
    }

    .cr-pill {
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        padding: .2rem .6rem;
        border-radius: 20px;
        font-size: .66rem;
        font-weight: 600;
        letter-spacing: .4px;
        text-transform: uppercase;
    }

        .cr-pill.create {
            background: #1d4ed820;
            color: #60a5fa;
            border: 1px solid #1d4ed840;
        }

        .cr-pill.edit {
            background: #92400e20;
            color: #fbbf24;
            border: 1px solid #92400e40;
        }

    .cr-pill-dot {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: currentColor;
    }

    .cr-edit-strip {
        display: none;
        background: #fffbeb;
        border-bottom: 1px solid #fef3c7;
        padding: .38rem 1.25rem;
        align-items: center;
        gap: 1.5rem;
        font-size: .72rem;
        color: #92400e;
        font-family: 'DM Mono', monospace;
        flex-wrap: wrap;
    }

        .cr-edit-strip.show {
            display: flex;
        }

        .cr-edit-strip .es-label {
            opacity: .6;
        }

        .cr-edit-strip .es-val {
            font-weight: 500;
        }

        .cr-edit-strip .es-id {
            color: #2563eb;
        }

    .cr-body {
        display: flex;
        flex: 1;
        min-height: 0;
    }

    .cr-sidebar {
        width: 190px;
        flex-shrink: 0;
        background: #fff;
        border-right: 1px solid #e2e8f0;
        display: flex;
        flex-direction: column;
    }

    .cr-sidebar-head {
        padding: .55rem .85rem;
        border-bottom: 1px solid #f1f5f9;
        font-size: .63rem;
        font-weight: 600;
        color: #94a3b8;
        letter-spacing: .6px;
        text-transform: uppercase;
    }

    .cr-sidebar-item {
        display: flex;
        align-items: center;
        gap: .45rem;
        padding: .45rem .85rem;
        font-size: .76rem;
        font-weight: 500;
        color: #374151;
        border-left: 2px solid transparent;
        cursor: pointer;
        transition: all .12s;
        text-decoration: none;
        background: none;
        border-right: none;
        border-top: none;
        border-bottom: none;
        text-align: left;
        width: 100%;
    }

        .cr-sidebar-item:hover {
            background: #f8fafc;
            color: #111827;
        }

        .cr-sidebar-item.active {
            border-left-color: #2563eb;
            background: #eff6ff;
            color: #2563eb;
        }

        .cr-sidebar-item.active-edit {
            border-left-color: #d97706;
            background: #fffbeb;
            color: #d97706;
        }

        .cr-sidebar-item svg {
            opacity: .55;
            flex-shrink: 0;
        }

        .cr-sidebar-item.active svg,
        .cr-sidebar-item.active-edit svg {
            opacity: 1;
        }

    .cr-sidebar-divider {
        height: 1px;
        background: #f1f5f9;
        margin: .2rem 0;
    }

    .cr-sidebar-id {
        display: none;
        margin-top: auto;
        padding: .6rem .85rem;
        border-top: 1px solid #f1f5f9;
        font-family: 'DM Mono', monospace;
        font-size: .67rem;
        color: #94a3b8;
    }

        .cr-sidebar-id.show {
            display: block;
        }

        .cr-sidebar-id strong {
            color: #2563eb;
            display: block;
            font-size: .73rem;
            margin-top: 1px;
        }

    .cr-loading-state {
        display: none;
        flex: 1;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        gap: .65rem;
        color: #6b7280;
        font-size: .82rem;
        padding: 2rem;
    }

        .cr-loading-state.show {
            display: flex;
        }

    .cr-load-spin {
        width: 28px;
        height: 28px;
        border: 2.5px solid #e5e7eb;
        border-top-color: #2563eb;
        border-radius: 50%;
        animation: spin .6s linear infinite;
    }

    .cr-main {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        overflow-y: auto;
    }

    .cr-form-body {
        flex: 1;
    }

    .cr-section {
        background: #fff;
        border-bottom: 1px solid #e2e8f0;
        padding: .85rem 1.25rem;
    }

    .cr-section-title {
        display: flex;
        align-items: center;
        gap: .4rem;
        font-size: .67rem;
        font-weight: 600;
        letter-spacing: .6px;
        text-transform: uppercase;
        color: #6b7280;
        margin-bottom: .7rem;
        padding-bottom: .45rem;
        border-bottom: 1px solid #f1f5f9;
    }

    .cr-grid {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: .55rem .8rem;
    }

        .cr-grid .g-full {
            grid-column: 1 / -1;
        }

        .cr-grid .g-half {
            grid-column: span 1;
        }

        .cr-grid .g-two {
            grid-column: span 2;
        }

    .cr-field {
        display: flex;
        flex-direction: column;
        gap: .18rem;
    }

        .cr-field label {
            font-size: .68rem;
            font-weight: 600;
            color: #4b5563;
        }

            .cr-field label .req {
                color: #ef4444;
                margin-left: 1px;
            }

        .cr-field input, .cr-field select {
            border: 1px solid #d1d5db;
            border-radius: 6px;
            padding: .35rem .6rem;
            font-size: .82rem;
            color: #111827;
            background: #fff;
            font-family: 'Inter', sans-serif;
            transition: border-color .12s, box-shadow .12s;
            width: 100%;
            height: 31px;
        }

            .cr-field input:focus, .cr-field select:focus {
                outline: none;
                border-color: #2563eb;
                box-shadow: 0 0 0 2px rgba(37,99,235,.1);
            }

            .cr-field input.has-err, .cr-field select.has-err {
                border-color: #ef4444;
            }

        .cr-field .field-err {
            font-size: .67rem;
            color: #ef4444;
            font-weight: 500;
            display: none;
            margin-top: 1px;
        }

            .cr-field .field-err.show {
                display: block;
            }

        .cr-field .hint {
            font-size: .66rem;
            color: #9ca3af;
            margin-top: 1px;
        }

    .cr-footer {
        background: #fff;
        border-top: 1px solid #e2e8f0;
        padding: .6rem 1.25rem;
        display: flex;
        align-items: center;
        gap: .45rem;
        flex-shrink: 0;
        flex-wrap: wrap;
    }

    .cr-footer-back {
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        color: #6b7280;
        font-size: .78rem;
        font-weight: 500;
        text-decoration: none;
        padding: .28rem .75rem;
        border-radius: 5px;
        border: 1px solid #d1d5db;
        background: #fff;
        transition: all .15s;
        margin-left: auto;
        height: 31px;
    }

        .cr-footer-back:hover {
            background: #f9fafb;
            color: #374151;
            border-color: #9ca3af;
        }

    .btn-submit {
        display: inline-flex;
        align-items: center;
        gap: .32rem;
        border: none;
        border-radius: 6px;
        padding: .38rem 1.05rem;
        font-size: .815rem;
        font-weight: 600;
        cursor: pointer;
        font-family: 'Inter', sans-serif;
        transition: all .12s;
        height: 31px;
    }

        .btn-submit.mode-create {
            background: #2563eb;
            color: #fff;
        }

            .btn-submit.mode-create:hover {
                background: #1d4ed8;
            }

        .btn-submit.mode-edit {
            background: #d97706;
            color: #fff;
        }

            .btn-submit.mode-edit:hover {
                background: #b45309;
            }

        .btn-submit:disabled {
            opacity: .5;
            cursor: not-allowed;
        }

    .btn-outline {
        display: inline-flex;
        align-items: center;
        gap: .28rem;
        border: 1px solid #d1d5db;
        border-radius: 6px;
        padding: .36rem .85rem;
        font-size: .79rem;
        font-weight: 500;
        cursor: pointer;
        background: #fff;
        color: #374151;
        font-family: 'Inter', sans-serif;
        text-decoration: none;
        transition: all .12s;
        height: 31px;
    }

        .btn-outline:hover {
            border-color: #9ca3af;
            background: #f9fafb;
            color: #111827;
        }

    .btn-danger-outline {
        display: inline-flex;
        align-items: center;
        gap: .28rem;
        border: 1px solid #fca5a5;
        border-radius: 6px;
        padding: .36rem .85rem;
        font-size: .79rem;
        font-weight: 500;
        cursor: pointer;
        background: #fff;
        color: #dc2626;
        font-family: 'Inter', sans-serif;
        transition: all .12s;
        height: 31px;
    }

        .btn-danger-outline:hover {
            background: #fef2f2;
            border-color: #dc2626;
        }

    .del-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.45);
        z-index: 1050;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
        opacity: 0;
        visibility: hidden;
        transition: opacity .18s, visibility .18s;
    }

        .del-overlay.open {
            opacity: 1;
            visibility: visible;
        }

    .del-modal {
        background: #fff;
        border-radius: 10px;
        width: min(430px, 100%);
        overflow: hidden;
        transform: scale(.96) translateY(6px);
        transition: transform .18s;
        box-shadow: 0 20px 50px rgba(0,0,0,.2);
    }

    .del-overlay.open .del-modal {
        transform: scale(1) translateY(0);
    }

    .del-head {
        background: #7f1d1d;
        padding: .8rem 1.1rem;
        display: flex;
        align-items: flex-start;
        gap: .65rem;
    }

    .del-head-icon {
        width: 30px;
        height: 30px;
        background: rgba(255,255,255,.15);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        flex-shrink: 0;
        margin-top: 1px;
    }

    .del-head h3 {
        color: #fff;
        font-size: .86rem;
        font-weight: 600;
        margin: 0 0 2px;
    }

    .del-head p {
        color: #fca5a5;
        font-size: .71rem;
        margin: 0;
    }

    .del-body {
        padding: .9rem 1.1rem;
    }

    .del-warn {
        background: #fef2f2;
        border-left: 3px solid #dc2626;
        border-radius: 0 5px 5px 0;
        padding: .5rem .7rem;
        font-size: .77rem;
        color: #7f1d1d;
        margin-bottom: .7rem;
    }

    .del-record {
        background: #f9fafb;
        border: 1px solid #e5e7eb;
        border-radius: 7px;
        overflow: hidden;
        font-size: .77rem;
    }

    .del-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: .36rem .75rem;
        border-bottom: 1px solid #f3f4f6;
    }

        .del-row:last-child {
            border-bottom: none;
        }

    .del-key {
        color: #6b7280;
        font-size: .65rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .5px;
    }

    .del-val {
        font-weight: 500;
        color: #111827;
    }

        .del-val.mono {
            font-family: 'DM Mono', monospace;
            color: #2563eb;
            font-size: .73rem;
        }

    .del-foot {
        padding: .7rem 1.1rem;
        border-top: 1px solid #e5e7eb;
        background: #f9fafb;
        display: flex;
        gap: .4rem;
        justify-content: flex-end;
    }

    .btn-confirm-del {
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        background: #dc2626;
        color: #fff;
        border: none;
        border-radius: 6px;
        padding: .36rem .85rem;
        font-size: .79rem;
        font-weight: 600;
        cursor: pointer;
        font-family: 'Inter', sans-serif;
        transition: background .12s;
        height: 30px;
    }

        .btn-confirm-del:hover {
            background: #b91c1c;
        }

        .btn-confirm-del:disabled {
            opacity: .5;
            cursor: not-allowed;
        }

    .btn-cancel-del {
        display: inline-flex;
        align-items: center;
        border: 1px solid #d1d5db;
        border-radius: 6px;
        padding: .36rem .85rem;
        font-size: .79rem;
        font-weight: 500;
        cursor: pointer;
        background: #fff;
        color: #374151;
        font-family: 'Inter', sans-serif;
        transition: background .12s;
        height: 30px;
    }

        .btn-cancel-del:hover {
            background: #f3f4f6;
        }

    .toast-wrap {
        position: fixed;
        bottom: 1rem;
        right: 1rem;
        z-index: 9999;
        display: flex;
        flex-direction: column;
        gap: .3rem;
        pointer-events: none;
    }

    .toast {
        background: #0f172a;
        color: #f1f5f9;
        border-radius: 7px;
        padding: .52rem .82rem;
        font-size: .77rem;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: .4rem;
        box-shadow: 0 8px 24px rgba(0,0,0,.25);
        min-width: 200px;
        animation: tIn .2s ease, tOut .25s ease 2.75s forwards;
        pointer-events: auto;
        font-family: 'Inter', sans-serif;
    }

        .toast.success {
            border-left: 3px solid #16a34a;
        }

        .toast.error {
            border-left: 3px solid #dc2626;
        }

        .toast.warn {
            border-left: 3px solid #d97706;
        }

    .spinner {
        display: inline-block;
        width: 12px;
        height: 12px;
        border: 2px solid rgba(255,255,255,.25);
        border-top-color: #fff;
        border-radius: 50%;
        animation: spin .5s linear infinite;
        flex-shrink: 0;
    }

        .spinner.dark {
            border-color: rgba(0,0,0,.12);
            border-top-color: #2563eb;
        }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    @@keyframes tIn {
        from {
            opacity: 0;
            transform: translateX(8px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    @@keyframes tOut {
        to {
            opacity: 0;
            transform: translateX(6px);
        }
    }

    @@media (max-width:640px) {
        .cr-sidebar {
            display: none;
        }

        .cr-grid {
            grid-template-columns: 1fr 1fr;
        }

            .cr-grid .g-full {
                grid-column: 1 / -1;
            }

            .cr-grid .g-two {
                grid-column: 1 / -1;
            }
    }

    @@media (max-width:480px) {
        .cr-grid {
            grid-template-columns: 1fr;
        }
    }

    /* Polished dashboard presentation */
    .cr-page {
        margin: -15px;
        padding: 18px;
        gap: 14px;
        background: #eef3f8;
    }

    .cr-topbar {
        min-height: 74px;
        border-radius: 8px;
        border: 1px solid #d7e1ef;
        border-bottom: 4px solid #d7153a;
        background: linear-gradient(135deg, #002664, #173f7a);
        padding: 1rem 1.2rem;
        box-shadow: 0 14px 28px rgba(15, 23, 42, .14);
    }

    .cr-topbar-icon {
        width: 42px;
        height: 42px;
        border-radius: 8px;
        background: #ffffff;
        color: #002664;
        box-shadow: inset 0 -3px 0 #d7153a;
    }

    .cr-topbar-icon svg {
        width: 20px;
        height: 20px;
    }

    .cr-topbar-title {
        font-size: 1.15rem;
        font-weight: 800;
    }

    .cr-topbar-sub {
        color: #dce7f5;
        font-size: .76rem;
    }

    .cr-pill {
        border-radius: 999px;
        padding: .36rem .78rem;
    }

    .cr-pill.create {
        background: #e6f4ff;
        border-color: #b9dcff;
        color: #002664;
    }

    .cr-pill.edit {
        background: #fff7e6;
        border-color: #f6d690;
        color: #8a4b00;
    }

    .cr-edit-strip {
        border: 1px solid #f2d184;
        border-radius: 8px;
        background: #fffbeb;
        padding: .65rem 1rem;
    }

    .cr-body {
        gap: 14px;
        min-height: calc(100vh - 220px);
    }

    .cr-sidebar,
    .cr-main {
        border: 1px solid #d7e1ef;
        border-radius: 8px;
        background: #fff;
        box-shadow: 0 10px 24px rgba(15, 23, 42, .07);
        overflow: hidden;
    }

    .cr-sidebar {
        width: 220px;
    }

    .cr-sidebar-head {
        background: #f7fafc;
        color: #52657d;
        padding: .85rem 1rem;
    }

    .cr-sidebar-item {
        min-height: 42px;
        padding: .68rem 1rem;
        font-size: .82rem;
        border-left-width: 4px;
    }

    .cr-sidebar-item.active,
    .cr-sidebar-item.active-edit {
        background: #edf5ff;
        color: #002664;
        border-left-color: #d7153a;
    }

    .cr-main {
        min-height: 560px;
    }

    .cr-section {
        margin: 14px;
        border: 1px solid #e1e9f2;
        border-radius: 8px;
        padding: 1rem;
        background: #fff;
    }

    .cr-section + .cr-section {
        margin-top: 0;
    }

    .cr-section-title {
        color: #002664;
        font-size: .75rem;
        font-weight: 900;
        margin-bottom: .95rem;
    }

    .cr-grid {
        gap: .85rem 1rem;
    }

    .cr-field {
        gap: .28rem;
    }

    .cr-field label {
        color: #34465f;
        font-size: .75rem;
        font-weight: 800;
    }

    .cr-field input,
    .cr-field select {
        height: 40px;
        border-radius: 7px;
        border-color: #c9d5e4;
        background: #f9fbfd;
        font-size: .88rem;
        padding: .5rem .7rem;
    }

    .cr-field input:focus,
    .cr-field select:focus {
        border-color: #002664;
        box-shadow: 0 0 0 3px rgba(0, 38, 100, .12);
        background: #fff;
    }

    .cr-field .hint {
        color: #708094;
        font-size: .72rem;
    }

    .cr-footer {
        position: sticky;
        bottom: 0;
        z-index: 2;
        border-top: 1px solid #d7e1ef;
        padding: .85rem 1rem;
        background: rgba(255, 255, 255, .96);
        backdrop-filter: blur(8px);
    }

    .btn-submit,
    .btn-outline,
    .btn-danger-outline,
    .cr-footer-back {
        min-height: 38px;
        height: 38px;
        border-radius: 7px;
        font-size: .84rem;
    }

    .btn-submit.mode-create {
        background: #002664;
    }

    .btn-submit.mode-create:hover {
        background: #001b49;
    }

    .btn-submit.mode-edit {
        background: #b7791f;
    }

    .cr-loading-state {
        min-height: 420px;
    }

    @@media (max-width: 900px) {
        .cr-body {
            flex-direction: column;
        }

        .cr-sidebar {
            width: 100%;
            flex-direction: row;
            align-items: stretch;
            overflow-x: auto;
        }

        .cr-sidebar-head,
        .cr-sidebar-id {
            display: none !important;
        }

        .cr-sidebar-item {
            width: auto;
            white-space: nowrap;
            border-left: 0;
            border-bottom: 4px solid transparent;
        }

        .cr-sidebar-item.active,
        .cr-sidebar-item.active-edit {
            border-bottom-color: #d7153a;
        }
    }

    @@media (max-width: 640px) {
        .cr-page {
            padding: 12px;
        }

        .cr-sidebar {
            display: flex;
        }

        .cr-topbar {
            align-items: flex-start;
            flex-direction: column;
        }

        .cr-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="cr-page">

    <!-- TOP BAR -->
    <div class="cr-topbar">
        <div class="cr-topbar-left">
            <div class="cr-topbar-icon">
                <svg width="15" height="15" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1h1a1 1 0 0 1 1 1V14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1h1z" />
                    <path d="M9.5 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5h3zm-3-1A1.5 1.5 0 0 0 5 1.5H3.5A1.5 1.5 0 0 0 2 3h12a1.5 1.5 0 0 0-1.5-1.5H11A1.5 1.5 0 0 0 9.5 0z" />
                    <path d="M9.854 7.146a.5.5 0 0 0-.707 0l-3 3a.5.5 0 0 0-.128.21l-.5 1.75a.5.5 0 0 0 .612.612l1.75-.5a.5.5 0 0 0 .21-.128l3-3a.5.5 0 0 0 0-.707L9.854 7.146z" />
                </svg>
            </div>
            <div>
                <div class="cr-topbar-title" id="pageTitle">New Crime Report</div>
                <div class="cr-topbar-sub">Australian Crime Analysis System</div>
            </div>
        </div>
        <div class="cr-topbar-right">
            <div class="cr-pill create" id="modePill">
                <div class="cr-pill-dot"></div>
                <span id="modePillText">Create Mode</span>
            </div>
        </div>
    </div>

    <!-- EDIT STRIP -->
    <div class="cr-edit-strip" id="editStrip">
        <span class="es-label">ID:</span><span class="es-val es-id" id="stripId">—</span>
        <span class="es-label">File #:</span><span class="es-val" id="stripFile">—</span>
        <span class="es-label" style="margin-left:auto; font-family:'Inter',sans-serif; font-size:.69rem;">
            Editing existing record — changes are saved on Update
        </span>
    </div>

    <div class="cr-body">

        <!-- SIDEBAR -->
        <nav class="cr-sidebar">
            <div class="cr-sidebar-head">Navigation</div>
            <button class="cr-sidebar-item active" id="navCase" onclick="scrollSec('secCase')">
                <svg width="12" height="12" fill="currentColor" viewBox="0 0 16 16"><path d="M0 1.5A1.5 1.5 0 0 1 1.5 0h13A1.5 1.5 0 0 1 16 1.5v13a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 0 14.5z" /></svg>
                Case ID
            </button>
            <button class="cr-sidebar-item" id="navLoc" onclick="scrollSec('secLocation')">
                <svg width="12" height="12" fill="currentColor" viewBox="0 0 16 16"><path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10zm0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6z" /></svg>
                Location
            </button>
            <div class="cr-sidebar-divider"></div>
            <a class="cr-sidebar-item" href="@Url.Action("Index", "CrimeData")">
                <svg width="12" height="12" fill="currentColor" viewBox="0 0 16 16"><path d="M0 1.5A1.5 1.5 0 0 1 1.5 0h13A1.5 1.5 0 0 1 16 1.5v2A1.5 1.5 0 0 1 14.5 5h-13A1.5 1.5 0 0 1 0 3.5v-2zM2 2.5a.5.5 0 0 1 .5-.5h3a.5.5 0 0 1 0 1h-3a.5.5 0 0 1-.5-.5zM0 8a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V8z" /></svg>
                All Records
            </a>
            <button class="cr-sidebar-item" id="sideNewBtn" onclick="resetToCreate()" style="display:none;">
                <svg width="12" height="12" fill="currentColor" viewBox="0 0 16 16"><path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z" /></svg>
                New Report
            </button>
            <div class="cr-sidebar-id" id="sidebarId">
                <div style="font-size:.61rem; color:#94a3b8; text-transform:uppercase; letter-spacing:.5px; margin-bottom:2px;">Record ID</div>
                <strong id="sidebarIdVal">—</strong>
            </div>
        </nav>

        <!-- MAIN -->
        <div class="cr-main">

            <!-- Loading state -->
            <div class="cr-loading-state" id="loadingState">
                <div class="cr-load-spin"></div>
                <span>Loading record…</span>
            </div>

            <input type="hidden" id="frmId" value="0" />

            <div class="cr-form-body" id="formBody">

                <!-- SECTION: Case Identification -->
                <div class="cr-section" id="secCase">
                    <div class="cr-section-title">
                        <svg width="9" height="9" fill="currentColor" viewBox="0 0 16 16"><path d="M0 1.5A1.5 1.5 0 0 1 1.5 0h13A1.5 1.5 0 0 1 16 1.5v13a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 0 14.5z" /></svg>
                        Case Identification
                    </div>
                    <div class="cr-grid">
                        <div class="cr-field g-half">
                            <label>File Number <span class="req">*</span></label>
                            <input type="text" id="frmFileNumber" placeholder="e.g. CR-2024-00001" maxlength="50" />
                            <span class="field-err" id="errFileNumber">Required</span>
                        </div>
                        <div class="cr-field g-half">
                            <label>Crime Type <span class="req">*</span></label>
                            <select id="frmCrimeType">
                                <option value="">— Select —</option>
                                @foreach (var ct in Enum.GetValues<CrimeType>())
                                {
                                    <option value="@ct">@ct</option>
                                }
                            </select>
                            <span class="field-err" id="errCrimeType">Required</span>
                        </div>
                        <div class="cr-field g-half">
                            <label>Date of Report</label>
                            <input type="date" id="frmDateOfReport" />
                        </div>
                        <div class="cr-field g-half">
                            <label>Crime Date &amp; Time</label>
                            <input type="datetime-local" id="frmCrimeDateTime" />
                        </div>
                        <div class="cr-field g-full">
                            <label>Raw Date/Time String</label>
                            <input type="text" id="frmCrimeDateTimeRaw" placeholder="Original unparsed value (optional)" maxlength="100" />
                        </div>
                    </div>
                </div>

                <!-- SECTION: Location -->
                <div class="cr-section" id="secLocation">
                    <div class="cr-section-title">
                        <svg width="9" height="9" fill="currentColor" viewBox="0 0 16 16"><path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10zm0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6z" /></svg>
                        Location Details
                    </div>
                    <div class="cr-grid">
                        <div class="cr-field g-full">
                            <label>Street Address / Location</label>
                            <input type="text" id="frmLocation" placeholder="e.g. 42 King Street, Melbourne VIC 3000" maxlength="255" />
                        </div>
                        <div class="cr-field g-half">
                            <label>Neighbourhood / Suburb</label>
                            <input type="text" id="frmNeighborhood" placeholder="e.g. Fitzroy" maxlength="100" />
                        </div>
                        <div class="cr-field g-half">
                            <label>Reporting Area / Beat</label>
                            <input type="text" id="frmReportingArea" placeholder="e.g. AREA-07" maxlength="20" />
                        </div>
                        <div class="cr-field g-half">
                            <label>Latitude</label>
                            <input type="number" id="frmLatitude" step="0.0000001" placeholder="-33.8688197" min="-90" max="90" />
                            <span class="hint">Decimal degrees (−90 to 90)</span>
                        </div>
                        <div class="cr-field g-half">
                            <label>Longitude</label>
                            <input type="number" id="frmLongitude" step="0.0000001" placeholder="151.2092955" min="-180" max="180" />
                            <span class="hint">Decimal degrees (−180 to 180)</span>
                        </div>
                    </div>
                </div>

            </div><!-- /cr-form-body -->
            <!-- FOOTER -->
            <div class="cr-footer">
                <button class="btn-submit mode-create" id="btnSubmit" onclick="saveReport()">
                    <svg width="12" height="12" fill="currentColor" viewBox="0 0 16 16"><path d="M2 1a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H9.5a1 1 0 0 0-1 1v7.293l2.646-2.647a.5.5 0 0 1 .708.708l-3.5 3.5a.5.5 0 0 1-.708 0l-3.5-3.5a.5.5 1 0 1 .708-.708L7.5 9.293V2a2 2 0 0 1 2-2H14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h2.5a.5.5 0 0 1 0 1H2z" /></svg>
                    <span id="btnSubmitText">Create Report</span>
                </button>

                <button class="btn-outline" id="btnReset" onclick="resetToCreate()" style="display:none;">
                    <svg width="11" height="11" fill="currentColor" viewBox="0 0 16 16"><path d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z" /><path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z" /></svg>
                    New Report
                </button>

                <button class="btn-danger-outline" id="btnDelete" onclick="openDeleteModal()" style="display:none;">
                    <svg width="11" height="11" fill="currentColor" viewBox="0 0 16 16"><path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z" /><path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1z" /></svg>
                    Delete
                </button>

                <a href="@Url.Action("Index", "CrimeData")" class="cr-footer-back">
                    <svg width="11" height="11" fill="currentColor" viewBox="0 0 16 16"><path d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z" /></svg>
                    Back to Crime Data
                </a>
            </div>

        </div><!-- /cr-main -->
    </div><!-- /cr-body -->
</div>

<!-- DELETE MODAL -->
<div class="del-overlay" id="delModal">
    <div class="del-modal">
        <div class="del-head">
            <div class="del-head-icon">
                <svg width="15" height="15" fill="white" viewBox="0 0 16 16"><path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z" /><path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1z" /></svg>
            </div>
            <div>
                <h3>Confirm Deletion</h3>
                <p id="delSubtitle">This action cannot be undone.</p>
            </div>
        </div>
        <div class="del-body">
            <div class="del-warn">⚠ This record will be permanently removed from the database.</div>
            <div class="del-record" id="delRecord"></div>
        </div>
        <div class="del-foot">
            <button class="btn-cancel-del" onclick="closeDeleteModal()">Cancel</button>
            <button class="btn-confirm-del" id="btnConfirmDel" onclick="confirmDelete()">
                <svg width="11" height="11" fill="currentColor" viewBox="0 0 16 16"><path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5z" /></svg>
                Delete Report
            </button>
        </div>
    </div>
</div>

<div class="toast-wrap" id="toastWrap"></div>
@Html.AntiForgeryToken()

@section Scripts {
    <script>
        // ======================== FIXED & OPTIMIZED JAVASCRIPT ========================
        // Base URL for API calls – uses built-in Url.Action properly
        const API_BASE = {
            details: (id) => '@Url.Action("Details", "CrimeReport")' + '/' + id,
            create:  '@Url.Action("Create", "CrimeReport")',
            edit:    (id) => '@Url.Action("Edit", "CrimeReport")' + '/' + id,
            delete:  (id) => '@Url.Action("Delete", "CrimeReport")' + '/' + id,
        };

        let isEditMode = false;
        let currentId  = 0;

        // ─── DOM elements ─────────────────────────────────────────────────
        function getEl(id) { return document.getElementById(id); }

        // ─── Loading state ──────────────────────────────────────────────
        function showLoadingState(on) {
            const loading = getEl('loadingState');
            const formBody = getEl('formBody');
            if (loading) loading.classList.toggle('show', on);
            if (formBody) formBody.style.visibility = on ? 'hidden' : '';
        }

        // ─── Mode switching (create/edit) ────────────────────────────────
        function setMode(mode, id = 0, fileNumber = '') {
            isEditMode = mode === 'edit';
            currentId  = id;

            const btn        = getEl('btnSubmit');
            const btnTxt     = getEl('btnSubmitText');
            const btnReset   = getEl('btnReset');
            const btnDel     = getEl('btnDelete');
            const editStrip  = getEl('editStrip');
            const pill       = getEl('modePill');
            const pillTxt    = getEl('modePillText');
            const pageTitle  = getEl('pageTitle');
            const sideId     = getEl('sidebarId');
            const sideIdVal  = getEl('sidebarIdVal');
            const sideNew    = getEl('sideNewBtn');
            const navCase    = getEl('navCase');
            const navLoc     = getEl('navLoc');

            if (!btn || !btnTxt) return;

            if (isEditMode) {
                btn.className            = 'btn-submit mode-edit';
                btnTxt.textContent       = 'Update Report';
                if (btnReset) btnReset.style.display   = '';
                if (btnDel)   btnDel.style.display     = '';
                if (editStrip) editStrip.classList.add('show');
                const stripId = getEl('stripId');
                const stripFile = getEl('stripFile');
                if (stripId) stripId.textContent   = `#${id}`;
                if (stripFile) stripFile.textContent = fileNumber || '—';
                if (pageTitle) pageTitle.textContent = fileNumber ? `Editing: ${fileNumber}` : 'Edit Crime Report';
                if (pill) { pill.className = 'cr-pill edit'; pillTxt.textContent = 'Edit Mode'; }
                if (sideId) sideId.classList.add('show');
                if (sideIdVal) sideIdVal.textContent = `#${id}`;
                if (sideNew) sideNew.style.display = '';
                if (navCase) navCase.className = 'cr-sidebar-item active-edit';
                if (navLoc)  navLoc.className = 'cr-sidebar-item active-edit';
                const frmId = getEl('frmId');
                if (frmId) frmId.value = id;
            } else {
                btn.className            = 'btn-submit mode-create';
                btnTxt.textContent       = 'Create Report';
                if (btnReset) btnReset.style.display   = 'none';
                if (btnDel)   btnDel.style.display     = 'none';
                if (editStrip) editStrip.classList.remove('show');
                if (pageTitle) pageTitle.textContent = 'New Crime Report';
                if (pill) { pill.className = 'cr-pill create'; pillTxt.textContent = 'Create Mode'; }
                if (sideId) sideId.classList.remove('show');
                if (sideNew) sideNew.style.display = 'none';
                if (navCase) navCase.className = 'cr-sidebar-item active';
                if (navLoc)  navLoc.className = 'cr-sidebar-item';
                const frmId = getEl('frmId');
                if (frmId) frmId.value = 0;
            }
        }

        // Reset to create mode (clear form)
        function resetToCreate() {
            setMode('create');
            clearForm();
            clearErrors();
            history.replaceState({}, '', location.pathname);
        }

        // Clear all input fields
        function clearForm() {
            const ids = ['frmFileNumber','frmCrimeType','frmDateOfReport','frmCrimeDateTime',
                         'frmCrimeDateTimeRaw','frmLocation','frmNeighborhood','frmReportingArea',
                         'frmLatitude','frmLongitude'];
            ids.forEach(id => { const el = getEl(id); if (el) el.value = ''; });
        }

        // Populate form with loaded data
        function populateForm(r) {
            setVal('frmFileNumber',       r.fileNumber       ?? '');
            setVal('frmCrimeType',        r.crimeType        ?? '');
            setVal('frmDateOfReport',     r.dateOfReport     ? r.dateOfReport.substring(0, 10)  : '');
            setVal('frmCrimeDateTime',    r.crimeDateTime    ? r.crimeDateTime.substring(0, 16) : '');
            setVal('frmCrimeDateTimeRaw', r.crimeDateTimeRaw ?? '');
            setVal('frmLocation',         r.location         ?? '');
            setVal('frmNeighborhood',     r.neighborhood     ?? '');
            setVal('frmReportingArea',    r.reportingArea    ?? '');
            setVal('frmLatitude',         r.latitude  != null ? r.latitude  : '');
            setVal('frmLongitude',        r.longitude != null ? r.longitude : '');
        }

        function setVal(id, val) { const el = getEl(id); if (el) el.value = val; }
        function getVal(id) { const el = getEl(id); return el ? el.value : ''; }

        // Load existing record for editing
        async function loadForEdit(id) {
            showLoadingState(true);
            try {
                const res = await fetch(API_BASE.details(id), {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                const r = await res.json();
                setMode('edit', r.crimeReportId, r.fileNumber);
                populateForm(r);
            } catch (err) {
                console.error(err);
                showToast('Could not load record — it may not exist in the database.', 'error');
                resetToCreate();
            } finally {
                showLoadingState(false);
            }
        }

        // ─── Save (Create / Update) ─────────────────────────────────────
        async function saveReport() {
            clearErrors();
            const id = parseInt(getVal('frmId')) || 0;

            const payload = {
                crimeReportId:    id,
                fileNumber:       getVal('frmFileNumber').trim(),
                crimeType:        getVal('frmCrimeType'),
                dateOfReport:     getVal('frmDateOfReport')     || null,
                crimeDateTime:    getVal('frmCrimeDateTime')    || null,
                crimeDateTimeRaw: getVal('frmCrimeDateTimeRaw').trim() || null,
                location:         getVal('frmLocation').trim()         || null,
                neighborhood:     getVal('frmNeighborhood').trim()     || null,
                reportingArea:    getVal('frmReportingArea').trim()    || null,
                latitude:  getVal('frmLatitude')  !== '' ? parseFloat(getVal('frmLatitude'))  : null,
                longitude: getVal('frmLongitude') !== '' ? parseFloat(getVal('frmLongitude')) : null,
            };

            // Validation
            let valid = true;
            if (!payload.fileNumber) { showErr('errFileNumber', 'File number is required.'); valid = false; }
            if (!payload.crimeType)  { showErr('errCrimeType',  'Crime type is required.');  valid = false; }
            if (payload.latitude  != null && (payload.latitude  < -90  || payload.latitude  > 90))  { showToast('Latitude must be −90 to 90.',   'error'); valid = false; }
            if (payload.longitude != null && (payload.longitude < -180 || payload.longitude > 180)) { showToast('Longitude must be −180 to 180.', 'error'); valid = false; }
            if (!valid) return;

            const btn  = getEl('btnSubmit');
            btn.disabled = true;
            const orig = btn.innerHTML;
            btn.innerHTML = `<span class="spinner"></span> ${isEditMode ? 'Updating…' : 'Creating…'}`;

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const url   = isEditMode ? API_BASE.edit(id) : API_BASE.create;

            try {
                const res  = await fetch(url, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();

                if (!res.ok) {
                    if (data.errors) {
                        Object.entries(data.errors).forEach(([k, msgs]) => {
                            const errId = 'err' + (k.charAt(0).toUpperCase() + k.slice(1));
                            showErr(errId, Array.isArray(msgs) ? msgs[0] : msgs);
                        });
                    } else {
                        showToast(data.message || 'Save failed.', 'error');
                    }
                } else {
                    showToast(
                        isEditMode
                            ? `Report ${data.fileNumber} updated successfully.`
                            : `Report ${data.fileNumber} created successfully.`,
                        'success'
                    );
                    setMode('edit', data.crimeReportId, data.fileNumber);
                    populateForm(data);
                    // Update URL without full reload
                    const newUrl = `${location.pathname}?id=${data.crimeReportId}&mode=edit`;
                    history.replaceState({}, '', newUrl);
                }
            } catch (err) {
                console.error(err);
                showToast('Network error — please try again.', 'error');
            } finally {
                btn.disabled  = false;
                btn.innerHTML = orig;
            }
        }

        // ─── Delete functionality ───────────────────────────────────────
        function openDeleteModal() {
            const id      = parseInt(getVal('frmId')) || 0;
            const fileNum = getVal('frmFileNumber') || '—';
            const crime   = getVal('frmCrimeType')  || '—';
            const nbr     = getVal('frmNeighborhood') || '—';
            if (!id) return;
            const delSubtitle = getEl('delSubtitle');
            if (delSubtitle) delSubtitle.textContent = `File No. ${fileNum} · Record #${id}`;
            const delRecord = getEl('delRecord');
            if (delRecord) {
                delRecord.innerHTML = `
                    <div class="del-row"><span class="del-key">File Number</span><span class="del-val mono">${escapeHtml(fileNum)}</span></div>
                    <div class="del-row"><span class="del-key">Crime Type</span><span class="del-val">${escapeHtml(crime)}</span></div>
                    <div class="del-row"><span class="del-key">Neighbourhood</span><span class="del-val">${escapeHtml(nbr)}</span></div>`;
            }
            const modal = getEl('delModal');
            if (modal) modal.classList.add('open');
        }

        async function confirmDelete() {
            const id = parseInt(getVal('frmId')) || 0;
            if (!id) return;
            const btn = getEl('btnConfirmDel');
            btn.disabled = true;
            btn.innerHTML = `<span class="spinner"></span> Deleting…`;
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            try {
                const res = await fetch(API_BASE.delete(id), {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token }
                });
                if (res.ok) {
                    showToast('Crime report deleted.', 'success');
                    closeDeleteModal();
                    resetToCreate();
                } else {
                    const data = await res.json();
                    showToast(data.message || 'Failed to delete.', 'error');
                }
            } catch {
                showToast('Network error.', 'error');
            } finally {
                btn.disabled = false;
                btn.innerHTML = `<svg width="11" height="11" fill="currentColor" viewBox="0 0 16 16"><path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5z"/></svg> Delete Report`;
            }
        }

        function closeDeleteModal() {
            const modal = getEl('delModal');
            if (modal) modal.classList.remove('open');
        }

        // ─── Sidebar scrolling ──────────────────────────────────────────
        function scrollSec(id) {
            const el = document.getElementById(id);
            if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        // ─── Validation UI ──────────────────────────────────────────────
        function showErr(id, msg) {
            const el = getEl(id);
            if (!el) return;
            el.textContent = msg;
            el.classList.add('show');
            const input = el.previousElementSibling;
            if (input && (input.tagName === 'INPUT' || input.tagName === 'SELECT')) {
                input.classList.add('has-err');
            }
        }

        function clearErrors() {
            document.querySelectorAll('.field-err').forEach(el => {
                el.classList.remove('show');
                const input = el.previousElementSibling;
                if (input && (input.tagName === 'INPUT' || input.tagName === 'SELECT')) {
                    input.classList.remove('has-err');
                }
            });
        }

        // ─── Toast notifications ────────────────────────────────────────
        function showToast(msg, type = 'success') {
            const wrap = getEl('toastWrap');
            if (!wrap) return;
            const t = document.createElement('div');
            t.className = `toast ${type}`;
            t.innerHTML = `<span>${type === 'success' ? '✓' : type === 'error' ? '✕' : '⚠'}</span> ${escapeHtml(msg)}`;
            wrap.appendChild(t);
            setTimeout(() => t.remove(), 3200);
        }

        // ─── Helpers ────────────────────────────────────────────────────
        function escapeHtml(s) {
            if (!s) return '';
            return String(s).replace(/[&<>]/g, function(m) {
                if (m === '&') return '&amp;';
                if (m === '<') return '&lt;';
                if (m === '>') return '&gt;';
                return m;
            });
        }

        // ─── Bootstrap on page load ─────────────────────────────────────
        document.addEventListener('DOMContentLoaded', () => {
            const params = new URLSearchParams(location.search);
            const id   = parseInt(params.get('id')) || 0;
            const mode = params.get('mode') || '';

            if (id > 0 && mode === 'edit') {
                loadForEdit(id);
            }

            // Close delete modal on ESC
            document.addEventListener('keydown', e => {
                if (e.key === 'Escape') closeDeleteModal();
            });
        });
    </script>
}
