@using Domain_Layer.DbModels.Enum
@{
    ViewData["Title"] = "Crime Reports";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Syne:wght@600;700;800&family=Lato:wght@400;500;600;700&display=swap" rel="stylesheet" />

<style>
 
    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        font-family: 'Lato', sans-serif;
        background: var(--surface);
        color: var(--ink);
    }

        background: var(--ink);
        border-bottom: 3px solid var(--gold);
        padding: 1.25rem 2rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 1.5rem;
        border-radius: var(--r-lg);
    }

    .pg-head-left {
        display: flex;
        align-items: center;
        gap: .9rem;
    }

    .pg-shield {
        width: 44px;
        height: 44px;
        background: var(--gold);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--ink);
        flex-shrink: 0;
    }

    .pg-head h1 {
        font-family: 'Syne', sans-serif;
        font-weight: 800;
        font-size: 1.3rem;
        color: #fff;
        letter-spacing: .2px;
        line-height: 1.1;
    }

    .pg-head .sub {
        font-size: .73rem;
        color: #8fa3bb;
        font-weight: 500;
        letter-spacing: .5px;
        text-transform: uppercase;
        margin-top: .15rem;
    }

    .btn-new {
        background: var(--gold);
        color: var(--ink);
        border: none;
        border-radius: var(--r);
        padding: .55rem 1.2rem;
        font-family: 'Syne', sans-serif;
        font-size: .85rem;
        font-weight: 700;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        transition: background var(--transit), transform var(--transit);
    }

        .btn-new:hover {
            background: #b8952e;
            transform: translateY(-1px);
        }

    /* ═══════════════════════════════════════════════
       STAT STRIP
    ═══════════════════════════════════════════════ */
    .stat-strip {
        display: flex;
        gap: .75rem;
        margin-bottom: 1.25rem;
        flex-wrap: wrap;
    }

    .stat-chip {
        background: var(--white);
        border: 1px solid var(--line);
        border-radius: var(--r);
        padding: .7rem 1rem;
        display: flex;
        align-items: center;
        gap: .6rem;
        box-shadow: var(--sh);
        flex: 1;
        min-width: 130px;
    }

        .stat-chip .dot {
            width: 36px;
            height: 36px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            flex-shrink: 0;
        }

        .stat-chip .num {
            font-family: 'Syne', sans-serif;
            font-size: 1.4rem;
            font-weight: 800;
            color: var(--ink);
            line-height: 1;
        }

        .stat-chip .lbl {
            font-size: .68rem;
            font-weight: 700;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: .5px;
            margin-top: .1rem;
        }

    /* ═══════════════════════════════════════════════
       FILTER BAR
    ═══════════════════════════════════════════════ */
    .filter-bar {
        background: var(--white);
        border: 1px solid var(--line);
        border-radius: var(--r-lg);
        padding: .9rem 1.1rem;
        margin-bottom: 1.1rem;
        box-shadow: var(--sh);
        display: flex;
        gap: .65rem;
        flex-wrap: wrap;
        align-items: flex-end;
    }

    .fg {
        display: flex;
        flex-direction: column;
        gap: .2rem;
    }

        .fg label {
            font-size: .68rem;
            font-weight: 700;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: .5px;
        }

        .fg input, .fg select {
            border: 1.5px solid var(--line);
            border-radius: var(--r);
            padding: .42rem .7rem;
            font-size: .86rem;
            color: var(--ink);
            background: var(--white);
            font-family: 'Lato', sans-serif;
            transition: border-color var(--transit), box-shadow var(--transit);
        }

            .fg input:focus, .fg select:focus {
                outline: none;
                border-color: var(--blue);
                box-shadow: 0 0 0 3px rgba(18,70,160,.1);
            }

        .fg.search {
            flex: 1;
            min-width: 200px;
        }

            .fg.search input {
                width: 100%;
            }

    .filter-actions {
        display: flex;
        gap: .4rem;
        align-self: flex-end;
    }

    .btn-filter {
        background: var(--blue);
        color: #fff;
        border: none;
        border-radius: var(--r);
        padding: .44rem .95rem;
        font-size: .84rem;
        font-weight: 700;
        cursor: pointer;
        font-family: 'Lato', sans-serif;
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        transition: background var(--transit);
    }

        .btn-filter:hover {
            background: #0d3580;
        }

    .btn-clear {
        background: var(--surface);
        color: var(--ink-3);
        border: 1px solid var(--line);
        border-radius: var(--r);
        padding: .42rem .8rem;
        font-size: .84rem;
        font-weight: 600;
        cursor: pointer;
        font-family: 'Lato', sans-serif;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        transition: background var(--transit);
    }

        .btn-clear:hover {
            background: var(--line);
            color: var(--ink);
        }

    /* ═══════════════════════════════════════════════
       TABLE CARD
    ═══════════════════════════════════════════════ */
    .tbl-card {
        background: var(--white);
        border: 1px solid var(--line);
        border-radius: var(--r-lg);
        box-shadow: var(--sh);
        overflow: hidden;
    }

    .tbl-toolbar {
        padding: .7rem 1.1rem;
        border-bottom: 1px solid var(--line);
        background: #f9fafc;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .75rem;
        flex-wrap: wrap;
    }

    .tbl-info {
        font-size: .78rem;
        color: var(--muted);
        font-weight: 600;
    }

    .bulk-actions {
        display: none;
        gap: .4rem;
        align-items: center;
        animation: fadeIn .15s;
    }

        .bulk-actions.show {
            display: flex;
        }

    .btn-bulk-del {
        background: var(--red);
        color: #fff;
        border: none;
        border-radius: var(--r);
        padding: .33rem .75rem;
        font-size: .78rem;
        font-weight: 700;
        cursor: pointer;
        font-family: 'Lato', sans-serif;
        display: inline-flex;
        align-items: center;
        gap: .3rem;
    }

    .per-page-wrap {
        display: flex;
        align-items: center;
        gap: .4rem;
    }

        .per-page-wrap label {
            font-size: .72rem;
            color: var(--muted);
            font-weight: 600;
        }

        .per-page-wrap select {
            border: 1px solid var(--line);
            border-radius: var(--r);
            padding: .28rem .5rem;
            font-size: .8rem;
            color: var(--ink);
        }

    .tbl {
        width: 100%;
        border-collapse: collapse;
        font-size: .86rem;
    }

        .tbl thead th {
            background: var(--ink);
            color: #fff;
            padding: .68rem .9rem;
            text-align: left;
            font-size: .68rem;
            font-family: 'Syne', sans-serif;
            font-weight: 700;
            letter-spacing: .8px;
            text-transform: uppercase;
            white-space: nowrap;
        }

            .tbl thead th a {
                color: #fff;
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                gap: .25rem;
            }

                .tbl thead th a:hover {
                    color: var(--gold);
                }

            .tbl thead th.chk {
                width: 38px;
            }

        .tbl tbody tr {
            border-bottom: 1px solid var(--line);
            transition: background var(--transit);
            cursor: pointer;
        }

            .tbl tbody tr:hover {
                background: var(--blue-lt);
            }

            .tbl tbody tr:last-child {
                border-bottom: none;
            }

        .tbl td {
            padding: .6rem .9rem;
            color: var(--ink-2);
            vertical-align: middle;
        }

            .tbl td.mono {
                font-family: 'DM Mono', monospace;
                font-size: .8rem;
                color: var(--blue);
                font-weight: 500;
                letter-spacing: .3px;
            }

            .tbl td.actions {
                white-space: nowrap;
            }

    .cb {
        width: 15px;
        height: 15px;
        cursor: pointer;
        accent-color: var(--blue);
    }

    /* Crime type pills */
    .pill {
        display: inline-block;
        padding: .18rem .5rem;
        border-radius: 20px;
        font-size: .68rem;
        font-weight: 700;
        letter-spacing: .3px;
        text-transform: uppercase;
        font-family: 'Syne', sans-serif;
    }

    .pill-Assault {
        background: #fdecea;
        color: #c0392b;
    }

    .pill-Theft {
        background: #fff3e0;
        color: #c97020;
    }

    .pill-Burglary {
        background: #fce4ec;
        color: #880e4f;
    }

    .pill-Fraud {
        background: var(--green-lt);
        color: var(--green);
    }

    .pill-DrugOffense {
        background: var(--blue-lt);
        color: var(--blue);
    }

    .pill-Vandalism {
        background: #f3e5f5;
        color: #6a1b9a;
    }

    .pill-Murder {
        background: #c0392b;
        color: #fff;
    }

    .pill-Robbery {
        background: #ffebee;
        color: #b71c1c;
    }

    .pill-SexualOffense {
        background: #fce4ec;
        color: #ad1457;
    }

    .pill-default {
        background: #eceff1;
        color: #37474f;
    }

    /* Row action buttons */
    .act-btn {
        background: none;
        border: 1px solid var(--line);
        border-radius: var(--r);
        width: 30px;
        height: 30px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        color: var(--ink-3);
        transition: all var(--transit);
        margin-left: 3px;
    }

        .act-btn:hover.view {
            background: var(--blue-lt);
            border-color: var(--blue);
            color: var(--blue);
        }

        .act-btn:hover.edit {
            background: var(--amber-lt);
            border-color: var(--amber);
            color: var(--amber);
        }

        .act-btn:hover.del {
            background: var(--red-lt);
            border-color: var(--red);
            color: var(--red);
        }

    /* Empty state */
    .empty-state {
        text-align: center;
        padding: 4rem 1rem;
        color: var(--muted);
    }

        .empty-state .empty-icon {
            font-size: 2.5rem;
            margin-bottom: .75rem;
            opacity: .4;
        }

        .empty-state h3 {
            font-family: 'Syne', sans-serif;
            font-size: 1.05rem;
            color: var(--ink-2);
            margin-bottom: .3rem;
        }

        .empty-state p {
            font-size: .86rem;
        }

    /* Pagination */
    .pager {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: .7rem 1.1rem;
        border-top: 1px solid var(--line);
        background: #f9fafc;
        gap: .5rem;
        flex-wrap: wrap;
    }

        .pager .pg-info {
            font-size: .78rem;
            color: var(--muted);
            font-weight: 600;
        }

        .pager .pg-links {
            display: flex;
            gap: .25rem;
        }

    .pg-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 30px;
        height: 30px;
        border-radius: var(--r);
        font-size: .8rem;
        font-weight: 700;
        text-decoration: none;
        border: 1px solid var(--line);
        color: var(--ink);
        background: var(--white);
        transition: all var(--transit);
        cursor: pointer;
    }

        .pg-btn:hover {
            background: var(--blue);
            color: #fff;
            border-color: var(--blue);
        }

        .pg-btn.active {
            background: var(--blue);
            color: #fff;
            border-color: var(--blue);
        }

        .pg-btn.disabled {
            color: #ccc;
            pointer-events: none;
        }

    /* ═══════════════════════════════════════════════
       SLIDE DRAWER (Create / Edit / View)
    ═══════════════════════════════════════════════ */
    .drawer-overlay {
        position: fixed;
        inset: 0;
        background: rgba(11,22,36,.45);
        z-index: 900;
        opacity: 0;
        visibility: hidden;
        transition: opacity .25s, visibility .25s;
        backdrop-filter: blur(2px);
    }

        .drawer-overlay.open {
            opacity: 1;
            visibility: visible;
        }

    .drawer {
        position: fixed;
        top: 0;
        right: 0;
        bottom: 0;
        width: min(560px, 100vw);
        background: var(--white);
        z-index: 901;
        transform: translateX(100%);
        transition: transform .28s cubic-bezier(.4,0,.2,1);
        display: flex;
        flex-direction: column;
        box-shadow: var(--sh-lg);
    }

        .drawer.open {
            transform: translateX(0);
        }

    .drawer-head {
        background: var(--ink);
        border-bottom: 3px solid var(--gold);
        padding: 1.1rem 1.4rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-shrink: 0;
    }

        .drawer-head h2 {
            font-family: 'Syne', sans-serif;
            font-size: 1rem;
            font-weight: 800;
            color: #fff;
            letter-spacing: .3px;
            display: flex;
            align-items: center;
            gap: .5rem;
        }

    .drawer-close {
        background: rgba(255,255,255,.1);
        border: 1px solid rgba(255,255,255,.2);
        border-radius: var(--r);
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        color: #fff;
        transition: background var(--transit);
    }

        .drawer-close:hover {
            background: rgba(255,255,255,.25);
        }

    .drawer-body {
        flex: 1;
        overflow-y: auto;
        padding: 1.3rem 1.4rem;
    }

    .drawer-foot {
        border-top: 1px solid var(--line);
        padding: .85rem 1.4rem;
        background: #f9fafc;
        display: flex;
        gap: .5rem;
        flex-shrink: 0;
    }

    /* Drawer sections */
    .drw-section {
        margin-bottom: 1.1rem;
    }

    .drw-section-title {
        font-size: .67rem;
        font-weight: 700;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: .8px;
        border-bottom: 1px solid var(--line);
        padding-bottom: .4rem;
        margin-bottom: .85rem;
        display: flex;
        align-items: center;
        gap: .35rem;
    }

    .drw-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: .8rem 1rem;
    }

        .drw-grid .full {
            grid-column: 1 / -1;
        }

    .fg-drw {
        display: flex;
        flex-direction: column;
        gap: .25rem;
    }

        .fg-drw label {
            font-size: .69rem;
            font-weight: 700;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: .5px;
        }

            .fg-drw label .req {
                color: var(--red);
            }

        .fg-drw input, .fg-drw select, .fg-drw textarea {
            border: 1.5px solid var(--line);
            border-radius: var(--r);
            padding: .46rem .75rem;
            font-size: .875rem;
            color: var(--ink);
            background: var(--white);
            font-family: 'Lato', sans-serif;
            transition: border-color var(--transit), box-shadow var(--transit);
            width: 100%;
        }

            .fg-drw input:focus, .fg-drw select:focus, .fg-drw textarea:focus {
                outline: none;
                border-color: var(--blue);
                box-shadow: 0 0 0 3px rgba(18,70,160,.1);
            }

            .fg-drw input.err, .fg-drw select.err {
                border-color: var(--red);
            }

        .fg-drw .field-err {
            font-size: .72rem;
            color: var(--red);
            font-weight: 600;
            margin-top: .1rem;
            display: none;
        }

            .fg-drw .field-err.show {
                display: block;
            }

        .fg-drw .hint {
            font-size: .69rem;
            color: var(--muted);
            margin-top: .15rem;
        }

    /* Drawer buttons */
    .btn-save {
        background: var(--blue);
        color: #fff;
        border: none;
        border-radius: var(--r);
        padding: .52rem 1.3rem;
        font-size: .875rem;
        font-weight: 700;
        cursor: pointer;
        font-family: 'Syne', sans-serif;
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        transition: background var(--transit), transform var(--transit);
    }

        .btn-save:hover {
            background: #0d3580;
            transform: translateY(-1px);
        }

        .btn-save:disabled {
            opacity: .6;
            cursor: not-allowed;
            transform: none;
        }

    .btn-cancel-drw {
        background: none;
        color: var(--ink-3);
        border: 1px solid var(--line);
        border-radius: var(--r);
        padding: .5rem 1rem;
        font-size: .875rem;
        font-weight: 600;
        cursor: pointer;
        font-family: 'Lato', sans-serif;
        display: inline-flex;
        align-items: center;
        transition: background var(--transit);
    }

        .btn-cancel-drw:hover {
            background: var(--surface);
        }

    /* View-mode detail rows */
    .detail-dl {
        display: grid;
        grid-template-columns: 130px 1fr;
        row-gap: 0;
    }

    .detail-dt {
        font-size: .69rem;
        font-weight: 700;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: .5px;
        padding: .52rem 0;
        border-bottom: 1px solid #f0f3f8;
    }

    .detail-dd {
        font-size: .875rem;
        color: var(--ink);
        font-weight: 500;
        padding: .52rem 0 .52rem .75rem;
        border-bottom: 1px solid #f0f3f8;
    }

        .detail-dd.mono {
            font-family: 'DM Mono', monospace;
            font-size: .82rem;
            color: var(--blue);
            font-weight: 500;
        }

        .detail-dd.empty {
            color: #bbb;
            font-style: italic;
        }

    /* ═══════════════════════════════════════════════
       DELETE MODAL
    ═══════════════════════════════════════════════ */
    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(11,22,36,.55);
        z-index: 950;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
        opacity: 0;
        visibility: hidden;
        transition: opacity .2s, visibility .2s;
    }

        .modal-overlay.open {
            opacity: 1;
            visibility: visible;
        }

    .modal {
        background: var(--white);
        border-radius: var(--r-lg);
        box-shadow: var(--sh-lg);
        width: min(440px, 100%);
        overflow: hidden;
        transform: scale(.95) translateY(8px);
        transition: transform .2s;
    }

    .modal-overlay.open .modal {
        transform: scale(1) translateY(0);
    }

    .modal-head {
        background: linear-gradient(135deg,#7b1e18,#a93226);
        border-bottom: 3px solid var(--gold);
        padding: 1rem 1.3rem;
        display: flex;
        align-items: center;
        gap: .75rem;
    }

        .modal-head .del-icon {
            background: rgba(255,255,255,.15);
            border-radius: 50%;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            flex-shrink: 0;
        }

        .modal-head h3 {
            font-family: 'Syne', sans-serif;
            font-size: 1rem;
            font-weight: 800;
            color: #fff;
            margin-bottom: .15rem;
        }

        .modal-head p {
            font-size: .75rem;
            color: #f5b7b1;
        }

    .modal-body {
        padding: 1.1rem 1.3rem;
    }

    .modal-warn {
        background: var(--red-lt);
        border-left: 4px solid var(--red);
        border-radius: var(--r);
        padding: .7rem .9rem;
        font-size: .84rem;
        color: #7b1e18;
        margin-bottom: .9rem;
    }

    .modal-record {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--r);
        padding: .75rem .9rem;
        font-size: .84rem;
    }

        .modal-record .mr-row {
            display: flex;
            justify-content: space-between;
            border-bottom: 1px solid var(--line);
            padding: .35rem 0;
        }

            .modal-record .mr-row:last-child {
                border-bottom: none;
            }

        .modal-record .mr-key {
            font-size: .7rem;
            font-weight: 700;
            color: var(--muted);
            text-transform: uppercase;
        }

        .modal-record .mr-val {
            font-size: .82rem;
            font-weight: 600;
            color: var(--ink);
        }

            .modal-record .mr-val.mono {
                font-family: 'DM Mono', monospace;
                color: var(--blue);
            }

    .modal-foot {
        padding: .85rem 1.3rem;
        border-top: 1px solid var(--line);
        display: flex;
        gap: .5rem;
        justify-content: flex-end;
    }

    .btn-confirm-del {
        background: var(--red);
        color: #fff;
        border: none;
        border-radius: var(--r);
        padding: .5rem 1.1rem;
        font-size: .86rem;
        font-weight: 700;
        cursor: pointer;
        font-family: 'Syne', sans-serif;
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        transition: background var(--transit);
    }

        .btn-confirm-del:hover {
            background: #a93226;
        }

        .btn-confirm-del:disabled {
            opacity: .6;
            cursor: not-allowed;
        }

    /* ═══════════════════════════════════════════════
       TOAST
    ═══════════════════════════════════════════════ */
    .toast-wrap {
        position: fixed;
        bottom: 1.5rem;
        right: 1.5rem;
        z-index: 9999;
        display: flex;
        flex-direction: column;
        gap: .5rem;
        pointer-events: none;
    }

    .toast {
        background: var(--ink);
        color: #fff;
        border-radius: var(--r);
        padding: .7rem 1rem;
        font-size: .84rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: .5rem;
        box-shadow: var(--sh-lg);
        min-width: 240px;
        animation: toastIn .25s ease, toastOut .3s ease 2.7s forwards;
        pointer-events: auto;
    }

        .toast.success {
            border-left: 4px solid var(--green);
        }

        .toast.error {
            border-left: 4px solid var(--red);
        }

    @@keyframes toastIn {
        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes toastOut {
        from {
            opacity: 1;
        }

        to {
            opacity: 0;
            transform: translateY(-8px);
        }
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    /* Loading spinner inside button */
    .spinner {
        display: inline-block;
        width: 14px;
        height: 14px;
        border: 2px solid rgba(255,255,255,.35);
        border-top-color: #fff;
        border-radius: 50%;
        animation: spin .6s linear infinite;
        flex-shrink: 0;
    }

    @@keyframes spin {
        to {
