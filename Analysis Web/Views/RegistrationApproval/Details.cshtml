@model Core_Layer.ViewModels.RegistrationApprovalDetailsDto
@using Domain_Layer.DbModels.Enum
@{
    ViewData["Title"] = "Review Registration";
    string GenderLabel(int? value) => value switch { 1 => "Male", 2 => "Female", 3 => "Non-binary", 4 => "Prefer not to say", _ => "Not provided" };
}

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["Warning"] is string warning)
{
    <div class="alert alert-warning">@warning</div>
}

<div class="row">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header card-header-primary">
                <h4 class="card-title">@Model.FullName</h4>
                <p class="card-category">Submitted @Model.RequestedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</p>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Email</dt><dd class="col-sm-8">@Model.Email</dd>
                    <dt class="col-sm-4">Phone</dt><dd class="col-sm-8">@Model.Contact</dd>
                    <dt class="col-sm-4">Date of birth</dt><dd class="col-sm-8">@Model.DateOfBirth?.ToString("yyyy-MM-dd")</dd>
                    <dt class="col-sm-4">Gender</dt><dd class="col-sm-8">@GenderLabel(Model.Gender)</dd>
                    <dt class="col-sm-4">Department</dt><dd class="col-sm-8">@(Model.Department ?? "Not provided")</dd>
                    <dt class="col-sm-4">Address</dt>
                    <dd class="col-sm-8">@Model.Address, @Model.City, @Model.State @Model.PostalCode, @Model.Country</dd>
                    <dt class="col-sm-4">Status</dt><dd class="col-sm-8"><strong>@Model.ApprovalStatus</strong></dd>
                    @if (Model.ReviewedAtUtc.HasValue)
                    {
                        <dt class="col-sm-4">Reviewed</dt><dd class="col-sm-8">@Model.ReviewedAtUtc.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</dd>
                        <dt class="col-sm-4">Reviewer notes</dt><dd class="col-sm-8">@(Model.ReviewNotes ?? "None")</dd>
                    }
                </dl>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card">
            <div class="card-header card-header-info">
                <h4 class="card-title">Identity evidence</h4>
                <p class="card-category">Private files; visible only to Admin and SuperAdmin.</p>
            </div>
            <div class="card-body">
                @if (Model.HasProfilePhoto)
                {
                    <h6>Profile photo</h6>
                    <img class="img-fluid rounded border mb-3"
                         src="@Url.Action("Evidence", new { id = Model.UserAccountId, kind = "photo" })"
                         alt="Applicant profile photo" />
                }
                else
                {
                    <div class="alert alert-danger">Profile photo is missing.</div>
                }

                @if (Model.HasIdentityDocument)
                {
                    <a class="btn btn-outline-info btn-block"
                       target="_blank"
                       rel="noopener"
                       asp-action="Evidence"
                       asp-route-id="@Model.UserAccountId"
                       asp-route-kind="identity">Open @Model.IdentityDocumentName</a>
                }
                else
                {
                    <div class="alert alert-danger">Identity document is missing.</div>
                }
            </div>
        </div>
    </div>
</div>

@if (Model.ApprovalStatus == AccountApprovalStatus.Pending)
{
    <div class="card">
        <div class="card-header">
            <h4 class="card-title">Decision</h4>
        </div>
        <div class="card-body">
            <label for="reviewNotes">Reviewer notes</label>
            <textarea id="reviewNotes" class="form-control" rows="3" maxlength="1000"
                      placeholder="Optional for approval; recommended when rejecting."></textarea>
            <div class="mt-3 d-flex">
                <form asp-action="Approve" method="post" class="mr-2" onsubmit="copyReviewNotes(this)">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.UserAccountId" />
                    <input type="hidden" name="reviewNotes" />
                    <button class="btn btn-success" type="submit"
                            onclick="return confirm('Approve this account and allow sign-in?')">Approve account</button>
                </form>
                <form asp-action="Reject" method="post" onsubmit="copyReviewNotes(this)">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.UserAccountId" />
                    <input type="hidden" name="reviewNotes" />
                    <button class="btn btn-danger" type="submit"
                            onclick="return confirm('Reject this registration?')">Reject registration</button>
                </form>
            </div>
        </div>
    </div>
}

<a class="btn btn-outline-secondary" asp-action="Index">Back to registration requests</a>

@section Scripts {
    <script>
        function copyReviewNotes(form) {
            form.querySelector('input[name="reviewNotes"]').value =
                document.getElementById('reviewNotes').value;
        }
    </script>
}
