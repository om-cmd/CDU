@model Core_Layer.ViewModels.ForgotPasswordRequestDto
@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Forgot Password - Crime Analysis</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body { min-height:100vh; display:flex; align-items:center; justify-content:center; background:linear-gradient(120deg,rgba(15,23,42,.86),rgba(30,64,175,.5)),url('/assets/img/city.jpg') center/cover no-repeat; font-family:Segoe UI,Arial,sans-serif; padding:1rem; }
        .auth-card { width:100%; max-width:430px; background:rgba(255,255,255,.97); border-radius:14px; padding:2rem; box-shadow:0 24px 80px rgba(0,0,0,.32); }
        .btn-brand { width:100%; border:0; border-radius:8px; background:#1f6feb; color:#fff; font-weight:700; padding:.75rem; }
    </style>
</head>
<body>
    <div class="auth-card">
        <h1 class="h4 fw-bold text-center">Forgot password</h1>
        <p class="text-muted text-center small">Enter your account email. We will send a 6-digit OTP valid for 3 minutes.</p>
        @if (ViewBag.Error is string error) { <div class="alert alert-danger py-2">@error</div> }
        <form asp-action="ForgotPassword" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email address</label>
                <input asp-for="Email" class="form-control" placeholder="you@example.com" autofocus />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <button class="btn-brand" type="submit">Send OTP</button>
        </form>
        <p class="text-center small mt-3 mb-0"><a asp-action="Login">Back to login</a></p>
    </div>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
