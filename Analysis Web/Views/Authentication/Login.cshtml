@model Core_Layer.ViewModels.LoginDto

@{
    ViewData["Title"] = "SignIn";
    Layout = null;

    string? error = ViewBag.Error;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — CDU</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <style>
        :root {
            --brand: #012169;
            --brand-dark: #001443;
            --brand-gold: #ffcd00;
            --ink: #111827;
        }

        body {
            min-height: 100vh;
            background:
                linear-gradient(120deg, rgba(0, 13, 38, .86), rgba(1, 33, 105, .45)),
                url('/assets/img/crime-future-login.png') center/cover no-repeat;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', system-ui, sans-serif;
            padding: 1rem;
        }

        .auth-card {
            width: 100%;
            max-width: 430px;
            background: rgba(255,255,255,.96);
            border: 1px solid rgba(255,255,255,.65);
            border-radius: 14px;
            box-shadow: 0 24px 80px rgba(0,0,0,.34);
            padding: 2.5rem 2.25rem;
            backdrop-filter: blur(10px);
        }

        .auth-logo {
            text-align: center;
            margin-bottom: 1.25rem;
        }

        .auth-logo img {
            width: 68px;
            height: auto;
            display: inline-block;
            filter: drop-shadow(0 8px 18px rgba(31,111,235,.22));
        }

        .auth-title {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--ink);
            text-align: center;
        }

        .auth-sub {
            color: #6b7280;
            font-size: .875rem;
            text-align: center;
            margin-bottom: 1.75rem;
        }

        .form-label {
            font-weight: 500;
            font-size: .875rem;
            color: #374151;
        }

        .form-control {
            border-radius: 8px;
            border-color: #d1d5db;
            padding: .625rem .875rem;
            font-size: .9375rem;
        }

        .form-control:focus {
            border-color: var(--brand);
            box-shadow: 0 0 0 3px rgba(37,99,235,.15);
        }

        .input-group .form-control {
            border-right: none;
        }

        .input-group .btn-outline-secondary {
            border-color: #d1d5db;
            border-left: none;
            border-radius: 0 8px 8px 0;
            color: #6b7280;
        }

        .btn-brand {
            background: var(--brand);
            color: #fff;
            border: none;
            border-radius: 8px;
            padding: .75rem;
            font-weight: 600;
            font-size: .9375rem;
            width: 100%;
            box-shadow: 0 10px 24px rgba(31,111,235,.24);
        }

        .btn-brand:hover {
            background: var(--brand-dark);
            color: #fff;
        }

        .divider {
            border-top: 1px solid #e5e7eb;
            margin: 1.5rem 0;
        }

        .alert-danger {
            border-radius: 8px;
            font-size: .875rem;
        }
    </style>
</head>

<body>
    <div class="auth-card">
        <div class="auth-logo">
            <img src="~/favicon.png" alt="Logo" />
        </div>

        <h1 class="auth-title">Welcome back</h1>
        <p class="auth-sub">Sign in to your Analysis account</p>

        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success py-2">@success</div>
        }

        @if (TempData["Info"] is string info)
        {
            <div class="alert alert-info py-2">@info</div>
        }

        @if (!string.IsNullOrEmpty(error))
        {
            <div class="alert alert-danger py-2">@error</div>
        }

        <form asp-action="Login" asp-controller="Authentication" method="post">
            <input type="hidden" name="ReturnUrl" value="@ViewData["ReturnUrl"]" />

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger py-2"
                 style="display:@(ViewData.ModelState.IsValid ? "none" : "block")">
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email address</label>
                <input asp-for="Email"
                       class="form-control"
                       placeholder="you@example.com"
                       autocomplete="email"
                       autofocus />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">Password</label>

                <div class="input-group">
                    <input asp-for="Password"
                           type="password"
                           class="form-control"
                           placeholder="••••••••"
                           autocomplete="current-password"
                           id="pwdField" />

                    <button type="button"
                            class="btn btn-outline-secondary"
                            onclick="togglePwd('pwdField', this)"
                            tabindex="-1">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>

                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="form-check">
                    <input asp-for="RememberMe" class="form-check-input" type="checkbox" />
                    <label asp-for="RememberMe" class="form-check-label small text-muted">
                        Remember me
                    </label>
                </div>

                <a asp-action="ForgotPassword" asp-controller="Authentication" class="small text-primary text-decoration-none">
                    Forgot password?
                </a>
            </div>

            <button type="submit" class="btn-brand mb-3">
                <i class="bi bi-box-arrow-in-right me-2"></i>
                Sign In
            </button>
        </form>

        <div class="divider"></div>

        <p class="text-center mb-0 small text-muted">
            Don't have an account?
            <a asp-action="Register"
               asp-controller="Authentication"
               class="text-primary fw-semibold text-decoration-none">
                Create one
            </a>
        </p>
    </div>

    <script>
        function togglePwd(fieldId, btn) {
            const f = document.getElementById(fieldId);
            const icon = btn.querySelector('i');

            if (f.type === 'password') {
                f.type = 'text';
                icon.className = 'bi bi-eye-slash';
            } else {
                f.type = 'password';
                icon.className = 'bi bi-eye';
            }
        }
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <partial name="_ValidationScriptsPartial" />
</body>
</html>
