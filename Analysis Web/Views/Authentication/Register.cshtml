@model Core_Layer.ViewModels.RegisterDto
@{
    ViewData["Title"] = "Create Account";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — CDU</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
    body {
        min-height: 100vh;
        background: linear-gradient(135deg, #f0f4ff 0%, #e8edfb 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: 'Segoe UI', system-ui, sans-serif;
        padding: 2rem 1rem;
        margin: 0;
    }

    .auth-card {
        width: 100%;
        max-width: 480px;
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 8px 40px rgba(37, 99, 235, 0.12);
        padding: 2.5rem 2.25rem;
    }

    .auth-logo {
        width: 48px;
        height: 48px;
        background: #2563eb;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.25rem;
    }

    .auth-logo i {
        color: #fff;
        font-size: 1.5rem;
    }

    .auth-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: #111;
        text-align: center;
    }

    .auth-sub {
        color: #6b7280;
        font-size: .875rem;
        text-align: center;
        margin-bottom: 1.75rem;
    }

    .form-label {
        font-weight: 500;
        font-size: .875rem;
        color: #374151;
    }

    .form-control {
        border-radius: 8px;
        border: 1px solid #d1d5db;
        padding: .625rem .875rem;
        font-size: .9375rem;
        transition: border-color .2s, box-shadow .2s;
    }

    .form-control:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, .15);
        outline: none;
    }

    .input-group .form-control {
        border-right: none;
    }

    .input-group .btn-outline-secondary {
        border-color: #d1d5db;
        border-left: none;
        border-radius: 0 8px 8px 0;
        color: #6b7280;
    }

    .btn-brand {
        background: #2563eb;
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: .75rem;
        font-weight: 600;
        font-size: .9375rem;
        width: 100%;
        transition: background .2s;
    }

    .btn-brand:hover {
        background: #1d4ed8;
        color: #fff;
    }

    .divider {
        border-top: 1px solid #e5e7eb;
        margin: 1.5rem 0;
    }

    .password-strength {
        height: 4px;
        border-radius: 2px;
        transition: all .3s;
        margin-top: 6px;
    }

    .badge-info {
        background: #eff6ff;
        color: #2563eb;
        border-radius: 6px;
        padding: .25rem .625rem;
        font-size: .75rem;
    }
</style>
</head>
<body>
    <div class="auth-card">
        <div class="auth-logo"><i class="bi bi-person-plus-fill"></i></div>
        <h1 class="auth-title">Create your account</h1>
        <p class="auth-sub">Join CDU — it's free to get started</p>

        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

        <form asp-action="Register" asp-controller="Authentication" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="FullName" class="form-label">Full Name</label>
                <input asp-for="FullName" class="form-control" placeholder="Jane Smith"
                       autocomplete="name" autofocus />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email address</label>
                <input asp-for="Email" class="form-control" placeholder="jane@example.com"
                       autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label">Password</label>
                <div class="input-group">
                    <input asp-for="Password" type="password" class="form-control"
                           placeholder="Min. 8 characters" id="pwdField"
                           oninput="checkStrength(this.value)" autocomplete="new-password" />
                    <button type="button" class="btn btn-outline-secondary"
                            onclick="togglePwd('pwdField', this)" tabindex="-1">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <div id="strengthBar" class="password-strength bg-secondary opacity-25 mt-2" style="width:0%"></div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                <div class="input-group">
                    <input asp-for="ConfirmPassword" type="password" class="form-control"
                           placeholder="Re-enter your password" id="confirmField"
                           autocomplete="new-password" />
                    <button type="button" class="btn btn-outline-secondary"
                            onclick="togglePwd('confirmField', this)" tabindex="-1">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <p class="small text-muted mb-3">
                <i class="bi bi-shield-check text-success me-1"></i>
                Your account will be created as a <span class="badge-info fw-semibold">User</span>.
            </p>

            <button type="submit" class="btn-brand mb-3">
                <i class="bi bi-person-check me-2"></i>Create Account
            </button>
        </form>

        <div class="divider"></div>
        <p class="text-center mb-0 small text-muted">
            Already have an account?
            <a asp-action="Login" asp-controller="Authentication" class="text-primary fw-semibold text-decoration-none">
                Sign in
            </a>
        </p>
    </div>

    <script>
            function togglePwd(fieldId, btn) {
                const f = document.getElementById(fieldId);
                const icon = btn.querySelector('i');
                f.type = f.type === 'password' ? 'text' : 'password';
                icon.className = f.type === 'text' ? 'bi bi-eye-slash' : 'bi bi-eye';
            }

            function checkStrength(val) {
                const bar = document.getElementById('strengthBar');
                let score = 0;
                if (val.length >= 8) score++;
                if (/[A-Z]/.test(val)) score++;
                if (/[0-9]/.test(val)) score++;
                if (/[^A-Za-z0-9]/.test(val)) score++;
                const pct = (score / 4) * 100;
                const colors = ['#ef4444', '#f97316', '#eab308', '#22c55e'];
                bar.style.width = pct + '%';
                bar.style.background = colors[score - 1] ?? '#e5e7eb';
                bar.style.opacity = '1';
            }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
