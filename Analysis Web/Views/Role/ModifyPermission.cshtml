@model List<Core_Layer.ViewModels.RolePermissionViewModel>

@{
    ViewData["Title"] = "Modify Permission";
    long roleId = Convert.ToInt64(ViewBag.RoleId ?? 0);
}

<style>
    .permission-check {
        width: 18px !important;
        height: 18px !important;
        opacity: 1 !important;
        position: static !important;
        display: inline-block !important;
        appearance: auto !important;
        -webkit-appearance: checkbox !important;
        margin-right: 10px;
    }

    .permission-box {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        min-height: 80px;
    }
</style>

<div class="container-fluid p-0">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h3 mb-1">Modify Permissions</h1>
            <p class="text-muted mb-0">Manage role permissions</p>
        </div>

        <a asp-action="Index" asp-controller="Role" class="btn btn-light">Back</a>
    </div>

    @Html.AntiForgeryToken()

    @foreach (var group in Model.GroupBy(x => x.ControllerName))
    {
        <div class="card mb-3 shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0">
                    <i class="bi bi-folder me-2"></i>@group.Key
                </h5>
            </div>

            <div class="card-body">
                <div class="row">
                    @foreach (var permission in group)
                    {
                        <div class="col-md-4 mb-3">
                            <div class="border rounded p-3 permission-box">
                                <input class="permission-check permission-checkbox"
                                       type="checkbox"
                                       data-role-id="@roleId"
                                       data-permission-id="@permission.PermissionId"
                                       checked="@permission.IsChecked" />

                                <label>
                                    <strong>@permission.ActionName</strong><br />
                                    <small class="text-muted">@permission.Slug</small>
                                </label>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.permission-checkbox').forEach(function (checkbox) {
            checkbox.addEventListener('change', function () {
                const currentCheckbox = this;

                const data = {
                    roleId: parseInt(currentCheckbox.dataset.roleId),
                    permissionId: parseInt(currentCheckbox.dataset.permissionId),
                    selected: currentCheckbox.checked
                };

                fetch('/Role/ChangePermission', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify(data)
                })
                .then(response => response.json())
                .then(result => {
                    if (!result.success) {
                        alert(result.message || 'Unable to update permission');
                        currentCheckbox.checked = !currentCheckbox.checked;
                    }
                })
                .catch(() => {
                    alert('Something went wrong');
                    currentCheckbox.checked = !currentCheckbox.checked;
                });
            });
        });
    </script>
}