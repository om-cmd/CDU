@{
    ViewData["Title"] = "Crime Analysis Dashboard";
}

<div class="row">
    <!-- Stat Cards -->
    <div class="col-lg-3 col-md-6 col-sm-6">
        <div class="card card-stats">
            <div class="card-header card-header-warning card-header-icon">
                <div class="card-icon">
                    <i class="material-icons">warning</i>
                </div>
                <p class="card-category">Total Incidents</p>
                <h3 class="card-title">4,821</h3>
            </div>
            <div class="card-footer">
                <div class="stats">
                    <i class="material-icons text-danger">trending_up</i>
                    <a href="#">↑ 6.2% vs last quarter</a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6 col-sm-6">
        <div class="card card-stats">
            <div class="card-header card-header-rose card-header-icon">
                <div class="card-icon">
                    <i class="material-icons">folder_open</i>
                </div>
                <p class="card-category">Open Cases</p>
                <h3 class="card-title">1,247</h3>
            </div>
            <div class="card-footer">
                <div class="stats">
                    <i class="material-icons text-danger">trending_up</i>
                    <a href="#">↑ 3.1% unsolved rate</a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6 col-sm-6">
        <div class="card card-stats">
            <div class="card-header card-header-success card-header-icon">
                <div class="card-icon">
                    <i class="material-icons">check_circle</i>
                </div>
                <p class="card-category">Clearance Rate</p>
                <h3 class="card-title">74%</h3>
            </div>
            <div class="card-footer">
                <div class="stats">
                    <i class="material-icons text-success">trending_down</i>
                    <a href="#">↓ 2.1% favourable</a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6 col-sm-6">
        <div class="card card-stats">
            <div class="card-header card-header-info card-header-icon">
                <div class="card-icon">
                    <i class="material-icons">timer</i>
                </div>
                <p class="card-category">Avg Response (min)</p>
                <h3 class="card-title">8.4</h3>
            </div>
            <div class="card-footer">
                <div class="stats">
                    <i class="material-icons text-success">trending_down</i>
                    <a href="#">↓ 1.2 improved</a>
                </div>
            </div>
        </div>
    </div>
</div>

