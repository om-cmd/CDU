@model Core_Layer.Models.DashboardStatsModel
@{
    ViewData["Title"] = "Dashboard";
    var topCrimes    = Model.CrimeTypeCounts.Take(5).ToList();
    var maxCrime     = topCrimes.Any() ? topCrimes.Max(x => x.Value) : 1;
    var neighborhoods = Model.NeighborhoodCounts.Keys.ToList();
    var crimeTypes    = Model.CrimeTypeCounts.Keys.ToList();

    var yearLabels = System.Text.Json.JsonSerializer.Serialize(Model.YearlyCounts.Keys.ToList());
    var yearValues = System.Text.Json.JsonSerializer.Serialize(Model.YearlyCounts.Values.ToList());
    var hourLabels = System.Text.Json.JsonSerializer.Serialize(Enumerable.Range(0,24).Select(h => $"{h:D2}:00").ToList());
    var hourValues = System.Text.Json.JsonSerializer.Serialize(
        Enumerable.Range(0,24).Select(h => Model.HourlyCounts.TryGetValue(h, out var v) ? v : 0).ToList());
    var mapPoints  = System.Text.Json.JsonSerializer.Serialize(Model.MapPoints);
    var nbrCounts  = System.Text.Json.JsonSerializer.Serialize(Model.NeighborhoodCounts);
}

@section Styles {
<style>
    .filter-panel {
        background: #fff;
        border: 1px solid #e0e0e0;
        border-radius: 6px;
        padding: 16px 20px;
        margin-bottom: 20px;
        display: none;
        box-shadow: 0 2px 8px rgba(0,0,0,0.07);
    }
    .filter-panel.open { display: block; }
    .filter-panel .row { align-items: flex-end; }
    .filter-panel label { font-size: 11px; font-weight: 600; color: #888; text-transform: uppercase; letter-spacing: .05em; margin-bottom: 4px; }
    .filter-panel .form-control { font-size: 13px; border-radius: 4px; border: 1px solid #ddd; }
    .filter-panel .form-control:focus { border-color: #e8593c; box-shadow: 0 0 0 2px rgba(232,89,60,.15); }
    .btn-filter-toggle {
        background: #0d1117; color: #fff; border: none;
        padding: .42rem 1.1rem; border-radius: 4px; font-size: 13px;
        font-weight: 600; cursor: pointer; display: inline-flex;
        align-items: center; gap: .4rem; margin-bottom: 4px;
    }
    .btn-filter-toggle:hover { background: #e8593c; }
    .btn-apply { background:#e8593c; color:#fff; border:none; border-radius:4px; padding:.4rem 1rem; font-size:13px; font-weight:600; cursor:pointer; }
    .btn-apply:hover { background:#c0392b; }
    .btn-reset { background:#f5f5f5; color:#333; border:1px solid #ddd; border-radius:4px; padding:.4rem 1rem; font-size:13px; cursor:pointer; }

    #map { height: 480px; border-radius: 6px; }
    .map-legend {
        background: rgba(255,255,255,0.95);
        border-radius: 4px; padding: 8px 12px;
        font-size: 11px; line-height: 1.8;
        box-shadow: 0 1px 4px rgba(0,0,0,0.15);
    }
    .map-legend-dot { display: inline-block; width: 10px; height: 10px; border-radius: 50%; margin-right: 5px; }
    .filter-results-bar {
        font-size: 12px; color: #888; padding: 6px 0 10px;
        font-family: 'Courier New', monospace;
    }
    .card-stats .card-header { padding: 15px 15px 0; }
    .badge-crime-sm {
        display: inline-block; padding: 2px 8px; border-radius: 3px;
        font-size: 11px; font-weight: 700; text-transform: uppercase;
        font-family: 'Courier New', monospace;
    }
    .nbr-bar { height: 5px; border-radius: 3px; background: #e8593c; display: inline-block; min-width: 4px; }
    .chart-container { position: relative; height: 200px; }
</style>
}

<!-- Filter Toggle Bar -->
<div class="d-flex align-items-center justify-content-between mb-1" style="flex-wrap:wrap;gap:8px">
    <div>
        <button class="btn-filter-toggle" id="btnToggleFilter">
            <i class="material-icons" style="font-size:16px">filter_list</i>
            Filters
        </button>
        <span class="filter-results-bar" id="filterResultsBar">
            Showing all <strong>@Model.TotalRecords.ToString("N0")</strong> records &nbsp;·&nbsp; @Model.TotalWithCoords.ToString("N0") with map coordinates
        </span>
    </div>
</div>

<!-- Filter Panel -->
<div class="filter-panel" id="filterPanel">
    <div class="row g-3">
        <div class="col-md-2 col-sm-6">
            <label>File Number</label>
            <input type="text" id="fFileNumber" class="form-control" placeholder="e.g. 2023-001" />
        </div>
        <div class="col-md-2 col-sm-6">
            <label>Crime Type</label>
            <select id="fCrimeType" class="form-control">
                <option value="All">All Types</option>
                @foreach (var ct in crimeTypes)
                {
                    <option value="@ct">@ct</option>
                }
            </select>
        </div>
        <div class="col-md-2 col-sm-6">
            <label>Neighborhood</label>
            <select id="fNeighborhood" class="form-control">
                <option value="All">All Areas</option>
                @foreach (var n in neighborhoods)
                {
                    <option value="@n">@n</option>
                }
            </select>
        </div>
        <div class="col-md-2 col-sm-6">
            <label>Report Date From</label>
            <input type="date" id="fDateFrom" class="form-control" />
        </div>
        <div class="col-md-2 col-sm-6">
            <label>Report Date To</label>
            <input type="date" id="fDateTo" class="form-control" />
        </div>
        <div class="col-md-2 col-sm-6">
            <label>Crime Date From</label>
            <input type="date" id="fCrimeDateFrom" class="form-control" />
        </div>
        <div class="col-md-2 col-sm-6">
            <label>Crime Date To</label>
            <input type="date" id="fCrimeDateTo" class="form-control" />
        </div>
        <div class="col-md-2 col-sm-12 d-flex gap-2">
            <button class="btn-apply" id="btnApplyFilter">Apply</button>
            <button class="btn-reset" id="btnResetFilter">Reset</button>
        </div>
    </div>
</div>

<!-- Stat Cards -->
<div class="row">
    <div class="col-lg-3 col-md-6 col-sm-6">
        <div class="card card-stats">
            <div class="card-header card-header-warning card-header-icon">
                <div class="card-icon"><i class="material-icons">warning</i></div>
                <p class="card-category">Total Incidents</p>
                <h3 class="card-title" id="statTotal">@Model.TotalRecords.ToString("N0")</h3>
            </div>
            <div class="card-footer">
                <div class="stats">
                    <i class="material-icons">date_range</i> 2009 – 2026
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6 col-sm-6">
        <div class="card card-stats">
            <div class="card-header card-header-rose card-header-icon">
                <div class="card-icon"><i class="material-icons">directions_car</i></div>
                <p class="card-category">Top Crime</p>
                <h3 class="card-title" style="font-size:1.1rem">@(Model.CrimeTypeCounts.FirstOrDefault().Key ?? "—")</h3>
            </div>
            <div class="card-footer">
                <div class="stats">
                    <i class="material-icons">bar_chart</i>
                    @Model.CrimeTypeCounts.FirstOrDefault().Value.ToString("N0") incidents
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6 col-sm-6">
        <div class="card card-stats">
            <div class="card-header card-header-success card-header-icon">
                <div class="card-icon"><i class="material-icons">place</i></div>
                <p class="card-category">Top Neighborhood</p>
                <h3 class="card-title" style="font-size:1.1rem">@(Model.NeighborhoodCounts.FirstOrDefault().Key ?? "—")</h3>
            </div>
            <div class="card-footer">
                <div class="stats">
                    <i class="material-icons">location_on</i>
                    @Model.NeighborhoodCounts.FirstOrDefault().Value.ToString("N0") incidents
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6 col-sm-6">
        <div class="card card-stats">
            <div class="card-header card-header-info card-header-icon">
                <div class="card-icon"><i class="material-icons">map</i></div>
                <p class="card-category">Mapped Points</p>
                <h3 class="card-title" id="statMapped">@Model.TotalWithCoords.ToString("N0")</h3>
            </div>
            <div class="card-footer">
                <div class="stats">
                    <i class="material-icons">my_location</i> Cambridge, MA
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Crime Category Breakdown -->
    <div class="col-lg-6 col-md-12">
        <div class="card">
            <div class="card-header card-header-warning">
                <h4 class="card-title">Top 5 Crime Types</h4>
                <p class="card-category">Real data · All years</p>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table">
                        <tbody>
                            @foreach (var crime in topCrimes)
                            {
                                var pct = (int)((double)crime.Value / maxCrime * 100);
                                var color = crime.Key switch {
                                    "HitAndRun" => "#e8593c",
                                    "LarcenyFromMV" => "#f2a623",
                                    "Shoplifting" => "#9c27b0",
                                    "LarcenyOfBicycle" => "#26c6da",
                                    _ => "#66bb6a"
                                };
                                <tr>
                                    <td style="width:160px;font-size:13px">@crime.Key</td>
                                    <td>
                                        <div class="progress" style="height:6px;margin-bottom:0;background:#eee;border-radius:3px">
                                            <div class="progress-bar" style="width:@pct%;background:@color"></div>
                                        </div>
                                    </td>
                                    <td class="text-right" style="width:60px;font-size:13px">@crime.Value.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Neighborhood Breakdown -->
    <div class="col-lg-6 col-md-12">
        <div class="card">
            <div class="card-header card-header-rose">
                <h4 class="card-title">Incidents by Neighborhood</h4>
                <p class="card-category">All years · Real data</p>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table">
                        <tbody>
                            @{
                                var maxNbr = Model.NeighborhoodCounts.Any() ? Model.NeighborhoodCounts.Max(x => x.Value) : 1;
                            }
                            @foreach (var nbr in Model.NeighborhoodCounts.Take(6))
                            {
                                var pct = (int)((double)nbr.Value / maxNbr * 100);
                                <tr>
                                    <td style="width:140px;font-size:13px">@nbr.Key</td>
                                    <td>
                                        <div class="progress" style="height:6px;margin-bottom:0;background:#eee;border-radius:3px">
                                            <div class="progress-bar" style="width:@pct%;background:#e8593c"></div>
                                        </div>
                                    </td>
                                    <td class="text-right" style="width:60px;font-size:13px">@nbr.Value.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Yearly Trend + Hourly -->
<div class="row">
    <div class="col-lg-7 col-md-12">
        <div class="card">
            <div class="card-header card-header-info">
                <h4 class="card-title">Incidents by Year</h4>
                <p class="card-category">2009 – 2026</p>
            </div>
            <div class="card-body">
                <div class="chart-container">
                    <canvas id="yearChart"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-5 col-md-12">
        <div class="card">
            <div class="card-header card-header-success">
                <h4 class="card-title">Incidents by Hour of Day</h4>
                <p class="card-category">When crimes happen</p>
            </div>
            <div class="card-body">
                <div class="chart-container">
                    <canvas id="hourChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Google Map Heatmap -->
<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header card-header-danger">
                <h4 class="card-title">Crime Heatmap — Cambridge, MA</h4>
                <p class="card-category" id="mapSubtitle">
                    Showing up to 5,000 most recent mapped points · Use filters above to narrow
                </p>
            </div>
            <div class="card-body" style="padding:10px">
                <div id="map"></div>
                <div style="margin-top:8px;font-size:11px;color:#aaa;font-family:'Courier New',monospace">
                    ● Heatmap intensity = incident density &nbsp;|&nbsp; Toggle: <button id="btnToggleMarkers" style="font-size:11px;padding:2px 8px;border:1px solid #ddd;border-radius:3px;cursor:pointer;background:#fff">Show Markers</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Recent Incidents Table -->
<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header card-header-primary">
                <h4 class="card-title">10 Most Recent Incidents</h4>
                <p class="card-category">Cambridge, MA · Live from CSV</p>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover" id="recentTable">
                        <thead class="text-primary">
                            <tr>
                                <th>File #</th>
                                <th>Crime Type</th>
                                <th>Neighborhood</th>
                                <th>Location</th>
                                <th>Report Date</th>
                                <th>Crime Date/Time</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var inc in Model.RecentIncidents)
                            {
                                <tr>
                                    <td><strong>@inc.FileNumber</strong></td>
                                    <td>
                                        <span class="badge-crime-sm" style="background:#fdecea;color:#c0392b">
                                            @inc.CrimeType
                                        </span>
                                    </td>
                                    <td>@inc.Neighborhood</td>
                                    <td style="font-size:12px;max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="@inc.Location">@inc.Location</td>
                                    <td>@inc.DateOfReport</td>
                                    <td>@inc.CrimeDateTime</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer">
                <div class="stats">
                    <i class="material-icons">update</i>
                    Source: Crime_Reports_20260508.csv &nbsp;·&nbsp; @Model.TotalRecords.ToString("N0") total records loaded
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

<!-- Replace YOUR_GOOGLE_MAPS_API_KEY below -->
<script>
    // ── Data from server ─────────────────────────────────────────────────────
    const allMapPoints = @Html.Raw(mapPoints);
    const yearLabels   = @Html.Raw(yearLabels);
    const yearValues   = @Html.Raw(yearValues);
    const hourLabels   = @Html.Raw(hourLabels);
    const hourValues   = @Html.Raw(hourValues);

    // ── Filter panel toggle ──────────────────────────────────────────────────
    document.getElementById('btnToggleFilter').addEventListener('click', () => {
        document.getElementById('filterPanel').classList.toggle('open');
    });

    // ── Year chart ───────────────────────────────────────────────────────────
    new Chart(document.getElementById('yearChart'), {
        type: 'bar',
        data: {
            labels: yearLabels,
            datasets: [{
                label: 'Incidents',
                data: yearValues,
                backgroundColor: yearValues.map((v, i) =>
                    i === yearValues.length - 1 ? 'rgba(232,89,60,0.9)' : 'rgba(232,89,60,0.55)'),
                borderRadius: 3,
                borderSkipped: false,
            }]
        },
        options: {
            responsive: true, maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                x: { grid: { display: false }, ticks: { font: { size: 10 } } },
                y: { grid: { color: '#f0f0f0' }, ticks: { font: { size: 10 } } }
            }
        }
    });

    // ── Hour chart ───────────────────────────────────────────────────────────
    new Chart(document.getElementById('hourChart'), {
        type: 'line',
        data: {
            labels: hourLabels,
            datasets: [{
                label: 'Incidents',
                data: hourValues,
                borderColor: '#e8593c',
                backgroundColor: 'rgba(232,89,60,0.08)',
                borderWidth: 2,
                pointRadius: 2,
                fill: true,
                tension: 0.4
            }]
        },
        options: {
            responsive: true, maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                x: { grid: { display: false }, ticks: { font: { size: 9 }, maxRotation: 45 } },
                y: { grid: { color: '#f0f0f0' }, ticks: { font: { size: 10 } } }
            }
        }
    });

    // ── Filter apply / reset ─────────────────────────────────────────────────
    document.getElementById('btnApplyFilter').addEventListener('click', applyFilter);
    document.getElementById('btnResetFilter').addEventListener('click', () => {
        ['fFileNumber','fCrimeType','fNeighborhood','fDateFrom','fDateTo','fCrimeDateFrom','fCrimeDateTo']
            .forEach(id => {
                const el = document.getElementById(id);
                if (el.tagName === 'SELECT') el.value = el.options[0].value;
                else el.value = '';
            });
        applyFilter();
    });

    function applyFilter() {
        const params = new URLSearchParams({
            fileNumber:    document.getElementById('fFileNumber').value,
            crimeType:     document.getElementById('fCrimeType').value,
            neighborhood:  document.getElementById('fNeighborhood').value,
            dateFrom:      document.getElementById('fDateFrom').value,
            dateTo:        document.getElementById('fDateTo').value,
            crimeDateFrom: document.getElementById('fCrimeDateFrom').value,
            crimeDateTo:   document.getElementById('fCrimeDateTo').value,
        });
        fetch('@Url.Action("FilterMapPoints","Home")?' + params)
            .then(r => r.json())
            .then(data => {
                document.getElementById('filterResultsBar').innerHTML =
                    `Filtered: <strong>${data.total.toLocaleString()}</strong> records &nbsp;·&nbsp; ${data.points.length} on map`;
                document.getElementById('statTotal').textContent = data.total.toLocaleString();
                updateHeatmap(data.points);
            });
    }

    // ── Google Maps + Heatmap ────────────────────────────────────────────────
    let map, heatmap, markerCluster = [], showMarkers = false;

    function initMap() {
        map = new google.maps.Map(document.getElementById('map'), {
            center: { lat: 42.373, lng: -71.109 },
            zoom: 14,
            mapTypeId: 'roadmap',
            styles: [
                { featureType: 'poi', stylers: [{ visibility: 'off' }] },
                { featureType: 'transit', stylers: [{ visibility: 'off' }] }
            ]
        });

        updateHeatmap(allMapPoints);

        // Legend
        const legend = document.createElement('div');
        legend.className = 'map-legend';
        legend.innerHTML = `
            <strong style="font-size:11px;display:block;margin-bottom:4px">DENSITY</strong>
            <div style="display:flex;align-items:center;gap:6px">
                <div style="width:60px;height:8px;border-radius:4px;background:linear-gradient(to right,#0000ff,#00ff00,#ffff00,#ff0000)"></div>
                <span style="font-size:10px">Low → High</span>
            </div>`;
        map.controls[google.maps.ControlPosition.BOTTOM_LEFT].push(legend);
    }

    function updateHeatmap(points) {
        if (heatmap) heatmap.setMap(null);
        markerCluster.forEach(m => m.setMap(null));
        markerCluster = [];

        const heatData = points.map(p =>
            new google.maps.LatLng(p.lat, p.lng));

        heatmap = new google.maps.visualization.HeatmapLayer({
            data: heatData,
            map: map,
            radius: 20,
            opacity: 0.75,
            gradient: [
                'rgba(0,0,255,0)',
                'rgba(0,100,255,0.6)',
                'rgba(0,200,200,0.7)',
                'rgba(0,255,0,0.8)',
                'rgba(255,255,0,0.85)',
                'rgba(255,140,0,0.9)',
                'rgba(255,0,0,1)'
            ]
        });

        if (showMarkers) renderMarkers(points);
    }

    function renderMarkers(points) {
        markerCluster.forEach(m => m.setMap(null));
        markerCluster = [];
        const infoWindow = new google.maps.InfoWindow();
        points.slice(0, 500).forEach(p => {
            const marker = new google.maps.Marker({
                position: { lat: p.lat, lng: p.lng },
                map: map,
                title: p.type,
                icon: {
                    path: google.maps.SymbolPath.CIRCLE,
                    scale: 5,
                    fillColor: '#e8593c',
                    fillOpacity: 0.8,
                    strokeWeight: 1,
                    strokeColor: '#fff'
                }
            });
            marker.addListener('click', () => {
                infoWindow.setContent(`
                    <div style="font-size:12px;line-height:1.7;min-width:160px">
                        <strong>${p.fn}</strong><br>
                        <b>Type:</b> ${p.type}<br>
                        <b>Area:</b> ${p.nbr}<br>
                        <b>Date:</b> ${p.dt}
                    </div>`);
                infoWindow.open(map, marker);
            });
            markerCluster.push(marker);
        });
    }

    document.getElementById('btnToggleMarkers').addEventListener('click', function () {
        showMarkers = !showMarkers;
        this.textContent = showMarkers ? 'Hide Markers' : 'Show Markers';
        if (showMarkers) renderMarkers(allMapPoints);
        else { markerCluster.forEach(m => m.setMap(null)); markerCluster = []; }
    });
</script>

<!-- Load Google Maps with Visualization library — replace YOUR_API_KEY -->
<script async
    src="https://maps.googleapis.com/maps/api/js?key=YOUR_GOOGLE_MAPS_API_KEY&libraries=visualization&callback=initMap">
</script>
}