@section Scripts {
    <script>
        // Sparkline bars
        const vals = [310, 295, 340, 285, 360, 320, 390, 350, 410, 365, 440, 380];
        const mx = Math.max(...vals);
        const colors = ['#26c6da','#66bb6a','#26c6da','#f2a623','#f2a623','#26c6da','#f2a623','#e8593c','#e8593c','#f2a623','#e8593c','#e8593c'];
        const spark = document.getElementById('sparkline');
        vals.forEach((v, i) => {
            const b = document.createElement('div');
            b.style.cssText = `flex:1;height:${Math.round(v / mx * 100)}%;background:${colors[i]};border-radius:2px 2px 0 0;opacity:0.8;transition:opacity 0.2s`;
            b.onmouseenter = () => b.style.opacity = '1';
            b.onmouseleave = () => b.style.opacity = '0.8';
            spark.appendChild(b);
        });
    </script>
}
