@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no" />
    <title>@ViewData["Title"] - Analysis</title>
    <link rel="icon" type="image/png" href="~/favicon.png" />
    <link rel="stylesheet" type="text/css" href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700|Roboto+Slab:400,700|Material+Icons" />
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/font-awesome/latest/css/font-awesome.min.css" />

    <!-- Material Dashboard CSS -->
    <link href="~/assets/css/material-dashboard.min.css" rel="stylesheet" />
    <style>
        .notification-menu {
            width: 340px;
            max-height: 420px;
            overflow: hidden;
            padding: 0;
        }

        .notification-menu-head {
            padding: .75rem 1rem;
            border-bottom: 1px solid #eef2f7;
            font-weight: 700;
            color: #172033;
        }

        .notification-menu-list {
            max-height: 300px;
            overflow-y: auto;
        }

        .notification-menu-item {
            display: block;
            padding: .75rem 1rem;
            border-bottom: 1px solid #f1f5f9;
            color: #172033;
            white-space: normal;
        }

        .notification-menu-item:hover {
            background: #f8fafc;
            text-decoration: none;
        }

        .notification-menu-item.unread {
            background: #eff6ff;
        }

        .notification-menu-title {
            display: flex;
            align-items: center;
            gap: .4rem;
            font-size: .85rem;
            font-weight: 700;
        }

        .notification-menu-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #2563eb;
            flex: 0 0 auto;
        }

        .notification-menu-message {
            margin-top: .25rem;
            color: #64748b;
            font-size: .78rem;
            line-height: 1.35;
        }

        .notification-menu-meta {
            margin-top: .3rem;
            color: #94a3b8;
            font-size: .72rem;
        }

        .notification-empty {
            padding: 1rem;
            color: #64748b;
            font-size: .85rem;
        }

        .dashboard-filter-panel {
            background: #ffffff;
            border: 1px solid #d7e1ef;
            border-radius: 8px;
            box-shadow: 0 8px 22px rgba(15, 23, 42, .06);
            margin-bottom: 14px;
            padding: 12px;
        }

        .dashboard-filter-form {
            display: grid;
            grid-template-columns: minmax(180px, 1.3fr) repeat(5, minmax(130px, 1fr)) auto;
            gap: 10px;
            align-items: end;
        }

        .filter-field {
            min-width: 0;
        }

        .filter-field label {
            display: block;
            margin: 0 0 4px;
            color: #31445f;
            font-size: 10px;
            font-weight: 900;
            line-height: 1.2;
            text-transform: uppercase;
        }

        .filter-field input,
        .filter-field select {
            width: 100%;
            height: 38px;
            border: 1px solid #cbd7e6;
            border-radius: 7px;
            background: #f9fbfd;
            color: #102a43;
            font-size: 13px;
            padding: 6px 9px;
        }

        .filter-actions {
            display: flex;
            gap: 7px;
            align-items: center;
            justify-content: flex-end;
        }

        .filter-apply,
        .filter-reset {
            height: 38px;
            border-radius: 7px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 0;
        }

        .filter-apply {
            gap: 5px;
            padding: 0 12px;
            color: #fff;
            background: #002664;
            font-size: 12px;
            font-weight: 900;
        }

        .filter-reset {
            width: 38px;
            color: #002664;
            background: #e8eef7;
        }

        .filter-apply .material-icons,
        .filter-reset .material-icons {
            font-size: 18px;
        }

        .filter-summary {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-top: 9px;
            color: #5b677a;
            font-size: 12px;
            font-weight: 700;
        }

        .filter-summary strong {
            color: #102a43;
        }

        @@media (max-width: 1200px) {
            .dashboard-filter-form {
                grid-template-columns: repeat(3, minmax(0, 1fr));
            }

            .filter-actions {
                justify-content: flex-start;
            }
        }

        @@media (max-width: 760px) {
            .dashboard-filter-form {
                grid-template-columns: 1fr;
            }
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
@{
    var userId = Context.User.Claims.FirstOrDefault(x => x.Type == ClaimTypes.NameIdentifier)?.Value;
}
<body class="">
    <div class="wrapper">

        <!-- Sidebar -->
        <div class="sidebar" data-color="azure" data-background-color="white">
            <div class="logo">
                <a asp-controller="Home" asp-action="Index" class="simple-text logo-normal">
                    <img src="~/assets/img/nsw_analysis_logo.svg" alt="Analysis logo" style="width:36px;height:36px;object-fit:contain;margin-right:8px;vertical-align:middle;" />
                    Analysis
                </a>
            </div>

            <div class="sidebar-wrapper">
                <ul class="nav">
                    <li class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Analysis" && ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")">
                        <a class="nav-link" asp-controller="Analysis" asp-action="Dashboard">
                            <i class="material-icons">dashboard</i>
                            <p>Dashboard</p>
                        </a>
                    </li>

                    <li class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "CrimeData" ? "active" : "")">
                        <a class="nav-link" asp-controller="CrimeData" asp-action="Index">
                            <i class="material-icons">policy</i>
                            <p>Crime Data</p>
                        </a>
                    </li>
                    <li class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "CrimeReport" ? "active" : "")">
                        <a class="nav-link" asp-controller="CrimeReport" asp-action="CrimeReport">
                            <i class="material-icons">local_police</i>
                            <p>Crime Report</p>
                        </a>
                    </li>
                    <li class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Analysis" && ViewContext.RouteData.Values["action"]?.ToString() == "HarmDashboard" ? "active" : "")">
                        <a class="nav-link" asp-controller="Analysis" asp-action="HarmDashboard">
                            <i class="material-icons">balance</i>
                            <p>Harm Dashboard</p>
                        </a>
                    </li>
                    <li class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Analysis" && ViewContext.RouteData.Values["action"]?.ToString() == "CrimeDashboard" ? "active" : "")">
                        <a class="nav-link" asp-controller="Analysis" asp-action="CrimeDashboard">
                            <i class="material-icons">analytics</i>
                            <p>Crime Dashboard</p>
                        </a>
                    </li>
                    <li class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Analysis" && ViewContext.RouteData.Values["action"]?.ToString() == "ModelEvaluation" ? "active" : "")">
                        <a class="nav-link" asp-controller="Analysis" asp-action="ModelEvaluation">
                            <i class="material-icons">fact_check</i>
                            <p>Model Evaluation</p>
                        </a>
                    </li>
                    @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
                    {
                        <li class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Communication" && ViewContext.RouteData.Values["action"]?.ToString() == "GlobalEmail" ? "active" : "")">
                            <a class="nav-link" asp-controller="Communication" asp-action="GlobalEmail">
                                <i class="material-icons">outgoing_mail</i>
                                <p>Global Email</p>
                            </a>
                        </li>
                    }
                    <li class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Communication" && ViewContext.RouteData.Values["action"]?.ToString() == "Notifications" ? "active" : "")">
                        <a class="nav-link" asp-controller="Communication" asp-action="Notifications">
                            <i class="material-icons">notifications</i>
                            <p>Notifications</p>
                        </a>
                    </li>
                    @if (Business_Layer.ViewPermissionChecker.HasPermission(Convert.ToInt32(userId), "RoleList"))
                    {
                        <li class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Role" ? "active" : "")">
                            <a class="nav-link" asp-controller="Role" asp-action="Index">
                                <i class="material-icons">Role</i>
                                <p>Roles</p>
                            </a>
                        </li>
                    }

                </ul>
            </div>
        </div>
        <!-- End Sidebar -->

        <div class="main-panel">

            <!-- Top Navbar -->
            <nav class="navbar navbar-expand-lg navbar-transparent navbar-absolute fixed-top">
                <div class="container-fluid">
                    <div class="navbar-wrapper">
                        <a class="navbar-brand" href="javascript:;">@ViewData["Title"]</a>
                    </div>

                    <button class="navbar-toggler" type="button" data-toggle="collapse"
                            aria-controls="navigation-index" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="sr-only">Toggle navigation</span>
                        <span class="navbar-toggler-icon icon-bar"></span>
                        <span class="navbar-toggler-icon icon-bar"></span>
                        <span class="navbar-toggler-icon icon-bar"></span>
                    </button>

                    <div class="collapse navbar-collapse justify-content-end">
                        <form class="navbar-form">
                            <div class="input-group no-border">
                                <input type="text" class="form-control" placeholder="Search...">
                                <button type="submit" class="btn btn-white btn-round btn-just-icon">
                                    <i class="material-icons">search</i>
                                    <div class="ripple-container"></div>
                                </button>
                            </div>
                        </form>

                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <a class="nav-link" href="javascript:;">
                                    <i class="material-icons">dashboard</i>
                                    <p class="d-lg-none d-md-block">Stats</p>
                                </a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link" href="javascript:;" id="navbarDropdownMenuLink"
                                   data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    <i class="material-icons">notifications</i>
                                    <span class="notification" id="notificationBadge" style="display:none;">0</span>
                                    <p class="d-lg-none d-md-block">Notifications</p>
                                </a>
                                <div class="dropdown-menu dropdown-menu-right notification-menu" aria-labelledby="navbarDropdownMenuLink">
                                    <div class="notification-menu-head">Notifications</div>
                                    <div id="notificationMenuList" class="notification-menu-list">
                                        <div class="notification-empty">Loading notifications...</div>
                                    </div>
                                    <a class="dropdown-item text-center" asp-controller="Communication" asp-action="Notifications">View all notifications</a>
                                </div>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link" href="javascript:;" id="navbarDropdownProfile"
                                       data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    <i class="material-icons">person</i>
                                    <p class="d-lg-none d-md-block">Account</p>
                                </a>
                                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdownProfile">
                                    <a class="dropdown-item" asp-controller="Home" asp-action="Profile">Profile</a>
                                    <a class="dropdown-item" asp-controller="Home" asp-action="Privacy">Settings</a>
                                    <div class="dropdown-divider"></div>
                                    <a class="dropdown-item" asp-controller="Authentication" asp-action="LogOut">Log out</a>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
            <!-- End Navbar -->
            <!-- Page Content -->
            <div class="content">
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </div>

            <!-- Footer -->
            <footer class="footer">
                <div class="container-fluid">
                    <nav class="float-left">
                        <ul>
                            <li>
                                <a href="#">Analysis_Web</a>
                            </li>
                        </ul>
                    </nav>
                    <div class="copyright float-right">
                        &copy; @DateTime.Now.Year - Analysis_Web
                    </div>
                </div>
            </footer>

        </div>
        <!-- End Main Panel -->

    </div>
    <!-- End Wrapper -->
    <!-- Core JS Files (correct order) -->
    <script src="~/assets/js/core/jquery.min.js"></script>
    <script src="~/assets/js/core/popper.min.js"></script>
    <script src="~/assets/js/core/bootstrap-material-design.min.js"></script>
    <script src="~/assets/js/plugins/perfect-scrollbar.jquery.min.js"></script>

    <!-- Material Dashboard JS -->
    <script src="~/assets/js/material-dashboard.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const notificationMenuUrl = '@Url.Action("NotificationMenu", "Communication")';
        const notificationDetailsBase = '@Url.Action("NotificationDetails", "Communication")';

        function escapeNotificationHtml(value) {
            return String(value ?? '').replace(/[&<>"]/g, ch => ({
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;'
            }[ch]));
        }

        function truncateNotificationText(value, max) {
            const text = String(value ?? '');
            return text.length > max ? `${text.slice(0, max)}...` : text;
        }

        function formatNotificationDate(value) {
            if (!value) return '';
            const date = new Date(value);
            return Number.isNaN(date.getTime()) ? '' : date.toLocaleString();
        }

        function renderNotificationMenu(data) {
            const badge = document.getElementById('notificationBadge');
            const list = document.getElementById('notificationMenuList');
            const unread = Number(data.unread || 0);

            if (badge) {
                badge.textContent = unread;
                badge.style.display = unread > 0 ? '' : 'none';
            }

            if (!list) return;
            const items = data.items || [];

            if (!items.length) {
                list.innerHTML = '<div class="notification-empty">No notifications yet.</div>';
                return;
            }

            list.innerHTML = items.map(item => {
                const title = escapeNotificationHtml(item.title || 'Notification');
                const message = escapeNotificationHtml(truncateNotificationText(item.message || '', 110));
                const sentBy = escapeNotificationHtml(item.sentBy || 'system');
                const sentAt = escapeNotificationHtml(formatNotificationDate(item.sentAtUtc));
                const unreadClass = item.isRead ? '' : ' unread';
                const dot = item.isRead ? '' : '<span class="notification-menu-dot"></span>';
                const id = Number(item.notificationId || 0);

                return `
                    <a class="notification-menu-item${unreadClass}" href="${notificationDetailsBase}/${id}">
                        <span class="notification-menu-title">${dot}${title}</span>
                        <span class="notification-menu-message">${message}</span>
                        <span class="notification-menu-meta">From ${sentBy}${sentAt ? ' - ' + sentAt : ''}</span>
                    </a>`;
            }).join('');
        }

        function loadNotificationMenu() {
            fetch(`${notificationMenuUrl}?_=${Date.now()}`, { cache: 'no-store' })
                .then(r => r.ok ? r.json() : { unread: 0, items: [] })
                .then(renderNotificationMenu)
                .catch(() => renderNotificationMenu({ unread: 0, items: [] }));
        }

        loadNotificationMenu();
        setInterval(loadNotificationMenu, 60000);
        document.getElementById('navbarDropdownMenuLink')?.addEventListener('click', loadNotificationMenu);
    </script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
